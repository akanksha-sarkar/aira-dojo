'import numpy as np
import torch
import cv2
from pathlib import Path
import tempfile
import shutil
import yaml
from ultralytics import YOLO
from typing import List, Dict, Tuple, Optional
from torch.utils.data import Dataset
import logging
import re

# Suppress verbose logging from Ultralytics to keep the output clean.
logging.getLogger("ultralytics").setLevel(logging.WARNING)

# --- Dataset Class and Helpers (provided by the benchmark environment) ---
# This is a re-creation of the provided classes for self-contained execution.


def _extract_index(fname: str) -> Optional[int]:
    """Tries to extract a trailing integer index from a filename."""
    m = re.search(r"(\d+)\s*$", Path(fname).stem)
    if m:
        return int(m.group(1))
    m = re.search(r"(\d+)", fname)
    return int(m.group(1)) if m else None


def _read_tif_any(p: Path) -> np.ndarray:
    """Read a TIF file, handling various compressions and bit depths."""
    img = cv2.imread(str(p), cv2.IMREAD_UNCHANGED)
    if img is None:
        raise IOError(f"Failed to read TIF image: {p}")
    return img


def _as_rgb(img: np.ndarray) -> np.ndarray:
    """Ensure an image is 3-channel RGB."""
    if img.ndim == 2:
        return cv2.cvtColor(img, cv2.COLOR_GRAY2RGB)
    if img.shape[2] == 1:
        return cv2.cvtColor(img, cv2.COLOR_GRAY2RGB)
    if img.shape[2] == 4:
        return cv2.cvtColor(img, cv2.COLOR_BGRA2RGB)
    if img.shape[2] == 3:
        return cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
    return img


def mask_to_yolo(mask_path: Path, txt_path: Path, class_id: int = 0):
    """Converts an instance mask to YOLO segmentation format."""
    mask = _read_tif_any(mask_path)
    h, w = mask.shape[:2]
    instance_ids = np.unique(mask)
    instance_ids = instance_ids[instance_ids != 0]

    with open(txt_path, "w") as f:
        for instance_id in instance_ids:
            instance_mask = (mask == instance_id).astype(np.uint8)
            contours, _ = cv2.findContours(
                instance_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE
            )

            for contour in contours:
                if contour.shape[0] < 3:
                    continue
                segment = contour.flatten().tolist()

                # Normalize coordinates
                normalized_segment = [
                    f"{s / w if i % 2 == 0 else s / h:.6f}"
                    for i, s in enumerate(segment)
                ]

                line = f"{class_id} " + " ".join(normalized_segment)
                f.write(line + "\n")


class CellSegDataset(Dataset):
    """General-purpose segmentation dataset from the benchmark environment."""

    def __init__(
        self,
        data_dir,
        ann_dir,
        split: str = "train",
        require_masks: bool = True,
        image_glob: str = "*.tif",
        mask_glob: str = "*.tif",
    ):
        self.data_dir = Path(data_dir)
        self.ann_dir = Path(ann_dir)
        self.split = split
        self.require_masks = require_masks
        self.img_dir = self.data_dir
        self.mask_dir = self.ann_dir
        img_paths = sorted(self.img_dir.glob(image_glob))
        if not img_paths:
            raise RuntimeError(f"No images found in {self.img_dir}")
        mask_paths = sorted(self.mask_dir.glob(mask_glob))
        if not mask_paths and require_masks:
            raise RuntimeError(f"No masks found in {self.mask_dir}")

        img_by_idx: Dict[int, Path] = {
            idx: p for p in img_paths if (idx := _extract_index(p.stem)) is not None
        }
        mask_by_idx: Dict[int, Path] = {
            idx: p for p in mask_paths if (idx := _extract_index(p.stem)) is not None
        }

        if not img_by_idx:
            raise RuntimeError(f"No indexed images found in {self.img_dir}")

        self.pairs: List[Tuple[int, Path, Optional[Path]]] = []
        for idx in sorted(img_by_idx.keys()):
            img_p, m_p = img_by_idx[idx], mask_by_idx.get(idx)
            if self.require_masks and m_p is None:
                raise RuntimeError(f"Missing mask for image idx={idx}")
            self.pairs.append((idx, img_p, m_p))
        if not self.pairs:
            raise RuntimeError("No (image, mask) pairs formed.")

    def __len__(self):
        return len(self.pairs)

    def __getitem__(self, i):
        idx, img_path, mask_path = self.pairs[i]
        img = _as_rgb(_read_tif_any(img_path))
        mask = None
        if mask_path:
            m = _read_tif_any(mask_path)
            if m.ndim == 3:
                m = m[..., 0]
            mask = m.astype(np.uint16)
        meta = {
            "index": idx,
            "image_id": img_path.stem,
            "image_path": str(img_path),
            "mask_path": str(mask_path) if mask_path else None,
        }
        return img, mask, meta

    def generate_yolo_dataset(
        self,
        yolo_dir: Path,
        *,
        class_id: int = 0,
        class_name: str = "cell",
        write_empty_labels: bool = True,
    ) -> str:
        yolo_image_dir = yolo_dir / "images" / self.split
        yolo_label_dir = yolo_dir / "labels" / self.split
        yolo_image_dir.mkdir(parents=True, exist_ok=True)
        yolo_label_dir.mkdir(parents=True, exist_ok=True)

        for _, img_path, mask_path in self.pairs:
            img = _as_rgb(_read_tif_any(img_path))
            if img.dtype != np.uint8:
                img = np.clip(img, 0, 255).astype(np.uint8)

            out_img_path = yolo_image_dir / f"{img_path.stem}.png"
            if not out_img_path.exists():
                cv2.imwrite(str(out_img_path), cv2.cvtColor(img, cv2.COLOR_RGB2BGR))

            label_path = yolo_label_dir / f"{img_path.stem}.txt"
            if mask_path and mask_path.exists():
                mask_to_yolo(
                    mask_path=mask_path, txt_path=label_path, class_id=class_id
                )
            elif write_empty_labels:
                label_path.touch()

        data_yaml_path = yolo_dir / "data.yaml"
        yaml_config = {
            "path": str(yolo_dir.resolve()),
            "train": "images/train",
            "val": "images/val",
            "test": "images/val",
            "names": {class_id: class_name},
        }
        if data_yaml_path.exists():
            try:
                with open(data_yaml_path, "r") as f:
                    existing = yaml.safe_load(f) or {}
                existing.update(yaml_config)
                yaml_config = existing
            except Exception:
                pass
        with open(data_yaml_path, "w") as f:
            yaml.safe_dump(yaml_config, f, sort_keys=False)

        self.yolo_yaml_path = str(data_yaml_path)
        return str(data_yaml_path)


# --- Main Solution ---


def cell_segmentation(
    train_dataset: CellSegDataset, val_dataset: CellSegDataset
) -> List[np.ndarray]:
    """
    Performs instance segmentation on a validation dataset of cell images.

    This function trains a YOLOv8m-seg model on the training data and then uses
    the trained model to predict instance masks on the validation data.
    """
    yolo_dir = Path(tempfile.mkdtemp())
    try:
        # Generate YOLO-compatible datasets for training and validation.
        data_yaml_path = train_dataset.generate_yolo_dataset(yolo_dir)
        val_dataset.generate_yolo_dataset(yolo_dir)

        # Initialize a YOLOv8 medium segmentation model with pre-trained weights.
        model = YOLO("yolov8m-seg.pt")

        # Train the model.
        model.train(
            data=data_yaml_path,
            epochs=50,
            patience=10,
            imgsz=1024,
            batch=-1,  # auto-batch size
            project=str(yolo_dir / "training_runs"),
            name="cell_seg_exp",
            exist_ok=True,
            verbose=False,
            device=0 if torch.cuda.is_available() else "cpu",
        )

        # Load the best performing model checkpoint.
        best_model_path = (
            yolo_dir / "training_runs" / "cell_seg_exp" / "weights" / "best.pt"
        )
        best_model = YOLO(best_model_path)

        # Perform inference on the validation dataset images.
        seg_mask_list = []
        val_images = [img for img, _, _ in val_dataset]

        # Process images in batches for efficiency.
        results_generator = best_model.predict(
            val_images,
            stream=True,
            retina_masks=True,  # Upsample masks to original image size for high precision.
            verbose=False,
        )

        for results in results_generator:
            height, width = results.orig_shape[:2]
            instance_mask = np.zeros((height, width), dtype=np.uint16)

            if (
                results.masks is not None
                and results.boxes is not None
                and len(results.boxes) > 0
            ):
                # Sort detections by confidence score in descending order.
                sorted_indices = torch.argsort(results.boxes.conf, descending=True)

                # Build the instance mask, prioritizing higher-confidence detections.
                for i, idx in enumerate(sorted_indices):
                    instance_id = i + 1
                    mask_tensor = results.masks.data[idx]
                    mask_np = mask_tensor.cpu().numpy().astype(bool)

                    # Assign the instance ID only to unassigned pixels.
                    instance_mask[(mask_np) & (instance_mask == 0)] = instance_id

            seg_mask_list.append(instance_mask)

        return seg_mask_list

    finally:
        shutil.rmtree(yolo_dir, ignore_errors=True)
