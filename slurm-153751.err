'import numpy as np
import torch
from pathlib import Path
import os
import cv2
import yaml
from torch.utils.data import Dataset
from typing import Dict, List, Optional, Tuple
import shutil
from ultralytics import YOLO

# --- Provided Dataset Infrastructure ---


def _extract_index(filename_stem: str) -> Optional[int]:
    """Tries to extract a trailing integer index from a filename stem."""
    # Try to match patterns like "...0001", "..._0001", "...-0001"
    import re

    match = re.search(r"[\s_-]?(\d+)$", filename_stem)
    if match:
        return int(match.group(1))
    return None


def _read_tif_any(p: Path) -> np.ndarray:
    """Read a TIF file, handling various bit depths and channel configurations."""
    img = cv2.imread(str(p), cv2.IMREAD_UNCHANGED)
    if img is None:
        raise IOError(f"Failed to read image: {p}")
    return img


def _as_rgb(img: np.ndarray) -> np.ndarray:
    """Converts a loaded image to a 3-channel RGB uint8 image."""
    if img.ndim == 2:  # Grayscale
        img = cv2.cvtColor(img, cv2.COLOR_GRAY2RGB)
    elif img.ndim == 3 and img.shape[2] == 4:  # RGBA
        img = cv2.cvtColor(img, cv2.COLOR_BGRA2RGB)
    elif img.ndim == 3 and img.shape[2] == 1:  # HxWx1
        img = cv2.cvtColor(img, cv2.COLOR_GRAY2RGB)

    # Normalize to uint8 if it's a different type
    if img.dtype != np.uint8:
        if img.dtype in [np.uint16, np.uint32, np.uint64]:
            img = (img / (np.iinfo(img.dtype).max) * 255).astype(np.uint8)
        elif img.dtype in [np.float32, np.float64]:
            img = (np.clip(img, 0, 1) * 255).astype(np.uint8)
        else:
            # For other types, just try to cast
            img = img.astype(np.uint8)

    return img


def mask_to_yolo_and_iou(mask_path: Path, txt_path: Path, class_id: int = 0):
    """
    Converts a .tif instance mask to YOLO segmentation format and calculates IoU.
    """
    mask = _read_tif_any(mask_path)
    if mask.ndim == 3:
        mask = mask[..., 0]

    H, W = mask.shape
    instance_ids = np.unique(mask)
    instance_ids = instance_ids[instance_ids != 0]

    lines = []
    reconstructed_mask = np.zeros_like(mask, dtype=np.uint16)

    for i, instance_id in enumerate(instance_ids, 1):
        instance_mask = mask == instance_id
        contours, _ = cv2.findContours(
            instance_mask.astype(np.uint8), cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE
        )

        yolo_coords = []
        for contour in contours:
            # Normalize coordinates
            contour = contour.astype(np.float32)
            contour[:, 0, 0] /= W
            contour[:, 0, 1] /= H
            yolo_coords.extend(contour.flatten().tolist())

        if yolo_coords:
            line = f"{class_id} " + " ".join(map(str, yolo_coords))
            lines.append(line)

        # Reconstruct mask for IoU calculation
        cv2.drawContours(
            reconstructed_mask, contours, -1, color=i, thickness=cv2.FILLED
        )

    with open(txt_path, "w") as f:
        f.write("\n".join(lines))

    # Calculate IoU between original and reconstructed mask to verify conversion
    intersection = np.logical_and(mask > 0, reconstructed_mask > 0).sum()
    union = np.logical_or(mask > 0, reconstructed_mask > 0).sum()
    iou = intersection / union if union > 0 else 0
    dice = (
        (2 * intersection) / (mask.sum() + reconstructed_mask.sum())
        if (mask.sum() + reconstructed_mask.sum()) > 0
        else 0
    )

    return iou, dice


class CellSegDataset(Dataset):
    def __init__(
        self,
        data_dir,
        ann_dir,
        split: str = "train",
        require_masks: bool = True,
        image_glob: str = "*.tif",
        mask_glob: str = "*.tif",
    ):
        self.data_dir = Path(data_dir)
        self.ann_dir = Path(ann_dir)
        self.split = split
        self.require_masks = require_masks

        self.img_dir = self.data_dir
        self.mask_dir = self.ann_dir

        img_paths = sorted(self.img_dir.glob(image_glob))
        if not img_paths:
            raise RuntimeError(f"No images found in {self.img_dir} (glob={image_glob})")

        mask_paths = sorted(self.mask_dir.glob(mask_glob))
        if not mask_paths and require_masks:
            raise RuntimeError(f"No masks found in {self.mask_dir} (glob={mask_glob})")

        img_by_idx: Dict[int, Path] = {}
        for p in img_paths:
            idx = _extract_index(p.stem)
            if idx is None:
                continue
            img_by_idx[idx] = p

        mask_by_idx: Dict[int, Path] = {}
        for p in mask_paths:
            idx = _extract_index(p.stem)
            if idx is None:
                continue
            mask_by_idx[idx] = p

        if not img_by_idx:
            raise RuntimeError(
                f"Found images in {self.img_dir} but none matched an index pattern (e.g., ...0000.tif)."
            )

        self.pairs: List[Tuple[int, Path, Optional[Path]]] = []
        for idx in sorted(img_by_idx.keys()):
            img_p = img_by_idx[idx]
            m_p = mask_by_idx.get(idx, None)

            if self.require_masks and m_p is None:
                raise RuntimeError(
                    f"Missing mask for image idx={idx}: image={img_p.name}. "
                    f"Expected a mask with the same trailing index in {self.mask_dir} "
                    f"(e.g., man_seg{idx:04d}.tif or mask{idx:04d}.tif)."
                )

            self.pairs.append((idx, img_p, m_p))

        if not self.pairs:
            raise RuntimeError("No (image, mask) pairs could be formed.")

    def __len__(self):
        return len(self.pairs)

    def __getitem__(self, i):
        idx, img_path, mask_path = self.pairs[i]
        img = _read_tif_any(img_path)
        img = _as_rgb(img)

        mask = None
        if mask_path is not None:
            m = _read_tif_any(mask_path)
            if m.ndim == 3:
                m = m[..., 0]
            mask = m.astype(np.uint16)

        meta = {
            "index": idx,
            "image_id": img_path.stem,
            "image_path": str(img_path),
            "mask_path": str(mask_path) if mask_path is not None else None,
        }
        return img, mask, meta

    def generate_yolo_dataset(
        self,
        yolo_dir: str | Path,
        *,
        class_id: int = 0,
        class_name: str = "cell",
        write_empty_labels: bool = True,
    ) -> str:
        yolo_dir = Path(yolo_dir)
        split = self.split

        yolo_image_dir = yolo_dir / "images" / split
        yolo_label_dir = yolo_dir / "labels" / split
        yolo_image_dir.mkdir(parents=True, exist_ok=True)
        yolo_label_dir.mkdir(parents=True, exist_ok=True)

        num_written = 0
        for idx, img_path, mask_path in self.pairs:
            assert img_path.exists(), f"Missing image: {img_path}"

            img = _read_tif_any(img_path)
            img = _as_rgb(img)

            out_img_name = f"{img_path.stem}.png"
            out_img_path = yolo_image_dir / out_img_name
            if not out_img_path.exists():
                cv2.imwrite(str(out_img_path), cv2.cvtColor(img, cv2.COLOR_RGB2BGR))

            label_path = yolo_label_dir / f"{img_path.stem}.txt"
            if mask_path is not None and Path(mask_path).exists():
                mask_to_yolo_and_iou(
                    mask_path=mask_path,
                    txt_path=label_path,
                    class_id=class_id,
                )
            else:
                if write_empty_labels:
                    label_path.touch()
            num_written += 1

        data_yaml_path = yolo_dir / "data.yaml"
        yaml_config = {
            "path": str(yolo_dir.resolve()),
            "train": f"images/{self.split}" if self.split == "train" else None,
            "val": f"images/{self.split}" if self.split == "val" else None,
            "names": {class_id: class_name},
        }

        if data_yaml_path.exists():
            try:
                with open(data_yaml_path, "r") as f:
                    existing = yaml.safe_load(f) or {}
                if existing.get("train") is None and self.split == "train":
                    existing["train"] = f"images/{self.split}"
                if existing.get("val") is None and self.split == "val":
                    existing["val"] = f"images/{self.split}"
                existing["names"] = yaml_config["names"]
                existing["path"] = yaml_config["path"]
                yaml_config = existing
            except Exception:
                pass

        with open(data_yaml_path, "w") as f:
            yaml.safe_dump(yaml_config, f, sort_keys=False)

        self.yolo_dir = yolo_dir
        self.yolo_yaml_path = str(data_yaml_path)
        return str(data_yaml_path)

    def get_yolo_dataset(self) -> str:
        if not hasattr(self, "yolo_yaml_path"):
            raise RuntimeError(
                "YOLO dataset has not been generated yet. Call generate_yolo_dataset(...) first."
            )
        return self.yolo_yaml_path


def collate_fn(batch):
    imgs, masks, metas = zip(*batch)
    return list(imgs), list(masks), list(metas)


# --- Main Implementation ---


def cell_segmentation(
    train_dataset: CellSegDataset, val_dataset: CellSegDataset
) -> List[np.ndarray]:
    """
    Performs cell instance segmentation using a trained YOLOv8 model.
    """
    # Create a temporary directory for the YOLO dataset
    yolo_data_dir = Path("./yolo_dataset")
    if yolo_data_dir.exists():
        shutil.rmtree(yolo_data_dir)
    yolo_data_dir.mkdir(parents=True)

    print("Generating YOLO dataset format...")
    train_dataset.generate_yolo_dataset(yolo_data_dir, class_name="cell")
    yaml_path = val_dataset.generate_yolo_dataset(yolo_data_dir, class_name="cell")
    print(f"YOLO dataset generated at {yolo_data_dir} with config {yaml_path}")

    # --- Model Training ---
    print("Starting YOLOv8m-seg model training...")
    # Load a pretrained YOLOv8 medium segmentation model
    model = YOLO("yolov8m-seg.pt")

    # Train the model
    # Increased epochs and image size for better performance on high-res microscopy
    # Added early stopping to prevent overfitting
    results = model.train(
        data=yaml_path,
        epochs=50,
        patience=10,
        imgsz=1024,
        project="cell_segmentation_project",
        name="yolov8m_seg_exp",
        exist_ok=True,
        batch=-1,  # auto batch size
        device=0,
        verbose=True,
    )

    print("Training complete.")
    print("Validation metrics:", results.metrics)

    # --- Inference ---
    print("Performing inference on the validation set...")
    best_model_path = Path(results.save_dir) / "weights" / "best.pt"
    if not best_model_path.exists():
        raise FileNotFoundError(f"Could not find best model at {best_model_path}")

    best_model = YOLO(best_model_path)

    seg_mask_list = []

    # Use the val_dataset loader to get original images for prediction
    for img, _, meta in val_dataset:
        H, W, _ = img.shape

        # Perform prediction
        preds = best_model.predict(img, verbose=False, imgsz=1024)
        result = preds[0]

        # Create an empty instance mask
        instance_mask = np.zeros((H, W), dtype=np.uint16)

        masks = result.masks
        if masks is not None:
            # The polygons are already scaled to the original image dimensions
            polygons = masks.xy

            # Sort detections by confidence score (descending) to handle overlaps
            # Higher confidence masks will be drawn last, overwriting lower confidence ones
            if result.boxes is not None and len(result.boxes.conf) == len(polygons):
                confidences = result.boxes.conf.cpu().numpy()
                sorted_indices = np.argsort(
                    confidences
                )  # ascending, so we draw low conf first
                polygons = [polygons[i] for i in sorted_indices]

            for i, poly in enumerate(polygons):
                instance_id = i + 1  # Start instance IDs from 1
                contour = poly.astype(np.int32).reshape(-1, 1, 2)
                cv2.drawContours(
                    instance_mask,
                    [contour],
                    -1,
                    color=instance_id,
                    thickness=cv2.FILLED,
                )

        seg_mask_list.append(instance_mask)

    print("Inference complete.")

    final_metric = results.metrics["metrics/mAP50-95(M)"]
    print(f"Final Validation SEG Score (mAP50-95): {final_metric}")

    return seg_mask_list


# --- Main execution block (for standalone run) ---
if __name__ == "__main__":
    # This block will be executed by the evaluation harness.
    # It assumes the data is in the default './work/data' and './work/ann' locations.

    # Get base directories from environment or use defaults
    data_dir = os.getenv("DATA_DIR", "./work/data")
    ann_dir = os.getenv("ANN_DIR", "./work/ann")

    # The dataset is structured into two sequences: '01' and '02'
    # We will train on '01' and validate on '02'
    train_data_path = Path(data_dir) / "01"
    train_ann_path = Path(ann_dir) / "01_GT" / "SEG"
    val_data_path = Path(data_dir) / "02"
    val_ann_path = Path(ann_dir) / "02_GT" / "SEG"

    print(f"Train data path: {train_data_path}")
    print(f"Train annotation path: {train_ann_path}")
    print(f"Validation data path: {val_data_path}")
    print(f"Validation annotation path: {val_ann_path}")

    # Instantiate datasets
    train_dataset = CellSegDataset(
        data_dir=train_data_path, ann_dir=train_ann_path, split="train"
    )

    val_dataset = CellSegDataset(
        data_dir=val_data_path, ann_dir=val_ann_path, split="val"
    )

    # Run the main segmentation function
    predicted_masks = cell_segmentation(train_dataset, val_dataset)

    print(f"\nSuccessfully generated {len(predicted_masks)} prediction masks.")
    if predicted_masks:
        print(
            f"Shape of the first mask: {predicted_masks[0].shape}, dtype: {predicted_masks[0].dtype}"
        )
