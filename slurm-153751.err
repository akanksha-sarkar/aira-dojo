'import numpy as np
import torch
from ultralytics import YOLO
import tempfile
from pathlib import Path
import cv2
import re
from typing import Dict, List, Optional, Tuple
import yaml
from torch.utils.data import Dataset
import os
import shutil

# This environment is managed by the benchmark, so we can assume these are installed.


# --- Helper functions for CellSegDataset ---
# These are assumed to exist based on the class definition.
def _extract_index(name: str) -> Optional[int]:
    """Tries to extract a trailing integer index from a filename stem."""
    match = re.search(r"(\d+)$", name)
    if match:
        return int(match.group(1))
    return None


def _read_tif_any(p: Path) -> np.ndarray:
    """Read a TIF file, handling various bit depths and channel configurations."""
    # Use cv2.IMREAD_UNCHANGED to handle different depths
    img = cv2.imread(str(p), cv2.IMREAD_UNCHANGED)
    if img is None:
        raise IOError(f"Failed to read TIFF image at {p}")
    return img


def _as_rgb(img: np.ndarray) -> np.ndarray:
    """Converts a grayscale or other format image to 3-channel RGB uint8."""
    if img.ndim == 2:  # Grayscale
        img = cv2.cvtColor(img, cv2.COLOR_GRAY2RGB)
    elif img.ndim == 3 and img.shape[2] == 1:  # HxWx1
        img = cv2.cvtColor(img, cv2.COLOR_GRAY2RGB)
    elif img.ndim == 3 and img.shape[2] > 3:  # e.g., multi-channel fluorescence
        # Take the first 3 channels as a reasonable default
        img = img[..., :3]

    # Normalize to uint8 if not already for display/standard model input
    if img.dtype != np.uint8:
        if img.dtype in [np.uint16, np.uint32, np.uint64]:
            # Scale based on dtype max value
            max_val = np.iinfo(img.dtype).max
            img = (img / (max_val + 1) * 256).astype(np.uint8)
        elif img.dtype in [np.float32, np.float64]:
            # Scale based on image content
            img = np.clip(img, 0, 1) if img.max() <= 1.0 else np.clip(img, 0, 255)
            img = img.astype(np.uint8)
    return img


def mask_to_yolo_and_iou(mask_path, txt_path, class_id):
    """Converts an instance mask to YOLOv8 segmentation format."""
    mask = _read_tif_any(Path(mask_path))
    if mask.ndim == 3:
        mask = mask[..., 0]

    H, W = mask.shape
    unique_ids = np.unique(mask)
    # Exclude background ID 0
    unique_ids = unique_ids[unique_ids != 0]

    lines = []
    if len(unique_ids) > 0:
        for uid in unique_ids:
            instance_mask = (mask == uid).astype(np.uint8)
            contours, _ = cv2.findContours(
                instance_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE
            )

            if len(contours) > 0:
                # Use the largest contour for the instance
                contour = max(contours, key=cv2.contourArea)
                if contour.size >= 6:  # Need at least 3 points for a polygon
                    # Normalize points for YOLO format
                    points = contour.flatten().tolist()
                    normalized_points = [
                        p / W if i % 2 == 0 else p / H for i, p in enumerate(points)
                    ]
                    line = f"{class_id} " + " ".join(
                        f"{p:.6f}" for p in normalized_points
                    )
                    lines.append(line)

    with open(txt_path, "w") as f:
        f.write("\n".join(lines))

    # Dummy return values for IoU/Dice as they aren't used here
    return 0.0, 0.0


# --- Provided Dataset Class ---
class CellSegDataset(Dataset):
    """
    General-purpose segmentation dataset that pairs images and masks by numeric index.

    Returns:
        image: H x W x 3 (RGB)
        mask:  H x W (uint16 instance IDs) OR None if require_masks=False and missing
        meta:  dict with filename info
    """

    def __init__(
        self,
        data_dir,
        ann_dir,
        split: str = "train",
        require_masks: bool = True,
        image_glob: str = "*.tif",
        mask_glob: str = "*.tif",
    ):
        self.data_dir = Path(data_dir)
        self.ann_dir = Path(ann_dir)
        self.split = split
        self.require_masks = require_masks

        self.img_dir = self.data_dir
        self.mask_dir = self.ann_dir

        img_paths = sorted(self.img_dir.glob(image_glob))
        if not img_paths:
            raise RuntimeError(f"No images found in {self.img_dir} (glob={image_glob})")

        mask_paths = sorted(self.mask_dir.glob(mask_glob))
        if not mask_paths and require_masks:
            raise RuntimeError(f"No masks found in {self.mask_dir} (glob={mask_glob})")

        img_by_idx: Dict[int, Path] = {}
        for p in img_paths:
            idx = _extract_index(p.stem)
            if idx is None:
                continue
            img_by_idx[idx] = p

        mask_by_idx: Dict[int, Path] = {}
        for p in mask_paths:
            idx = _extract_index(p.stem)
            if idx is None:
                continue
            mask_by_idx[idx] = p

        if not img_by_idx:
            raise RuntimeError(
                f"Found images in {self.img_dir} but none matched an index pattern (e.g., ...0000.tif)."
            )

        self.pairs: List[Tuple[int, Path, Optional[Path]]] = []
        for idx in sorted(img_by_idx.keys()):
            img_p = img_by_idx[idx]
            m_p = mask_by_idx.get(idx, None)
            if self.require_masks and m_p is None:
                raise RuntimeError(
                    f"Missing mask for image idx={idx}: image={img_p.name}. "
                    f"Expected a mask with the same trailing index in {self.mask_dir} "
                    f"(e.g., man_seg{idx:04d}.tif or mask{idx:04d}.tif)."
                )
            self.pairs.append((idx, img_p, m_p))

        if not self.pairs:
            raise RuntimeError("No (image, mask) pairs could be formed.")

    def __len__(self):
        return len(self.pairs)

    def __getitem__(self, i):
        idx, img_path, mask_path = self.pairs[i]
        img = _read_tif_any(img_path)
        img = _as_rgb(img)
        mask = None
        if mask_path is not None:
            m = _read_tif_any(mask_path)
            if m.ndim == 3:
                m = m[..., 0]
            mask = m.astype(np.uint16)
        meta = {
            "index": idx,
            "image_id": img_path.stem,
            "image_path": str(img_path),
            "mask_path": str(mask_path) if mask_path is not None else None,
        }
        return img, mask, meta

    def generate_yolo_dataset(
        self,
        yolo_dir: str | Path,
        *,
        class_id: int = 0,
        class_name: str = "cell",
        write_empty_labels: bool = True,
    ) -> str:
        yolo_dir = Path(yolo_dir)
        split = self.split
        yolo_image_dir = yolo_dir / "images" / split
        yolo_label_dir = yolo_dir / "labels" / split
        yolo_image_dir.mkdir(parents=True, exist_ok=True)
        yolo_label_dir.mkdir(parents=True, exist_ok=True)
        num_written = 0
        for idx, img_path, mask_path in self.pairs:
            assert img_path.exists(), f"Missing image: {img_path}"
            img = _read_tif_any(img_path)
            img = _as_rgb(img)
            if img.dtype != np.uint8:
                img = np.clip(img, 0, 255).astype(np.uint8)
            out_img_name = f"{img_path.stem}.png"
            out_img_path = yolo_image_dir / out_img_name
            if not out_img_path.exists():
                cv2.imwrite(str(out_img_path), cv2.cvtColor(img, cv2.COLOR_RGB2BGR))
            label_path = yolo_label_dir / f"{img_path.stem}.txt"
            if mask_path is not None and Path(mask_path).exists():
                mask_to_yolo_and_iou(
                    mask_path=mask_path,
                    txt_path=label_path,
                    class_id=class_id,
                )
            else:
                if write_empty_labels:
                    label_path.touch()
                else:
                    continue
            num_written += 1
        data_yaml_path = yolo_dir / "data.yaml"
        yaml_config = {
            "path": str(yolo_dir.resolve()),
            "train": "images/train",
            "val": "images/val",
            "names": {class_id: class_name},
        }
        if data_yaml_path.exists():
            try:
                with open(data_yaml_path, "r") as f:
                    existing = yaml.safe_load(f) or {}
            except Exception:
                existing = {}
            existing.update(yaml_config)
            yaml_config = existing
        with open(data_yaml_path, "w") as f:
            yaml.safe_dump(yaml_config, f, sort_keys=False)
        self.yolo_dir = yolo_dir
        self.yolo_yaml_path = str(data_yaml_path)
        print(f"Done. Wrote {num_written} samples to split={split}.")
        return str(data_yaml_path)

    def get_yolo_dataset(self) -> str:
        if not hasattr(self, "yolo_yaml_path"):
            raise RuntimeError(
                "YOLO dataset has not been generated yet. Call generate_yolo_dataset(...) first."
            )
        return self.yolo_yaml_path


def collate_fn(batch):
    imgs, masks, metas = zip(*batch)
    return list(imgs), list(masks), list(metas)


# --- Main Task Function ---
def cell_segmentation(
    train_dataset: CellSegDataset, val_dataset: CellSegDataset
) -> List[np.ndarray]:
    """
    Performs instance segmentation on a validation dataset of cell images.

    Args:
        train_dataset: A CellSegDataset containing training images and instance masks.
        val_dataset: A CellSegDataset containing validation images.

    Returns:
        A list of uint16 instance-id masks, one for each image in val_dataset.
    """

    with tempfile.TemporaryDirectory() as tmpdir:
        yolo_data_dir = Path(tmpdir) / "yolo_dataset"

        # 1. Generate YOLO-compatible datasets for training and validation
        print("Generating YOLO dataset...")
        data_yaml_path = train_dataset.generate_yolo_dataset(yolo_data_dir)
        val_dataset.generate_yolo_dataset(yolo_data_dir)  # This populates the val split

        # 2. Initialize and train the YOLOv8 model
        print("Initializing YOLOv8 model...")
        model = YOLO("yolov8s-seg.pt")  # Load a pre-trained segmentation model

        print("Starting model training...")
        # Train the model with hyperparameters suitable for high-resolution images
        results = model.train(
            data=data_yaml_path,
            epochs=100,
            imgsz=1024,
            batch=8,  # Using a smaller batch size for larger images to prevent OOM
            project="yolo_training_runs",
            name="cell_segmentation_exp",
            exist_ok=True,  # Allow overwriting previous training artifacts
            device=0 if torch.cuda.is_available() else "cpu",
            patience=10,  # Early stopping
        )

        # 3. Load the best performing model from training
        print("Loading best model checkpoint...")
        best_model_path = results.save_dir / "weights" / "best.pt"
        best_model = YOLO(best_model_path)

        # 4. Perform inference on the validation dataset
        print("Performing inference on validation set...")
        seg_mask_list = []
        for img, _, meta in val_dataset:
            # Predict on the original, full-resolution image
            # The model will handle resizing internally and return masks in the original image space
            preds = best_model.predict(
                img,
                verbose=False,
                device=0 if torch.cuda.is_available() else "cpu",
                imgsz=1024,  # Inference at the same size as training
                conf=0.25,  # Default confidence threshold
            )
            result = preds[0]

            # 5. Post-process predictions into the required instance mask format
            H, W, _ = img.shape
            final_mask = np.zeros((H, W), dtype=np.uint16)

            if result.masks is not None:
                # result.masks.data is a tensor of shape (N, H, W) with binary masks
                masks_tensor = result.masks.data.cpu().numpy()

                # Sort masks by confidence score to handle overlaps predictably
                # High confidence masks will be written last.
                if result.boxes is not None:
                    sorted_indices = result.boxes.conf.argsort()
                else:
                    sorted_indices = range(len(masks_tensor))

                for i in sorted_indices:
                    mask = masks_tensor[i, :, :]
                    instance_id = i + 1  # Assign a 1-based unique ID
                    final_mask[mask > 0.5] = instance_id  # Apply mask with a threshold

            seg_mask_list.append(final_mask)
            print(
                f"Processed image {meta['image_id']}, found {len(result.boxes) if result.boxes is not None else 0} instances."
            )

    print("Segmentation complete.")
    return seg_mask_list
