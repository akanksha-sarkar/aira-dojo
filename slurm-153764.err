e the size of a file (#lines for plaintext files, otherwise #bytes)\n     33 Also returns a human-readable string representation of the size.\n     34 """\n     35 if f.suffix in plaintext_files:\n---> 36     num_lines = sum(1 for _ in open(f))\n     37     return num_lines, f"{num_lines} lines"\n     38 else:\n\nCell In[1], line 36, in <genexpr>(.0)\n     31 """\n     32 Calculate the size of a file (#lines for plaintext files, otherwise #bytes)\n     33 Also returns a human-readable string representation of the size.\n     34 """\n     35 if f.suffix in plaintext_files:\n---> 36     num_lines = sum(1 for _ in open(f))\n     37     return num_lines, f"{num_lines} lines"\n     38 else:\n\nFile <frozen codecs>:322, in decode(self, input, final)\n\nUnicodeDecodeError: \'utf-8\' codec can\'t decode byte 0x80 in position 0: invalid start byte\n\n'}], 'completion_text': 'My approach is to use the YOLOv8m-seg model, a strong baseline for instance segmentation. I will first convert the provided datasets into YOLO format using the helper function and then train the model for 50 epochs on high-resolution 1024x1024 images to capture fine cellular details, with early stopping (patience=15) to prevent overfitting and optimize training time. After training, I will load the best-performing model checkpoint to run inference on the validation images. For the final output, I will post-process the raw predictions by sorting detected instances by their confidence scores to resolve any overlaps and then assign a unique `uint16` ID to each cell, constructing the required instance masks. As an evaluation metric, I will calculate and print the average Jaccard index across the validation set.\n\n```python\nimport numpy as np\nimport torch\nimport cv2\nfrom ultralytics import YOLO\nfrom pathlib import Path\nimport os\nimport shutil\nfrom typing import List, Tuple, Optional, Dict\n\n# The problem description implies that the following classes and helper functions\n# are available in the execution environment. They are included here for completeness\n# and to ensure the script is self-contained.\n\ndef _extract_index(fname: str) -> Optional[int]:\n    """Tries to extract a trailing integer index from a filename."""\n    import re\n    m = re.search(r"(\\d+)", fname)\n    return int(m.group(1)) if m else None\n\ndef _read_tif_any(p: Path):\n    """Read a TIF file, handling various bit depths and channel configurations."""\n    if not p.exists():\n        raise FileNotFoundError(f"TIF file not found: {p}")\n    try:\n        img = cv2.imread(str(p), cv2.IMREAD_UNCHANGED)\n        if img is None:\n            raise IOError(f"OpenCV could not read {p}")\n        return img\n    except Exception as e:\n        raise IOError(f"Could not read file {p} with OpenCV") from e\n\ndef _as_rgb(img: np.ndarray) -> np.ndarray:\n    """Converts a grayscale or other format image to 3-channel RGB uint8."""\n    if img.ndim == 2:\n        img = cv2.cvtColor(img, cv2.COLOR_GRAY2RGB)\n    elif img.ndim == 3 and img.shape[2] == 1:\n        img = cv2.cvtColor(img, cv2.COLOR_GRAY2RGB)\n    elif img.ndim == 3 and img.shape[2] > 3:\n        img = img[..., :3]\n\n    if img.dtype != np.uint8:\n        if img.dtype == np.uint16:\n            img = (img / 256).astype(np.uint8)\n        else:\n            min_val, max_val = img.min(), img.max()\n            if max_val > min_val:\n                img = ((img - min_val) / (max_val - min_val) * 255.0).astype(np.uint8)\n            else:\n                img = np.zeros_like(img, dtype=np.uint8)\n    \n    if img.shape[2] != 3:\n        # Fallback for unexpected channel counts\n        img = cv2.cvtColor(img, cv2.COLOR_GRAY2RGB) if img.ndim == 2 else img[:,:,:3]\n\n    return img\n\ndef mask_to_yolo_and_iou(mask_path, txt_path, class_id=0):\n    """Converts instance mask to YOLO segmentation format and calculates IOU/Dice."""\n    import yaml\n    \n    mask = _read_tif_any(Path(mask_path))\n    if mask.ndim == 3:\n        mask = mask[..., 0]\n    \n    H, W = mask.shape\n    lines = []\n    instance_ids = sorted(np.unique(mask))\n    instance_ids = [i for i in instance_ids if i > 0]\n\n    for inst_id in instance_ids:\n        binary_mask = (mask == inst_id).astype(np.uint8)\n        contours, _ = cv2.findContours(binary_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n        \n        if not contours:\n            continue\n\n        contour = max(contours, key=cv2.contourArea)\n        if cv2.contourArea(contour) < 3: # Skip tiny instances\n            continue\n            \n        poly = contour.squeeze()\n        if len(poly) < 3:\n            continue\n\n        poly_normalized = poly / np.array([W, H])\n        line = f"{class_id} " + " ".join(map(str, poly_normalized.flatten()))\n        lines.append(line)\n\n    with open(txt_path, "w") as f:\n        f.write("\\n".join(lines))\n    \n    return 0.0, 0.0 # Placeholder for IoU/Dice, not calculated here\n\nclass CellSegDataset:\n    def __init__(self, data_dir, ann_dir, split: str = "train", require_masks: bool = True, image_glob: str = "*.tif", mask_glob: str = "*.tif"):\n        self.data_dir = Path(data_dir)\n        self.ann_dir = Path(ann_dir)\n        self.split = split\n        self.require_masks = require_masks\n        self.img_dir, self.mask_dir = self.data_dir, self.ann_dir\n        img_paths = sorted(self.img_dir.glob(image_glob))\n        mask_paths = sorted(self.mask_dir.glob(mask_glob)) if self.ann_dir.exists() else []\n\n        img_by_idx: Dict[int, Path] = {idx: p for p in img_paths if (idx := _extract_index(p.stem)) is not None}\n        mask_by_idx: Dict[int, Path] = {idx: p for p in mask_paths if (idx := _extract_index(p.stem)) is not None}\n\n        if not img_by_idx: raise RuntimeError(f"No indexed images found in {self.img_dir}")\n        self.pairs: List[Tuple[int, Path, Optional[Path]]] = []\n        for idx in sorted(img_by_idx.keys()):\n            img_p, m_p = img_by_idx[idx], mask_by_idx.get(idx)\n            if self.require_masks and m_p is None:\n                raise RuntimeError(f"Missing mask for image idx={idx}")\n            self.pairs.append((idx, img_p, m_p))\n\n    def __len__(self): return len(self.pairs)\n\n    def __getitem__(self, i):\n        idx, img_path, mask_path = self.pairs[i]\n        img = _read_tif_any(img_path)\n        img = _as_rgb(img)\n        mask = None\n        if mask_path is not None:\n            m = _read_tif_any(mask_path)\n            if m.ndim == 3: m = m[..., 0]\n            mask = m.astype(np.uint16)\n        meta = {"index": idx, "image_id": img_path.stem, "image_path": str(img_path), "mask_path": str(mask_path) if mask_path else None}\n        return img, mask, meta\n\n    def generate_yolo_dataset(self, yolo_dir: str | Path, *, class_id: int = 0, class_name: str = "cell") -> str:\n        import yaml\n        yolo_dir = Path(yolo_dir)\n        yolo_image_dir = yolo_dir / "images" / self.split\n        yolo_label_dir = yolo_dir / "labels" / self.split\n        yolo_image_dir.mkdir(parents=True, exist_ok=True)\n        yolo_label_dir.mkdir(parents=True, exist_ok=True)\n\n        for _, img_path, mask_path in self.pairs:\n            img = _read_tif_any(img_path)\n            img = _as_rgb(img)\n            out_img_path = yolo_image_dir / f"{img_path.stem}.png"\n            if not out_img_path.exists():\n                cv2.imwrite(str(out_img_path), cv2.cvtColor(img, cv2.COLOR_RGB2BGR))\n            \n            label_path = yolo_label_dir / f"{img_path.stem}.txt"\n            if mask_path and Path(mask_path).exists():\n                mask_to_yolo_and_iou(mask_path=mask_path, txt_path=label_path, class_id=class_id)\n            else:\n                label_path.touch()\n\n        data_yaml_path = yolo_dir / "data.yaml"\n        yaml_config = {"path": str(yolo_dir.resolve()), "train": "images/train", "val": "images/val", "names": {class_id: class_name}}\n        if data_yaml_path.exists():\n            try:\n                with open(data_yaml_path, "r") as f: existing = yaml.safe_load(f) or {}\n                existing.update(yaml_config)\n                yaml_config = existing\n            except Exception: pass\n        with open(data_yaml_path, "w") as f: yaml.safe_dump(yaml_config, f, sort_keys=False)\n        return str(data_yaml_path)\n\ndef calculate_jaccard(gt_mask, pred_mask):\n    """Calculates the Jaccard index for instance segmentation."""\n    gt_ids = np.unique(gt_mask)[1:]\n    pred_ids = np.unique(pred_mask)[1:]\n\n    if len(gt_ids) == 0 and len(pred_ids) == 0: return 1.0\n    if len(gt_ids) == 0 or len(pred_ids) == 0: return 0.0\n\n    iou_matrix = np.zeros((len(gt_ids), len(pred_ids)), dtype=np.float32)\n    for i, gt_id in enumerate(gt_ids):\n        for j, pred_id in enumerate(pred_ids):\n            gt_instance = (gt_mask == gt_id)\n            pred_instance = (pred_mask == pred_id)\n            intersection = np.logical_and(gt_instance, pred_instance).sum()\n            union = np.logical_or(gt_instance, pred_instance).sum()\n            iou_matrix[i, j] = intersection / union if union > 0 else 0\n    \n    # Greedy matching\n    matches = []\n    matched_pred_ids = set()\n    for i in range(len(gt_ids)):\n        best_iou_for_gt = -1.0\n        best_pred_idx = -1\n        for j in range(len(pred_ids)):\n            if j not in matched_pred_ids:\n                if iou_matrix[i, j] > best_iou_for_gt:\n                    best_iou_for_gt = iou_matrix[i, j]\n                    best_pred_idx = j\n        \n        if best_iou_for_gt > 0.5: # IoU threshold for a match\n            matches.append(best_iou_for_gt)\n            if best_pred_idx != -1:\n                matched_pred_ids.add(best_pred_idx)\n\n    tp = len(matches)\n    fp = len(pred_ids) - tp\n    fn = len(gt_ids) - tp\n    \n    return tp / (tp + fp + fn) if (tp + fp + fn) > 0 else 0\n\ndef cell_segmentation(train_dataset: CellSegDataset, val_dataset: CellSegDataset) -> List[np.ndarray]:\n    """\n    Performs instance segmentation on cell images using a YOLOv8 model.\n    """\n    # 1. Setup workspace\n    WORK_DIR = Path("./yolo_cell_seg")\n    if WORK_DIR.exists():\n        shutil.rmtree(WORK_DIR)\n    WORK_DIR.mkdir(parents=True, exist_ok=True)\n\n    # 2. Generate YOLO datasets\n    print("Generating YOLO format datasets...")\n    data_yaml_path = train_dataset.generate_yolo_dataset(WORK_DIR)\n    val_dataset.generate_yolo_dataset(WORK_DIR)\n    print(f"YOLO dataset created. YAML at: {data_yaml_path}")\n\n    # 3. Train the model\n    model = YOLO(\'yolov8m-seg.pt\')\n    \n    print("Starting YOLOv8 model training...")\n    model.train(\n        data=data_yaml_path,\n        epochs=50,\n        imgsz=1024,\n        batch=4, # Safe batch size for 11GB VRAM\n        patience=15,\n        project=str(WORK_DIR / "training_runs"),\n        name="cell_seg_exp",\n        device=0 if torch.cuda.is_available() else \'cpu\',\n        exist_ok=True,\n    )\n    print("Model training finished.")\n\n    # 4. Load the best model for inference\n    best_model_path = WORK_DIR / "training_runs/cell_seg_exp/weights/best.pt"\n    if not best_model_path.exists():\n        raise FileNotFoundError(f"Best model not found at {best_model_path}")\n    print(f"Loading best model from: {best_model_path}")\n    best_model = YOLO(best_model_path)\n\n    # 5. Perform inference and post-processing\n    seg_mask_list = []\n    print(f"Running inference on {len(val_dataset)} validation images...")\n    for img, _, meta in val_dataset:\n        H, W, _ = img.shape\n        \n        results = best_model.predict(\n            source=img,\n            imgsz=1024,\n            conf=0.25,\n            verbose=False,\n        )\n        \n        result = results[0]\n        final_mask = np.zeros((H, W), dtype=np.uint16)\n        \n        if result.masks is not None and result.boxes is not None:\n            confs = result.boxes.conf\n            sorted_indices = torch.argsort(confs, descending=True)\n            masks_data = result.masks.data\n            \n            instance_id = 1\n            for i in sorted_indices:\n                mask_tensor = masks_data[i]\n                mask_np = mask_tensor.cpu().numpy()\n                resized_mask = cv2.resize(mask_np, (W, H), interpolation=cv2.INTER_NEAREST)\n                final_mask[resized_mask > 0.5] = instance_id\n                instance_id += 1\n                \n        seg_mask_list.append(final_mask)\n    print("Inference complete.")\n\n    # 6. Evaluate and print metric\n    print("Calculating validation metric...")\n    gt_masks = [m for _, m, _ in val_dataset if m is not None]\n    if len(gt_masks) == len(seg_mask_list):\n        total_jaccard = 0\n        for pred_m, gt_m in zip(seg_mask_list, gt_masks):\n            total_jaccard += calculate_jaccard(gt_m, pred_m)\n        avg_jaccard = total_jaccard / len(gt_masks) if len(gt_masks) > 0 else 0\n        print(f"Validation Metric (Average Jaccard Index): {avg_jaccard}")\n    else:\n        print("Could not compute validation metric: ground truth masks not available for all validation images.")\n\n    return seg_mask_list\n\n```'}, {'usage': {'prompt_tokens': 9019, 'completion_tokens': 100, 'total_tokens': 10374, 'latency': 12.982035461987834, 'cumulative_num_llm_calls': 5}, 'prompt_messages': [{'role': 'system', 'content': '# Introduction:\n You are a Computer Vision Expert writing programs for high-stakes scientific research. \nYou have written code to solve this task and now need to evaluate the output of the code execution.\nYou should determine if there were any bugs as well as report the empirical findings.\n\n# Task Description:\nYou are an experienced machine learning engineer who is helping scientists from different domains of science. Your task is to help\nscientists in domains that typically require many manual annotations. Specifically, you will be implementing programs that use \nmachine learning methods to train models on a set of data for a specific task.\n\nBENCHMARK INSTRUCTIONS\n------\nFirst, please read the instructions below which are specific to our benchmark setup. Note, these instructions can be found again in `/home/instructions.txt`.\n\n- **Task-specific instructions**: The instructions for the task are available in `./work/description.md`. Read this file to understand the problem setup for the task you are currently solving.\n\nTASK\n-----\nFor a given task, you will be provided with an initial program that you must optimize to maximize performance on the task.\n**Data setup and loading will be handled for you as input to the program, the task will describe the necessary output of your program.**\nThe focus of optimizations should be on machine learning engineering (i.e testing different models, hyperparameters, etc). Consider exploring a variety of model architectures and frameworks -- the data format or domain conventions should not constrain your choice of approach.\n\nADDITIONAL NOTES\n------\n\n- **Compute**: You have access to NVIDIA GeForce RTX 2080 Ti with the appropriate drivers installed.\n- **Total Runtime**: You have a maximum of 4hrs 0mins 0secs to attempt this task. You may iteratively develop your solution within this time frame, but bear in mind that program runtime also counts towards this limit.\n- **Total Steps**: You have a maximum of 500 steps to submit your solution.\n- You will be informed of the remaining time and steps at each step.\n- **Use as much of the available time as possible to refine and optimize your submission**: Your goal is to achieve the best possible score, not just to submit your first working solution. Consider strategies like manually spot-checking predictions, building custom validation sets and grading functions, and comparing different algorithms. You may keep working until the time limit expires -- as long as your best submission is stored at the designated location at the end of your run, it will be picked up for grading.\n\nUNDERSTANDING BIOLOGY-SPECIFIC IMAGE DATA\n------\nBiology images often have different characteristics than standard computer vision datasets:\n\n**Image Resolution and Object Scales:**\n- Biology images are frequently high-resolution/bigger in pixel size, with image sizes up to 8K (7680 x 4320) being common.\n- Objects of interest (animals, cells) may occupy only a small number of pixels within these large images.\n- **Important:** Aggressive downsampling can destroy critical information when objects are small. Carefully consider whether resizing is necessary and what resolution preserves the details needed for detection.\n- If resizing, consider whether the chosen resolution maintains sufficient detail for small objects.\n\nTASK INSTRUCTIONS\n------\n\n# Cell Segmentation\n\n## Dataset Description\n\nThe study of how cells grow, divide, and interact over time is a core problem in biology. A fundamental prerequisite for many downstream analyses—such as tracking, lineage inference, and morphology measurement—is cell segmentation: identifying which pixels belong to which individual cells in an image. The dataset consists of microscopy images of cells along with corresponding instance-level annotations. Each image may contain multiple cells, and each cell should be assigned a unique instance ID. Background pixels are labeled as 0. The data is exposed through a CellSegDataset abstraction, which provides access to images and instance masks and supports exporting the data into YOLO-compatible segmentation format.\n\n## Task Description\n\nYour goal is to implement a function called cell_segmentation that performs instance segmentation on a validation dataset of cell images.\n\nYou must implement the following function:\n\n```python\ndef cell_segmentation(train_dataset: CellSegDataset, val_dataset: CellSegDataset):\n    """\n\tInput\n\t•\ttrain_dataset: a CellSegDataset containing training images and instance masks.\n\t•\tval_dataset: a CellSegDataset containing validation images (and possibly masks).\n\n    Returns:\n        seg_mask_list: list[np.ndarray] of uint16 instance-id masks, one per image in val_dataset\n    """\n```\n\nYou have access to a CellSegDataset for training with corresponding annotations. You must produce predictions on a validation CellSegDataset which you will be evaluated on.\n\nThe CellSegDataset class is provided below: \n\n```python\nclass CellSegDataset(Dataset):\n    """\n    General-purpose segmentation dataset that pairs images and masks by numeric index.\n\n    Returns:\n        image: H x W x 3 (RGB)\n        mask:  H x W (uint16 instance IDs) OR None if require_masks=False and missing\n        meta:  dict with filename info\n    """\n\n    def __init__(\n        self,\n        data_dir,\n        ann_dir,\n        split: str = "train",\n        require_masks: bool = True,\n        image_glob: str = "*.tif",\n        mask_glob: str = "*.tif",\n    ):\n        self.data_dir = Path(data_dir)\n        self.ann_dir = Path(ann_dir)\n        self.split = split\n        self.require_masks = require_masks\n\n        self.img_dir = self.data_dir\n        self.mask_dir = self.ann_dir\n\n        img_paths = sorted(self.img_dir.glob(image_glob))\n        if not img_paths:\n            raise RuntimeError(f"No images found in {self.img_dir} (glob={image_glob})")\n\n        mask_paths = sorted(self.mask_dir.glob(mask_glob))\n        if not mask_paths and require_masks:\n            raise RuntimeError(f"No masks found in {self.mask_dir} (glob={mask_glob})")\n\n        # Build index->path maps\n        img_by_idx: Dict[int, Path] = {}\n        for p in img_paths:\n            idx = _extract_index(p.stem)\n            if idx is None:\n                continue\n            img_by_idx[idx] = p\n\n        mask_by_idx: Dict[int, Path] = {}\n        for p in mask_paths:\n            idx = _extract_index(p.stem)\n            if idx is None:\n                continue\n            mask_by_idx[idx] = p\n\n        if not img_by_idx:\n            raise RuntimeError(\n                f"Found images in {self.img_dir} but none matched an index pattern (e.g., ...0000.tif)."\n            )\n\n        self.pairs: List[Tuple[int, Path, Optional[Path]]] = []\n        for idx in sorted(img_by_idx.keys()):\n            img_p = img_by_idx[idx]\n            m_p = mask_by_idx.get(idx, None)\n\n            if self.require_masks and m_p is None:\n                # Hard fail early so you don\'t discover this deep in training.\n                raise RuntimeError(\n                    f"Missing mask for image idx={idx}: image={img_p.name}. "\n                    f"Expected a mask with the same trailing index in {self.mask_dir} "\n                    f"(e.g., man_seg{idx:04d}.tif or mask{idx:04d}.tif)."\n                )\n\n            self.pairs.append((idx, img_p, m_p))\n\n        if not self.pairs:\n            raise RuntimeError("No (image, mask) pairs could be formed.")\n\n    def __len__(self):\n        return len(self.pairs)\n\n    def __getitem__(self, i):\n        idx, img_path, mask_path = self.pairs[i]\n\n        # --- Load image ---\n        img = _read_tif_any(img_path)\n        img = _as_rgb(img)\n\n        # --- Load mask ---\n        mask = None\n        if mask_path is not None:\n            m = _read_tif_any(mask_path)\n            if m.ndim == 3: # Some GT masks can be saved as HxWx1\n                m = m[..., 0]\n            mask = m.astype(np.uint16)\n\n        meta = {\n            "index": idx,\n            "image_id": img_path.stem,\n            "image_path": str(img_path),\n            "mask_path": str(mask_path) if mask_path is not None else None,\n        }\n\n        return img, mask, meta\n\n    def generate_yolo_dataset(self, yolo_dir: str | Path, *, class_id: int = 0, class_name: str = "cell", write_empty_labels: bool = True) -> str:\n        """\n        Generate Ultralytics YOLOv8-seg dataset for this dataset\'s split.\n\n        Writes:\n            yolo_dir/\n            images/<split>/*.png\n            labels/<split>/*.txt\n            data.yaml\n\n        Returns:\n            str path to yolo_dir/data.yaml\n        """\n        yolo_dir = Path(yolo_dir)\n        split = self.split\n\n        print(f"Building YOLO-seg dataset at {yolo_dir} (split={split})...")\n\n        yolo_image_dir = yolo_dir / "images" / split\n        yolo_label_dir = yolo_dir / "labels" / split\n        yolo_image_dir.mkdir(parents=True, exist_ok=True)\n        yolo_label_dir.mkdir(parents=True, exist_ok=True)\n\n        num_written = 0\n\n        for idx, img_path, mask_path in self.pairs:\n            assert img_path.exists(), f"Missing image: {img_path}"\n\n            # ---------- IMAGE EXPORT (force 3-channel PNG) ----------\n            img = _read_tif_any(img_path)\n            img = _as_rgb(img)\n\n            if img.dtype != np.uint8:\n                img = np.clip(img, 0, 255).astype(np.uint8)\n\n            out_img_name = f"{img_path.stem}.png"\n            out_img_path = yolo_image_dir / out_img_name\n\n            if not out_img_path.exists():\n                cv2.imwrite(str(out_img_path), cv2.cvtColor(img, cv2.COLOR_RGB2BGR))\n\n            # ---------- LABEL GENERATION ----------\n            label_path = yolo_label_dir / f"{img_path.stem}.txt"\n\n            if mask_path is not None and Path(mask_path).exists():\n                iou, dice = mask_to_yolo_and_iou(\n                    mask_path=mask_path,\n                    txt_path=label_path,\n                    class_id=class_id,\n                )\n            else:\n                if write_empty_labels:\n                    label_path.touch()\n                else:\n                    continue\n\n            num_written += 1\n\n        # ---------- WRITE data.yaml ----------\n        data_yaml_path = yolo_dir / "data.yaml"\n        yaml_config = {\n            "path": str(yolo_dir.resolve()),\n            "train": "images/train",\n            "val": "images/val",\n            "names": {class_id: class_name},\n        }\n\n        if data_yaml_path.exists():\n            try:\n                with open(data_yaml_path, "r") as f:\n                    existing = yaml.safe_load(f) or {}\n            except Exception:\n                existing = {}\n            existing.update(yaml_config)\n            yaml_config = existing\n\n        with open(data_yaml_path, "w") as f:\n            yaml.safe_dump(yaml_config, f, sort_keys=False)\n\n        self.yolo_dir = yolo_dir\n        self.yolo_yaml_path = str(data_yaml_path)\n\n        print(f"Done. Wrote {num_written} samples to split={split}.")\n        return str(data_yaml_path)\n\n\n    def get_yolo_dataset(self) -> str:\n        if not hasattr(self, "yolo_yaml_path"):\n            raise RuntimeError("YOLO dataset has not been generated yet. Call generate_yolo_dataset(...) first.")\n        return self.yolo_yaml_path\n\ndef collate_fn(batch):\n    imgs, masks, metas = zip(*batch)\n    return list(imgs), list(masks), list(metas)\n```\n\n# Implementation:\n```python\nimport numpy as np\nimport torch\nimport cv2\nfrom ultralytics import YOLO\nfrom pathlib import Path\nimport os\nimport shutil\nfrom typing import List, Tuple, Optional, Dict\n\n# The problem description implies that the following classes and helper functions\n# are available in the execution environment. They are included here for completeness\n# and to ensure the script is self-contained.\n\n\ndef _extract_index(fname: str) -> Optional[int]:\n    """Tries to extract a trailing integer index from a filename."""\n    import re\n\n    m = re.search(r"(\\d+)", fname)\n    return int(m.group(1)) if m else None\n\n\ndef _read_tif_any(p: Path):\n    """Read a TIF file, handling various bit depths and channel configurations."""\n    if not p.exists():\n        raise FileNotFoundError(f"TIF file not found: {p}")\n    try:\n        img = cv2.imread(str(p), cv2.IMREAD_UNCHANGED)\n        if img is None:\n            raise IOError(f"OpenCV could not read {p}")\n        return img\n    except Exception as e:\n        raise IOError(f"Could not read file {p} with OpenCV") from e\n\n\ndef _as_rgb(img: np.ndarray) -> np.ndarray:\n    """Converts a grayscale or other format image to 3-channel RGB uint8."""\n    if img.ndim == 2:\n        img = cv2.cvtColor(img, cv2.COLOR_GRAY2RGB)\n    elif img.ndim == 3 and img.shape[2] == 1:\n        img = cv2.cvtColor(img, cv2.COLOR_GRAY2RGB)\n    elif img.ndim == 3 and img.shape[2] > 3:\n        img = img[..., :3]\n\n    if img.dtype != np.uint8:\n        if img.dtype == np.uint16:\n            img = (img / 256).astype(np.uint8)\n        else:\n            min_val, max_val = img.min(), img.max()\n            if max_val > min_val:\n                img = ((img - min_val) / (max_val - min_val) * 255.0).astype(np.uint8)\n            else:\n                img = np.zeros_like(img, dtype=np.uint8)\n\n    if img.shape[2] != 3:\n        # Fallback for unexpected channel counts\n        img = cv2.cvtColor(img, cv2.COLOR_GRAY2RGB) if img.ndim == 2 else img[:, :, :3]\n\n    return img\n\n\ndef mask_to_yolo_and_iou(mask_path, txt_path, class_id=0):\n    """Converts instance mask to YOLO segmentation format and calculates IOU/Dice."""\n    import yaml\n\n    mask = _read_tif_any(Path(mask_path))\n    if mask.ndim == 3:\n        mask = mask[..., 0]\n\n    H, W = mask.shape\n    lines = []\n    instance_ids = sorted(np.unique(mask))\n    instance_ids = [i for i in instance_ids if i > 0]\n\n    for inst_id in instance_ids:\n        binary_mask = (mask == inst_id).astype(np.uint8)\n        contours, _ = cv2.findContours(\n            binary_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE\n        )\n\n        if not contours:\n            continue\n\n        contour = max(contours, key=cv2.contourArea)\n        if cv2.contourArea(contour) < 3:  # Skip tiny instances\n            continue\n\n        poly = contour.squeeze()\n        if len(poly) < 3:\n            continue\n\n        poly_normalized = poly / np.array([W, H])\n        line = f"{class_id} " + " ".join(map(str, poly_normalized.flatten()))\n        lines.append(line)\n\n    with open(txt_path, "w") as f:\n        f.write("\\n".join(lines))\n\n    return 0.0, 0.0  # Placeholder for IoU/Dice, not calculated here\n\n\nclass CellSegDataset:\n    def __init__(\n        self,\n        data_dir,\n        ann_dir,\n        split: str = "train",\n        require_masks: bool = True,\n        image_glob: str = "*.tif",\n        mask_glob: str = "*.tif",\n    ):\n        self.data_dir = Path(data_dir)\n        self.ann_dir = Path(ann_dir)\n        self.split = split\n        self.require_masks = require_masks\n        self.img_dir, self.mask_dir = self.data_dir, self.ann_dir\n        img_paths = sorted(self.img_dir.glob(image_glob))\n        mask_paths = (\n            sorted(self.mask_dir.glob(mask_glob)) if self.ann_dir.exists() else []\n        )\n\n        img_by_idx: Dict[int, Path] = {\n            idx: p for p in img_paths if (idx := _extract_index(p.stem)) is not None\n        }\n        mask_by_idx: Dict[int, Path] = {\n            idx: p for p in mask_paths if (idx := _extract_index(p.stem)) is not None\n        }\n\n        if not img_by_idx:\n            raise RuntimeError(f"No indexed images found in {self.img_dir}")\n        self.pairs: List[Tuple[int, Path, Optional[Path]]] = []\n        for idx in sorted(img_by_idx.keys()):\n            img_p, m_p = img_by_idx[idx], mask_by_idx.get(idx)\n            if self.require_masks and m_p is None:\n                raise RuntimeError(f"Missing mask for image idx={idx}")\n            self.pairs.append((idx, img_p, m_p))\n\n    def __len__(self):\n        return len(self.pairs)\n\n    def __getitem__(self, i):\n        idx, img_path, mask_path = self.pairs[i]\n        img = _read_tif_any(img_path)\n        img = _as_rgb(img)\n        mask = None\n        if mask_path is not None:\n            m = _read_tif_any(mask_path)\n            if m.ndim == 3:\n                m = m[..., 0]\n            mask = m.astype(np.uint16)\n        meta = {\n            "index": idx,\n            "image_id": img_path.stem,\n            "image_path": str(img_path),\n            "mask_path": str(mask_path) if mask_path else None,\n        }\n        return img, mask, meta\n\n    def generate_yolo_dataset(\n        self, yolo_dir: str | Path, *, class_id: int = 0, class_name: str = "cell"\n    ) -> str:\n        import yaml\n\n        yolo_dir = Path(yolo_dir)\n        yolo_image_dir = yolo_dir / "images" / self.split\n        yolo_label_dir = yolo_dir / "labels" / self.split\n        yolo_image_dir.mkdir(parents=True, exist_ok=True)\n        yolo_label_dir.mkdir(parents=True, exist_ok=True)\n\n        for _, img_path, mask_path in self.pairs:\n            img = _read_tif_any(img_path)\n            img = _as_rgb(img)\n            out_img_path = yolo_image_dir / f"{img_path.stem}.png"\n            if not out_img_path.exists():\n                cv2.imwrite(str(out_img_path), cv2.cvtColor(img, cv2.COLOR_RGB2BGR))\n\n            label_path = yolo_label_dir / f"{img_path.stem}.txt"\n            if mask_path and Path(mask_path).exists():\n                mask_to_yolo_and_iou(\n                    mask_path=mask_path, txt_path=label_path, class_id=class_id\n                )\n            else:\n                label_path.touch()\n\n        data_yaml_path = yolo_dir / "data.yaml"\n        yaml_config = {\n            "path": str(yolo_dir.resolve()),\n            "train": "images/train",\n            "val": "images/val",\n            "names": {class_id: class_name},\n        }\n        if data_yaml_path.exists():\n            try:\n                with open(data_yaml_path, "r") as f:\n                    existing = yaml.safe_load(f) or {}\n                existing.update(yaml_config)\n                yaml_config = existing\n            except Exception:\n                pass\n        with open(data_yaml_path, "w") as f:\n            yaml.safe_dump(yaml_config, f, sort_keys=False)\n        return str(data_yaml_path)\n\n\ndef calculate_jaccard(gt_mask, pred_mask):\n    """Calculates the Jaccard index for instance segmentation."""\n    gt_ids = np.unique(gt_mask)[1:]\n    pred_ids = np.unique(pred_mask)[1:]\n\n    if len(gt_ids) == 0 and len(pred_ids) == 0:\n        return 1.0\n    if len(gt_ids) == 0 or len(pred_ids) == 0:\n        return 0.0\n\n    iou_matrix = np.zeros((len(gt_ids), len(pred_ids)), dtype=np.float32)\n    for i, gt_id in enumerate(gt_ids):\n        for j, pred_id in enumerate(pred_ids):\n            gt_instance = gt_mask == gt_id\n            pred_instance = pred_mask == pred_id\n            intersection = np.logical_and(gt_instance, pred_instance).sum()\n            union = np.logical_or(gt_instance, pred_instance).sum()\n            iou_matrix[i, j] = intersection / union if union > 0 else 0\n\n    # Greedy matching\n    matches = []\n    matched_pred_ids = set()\n    for i in range(len(gt_ids)):\n        best_iou_for_gt = -1.0\n        best_pred_idx = -1\n        for j in range(len(pred_ids)):\n            if j not in matched_pred_ids:\n                if iou_matrix[i, j] > best_iou_for_gt:\n                    best_iou_for_gt = iou_matrix[i, j]\n                    best_pred_idx = j\n\n        if best_iou_for_gt > 0.5:  # IoU threshold for a match\n            matches.append(best_iou_for_gt)\n            if best_pred_idx != -1:\n                matched_pred_ids.add(best_pred_idx)\n\n    tp = len(matches)\n    fp = len(pred_ids) - tp\n    fn = len(gt_ids) - tp\n\n    return tp / (tp + fp + fn) if (tp + fp + fn) > 0 else 0\n\n\ndef cell_segmentation(\n    train_dataset: CellSegDataset, val_dataset: CellSegDataset\n) -> List[np.ndarray]:\n    """\n    Performs instance segmentation on cell images using a YOLOv8 model.\n    """\n    # 1. Setup workspace\n    WORK_DIR = Path("./yolo_cell_seg")\n    if WORK_DIR.exists():\n        shutil.rmtree(WORK_DIR)\n    WORK_DIR.mkdir(parents=True, exist_ok=True)\n\n    # 2. Generate YOLO datasets\n    print("Generating YOLO format datasets...")\n    data_yaml_path = train_dataset.generate_yolo_dataset(WORK_DIR)\n    val_dataset.generate_yolo_dataset(WORK_DIR)\n    print(f"YOLO dataset created. YAML at: {data_yaml_path}")\n\n    # 3. Train the model\n    model = YOLO("yolov8m-seg.pt")\n\n    print("Starting YOLOv8 model training...")\n    model.train(\n        data=data_yaml_path,\n        epochs=50,\n        imgsz=1024,\n        batch=4,  # Safe batch size for 11GB VRAM\n        patience=15,\n        project=str(WORK_DIR / "training_runs"),\n        name="cell_seg_exp",\n        device=0 if torch.cuda.is_available() else "cpu",\n        exist_ok=True,\n    )\n    print("Model training finished.")\n\n    # 4. Load the best model for inference\n    best_model_path = WORK_DIR / "training_runs/cell_seg_exp/weights/best.pt"\n    if not best_model_path.exists():\n        raise FileNotFoundError(f"Best model not found at {best_model_path}")\n    print(f"Loading best model from: {best_model_path}")\n    best_model = YOLO(best_model_path)\n\n    # 5. Perform inference and post-processing\n    seg_mask_list = []\n    print(f"Running inference on {len(val_dataset)} validation images...")\n    for img, _, meta in val_dataset:\n        H, W, _ = img.shape\n\n        results = best_model.predict(\n            source=img,\n            imgsz=1024,\n            conf=0.25,\n            verbose=False,\n        )\n\n        result = results[0]\n        final_mask = np.zeros((H, W), dtype=np.uint16)\n\n        if result.masks is not None and result.boxes is not None:\n            confs = result.boxes.conf\n            sorted_indices = torch.argsort(confs, descending=True)\n            masks_data = result.masks.data\n\n            instance_id = 1\n            for i in sorted_indices:\n                mask_tensor = masks_data[i]\n                mask_np = mask_tensor.cpu().numpy()\n                resized_mask = cv2.resize(\n                    mask_np, (W, H), interpolation=cv2.INTER_NEAREST\n                )\n                final_mask[resized_mask > 0.5] = instance_id\n                instance_id += 1\n\n        seg_mask_list.append(final_mask)\n    print("Inference complete.")\n\n    # 6. Evaluate and print metric\n    print("Calculating validation metric...")\n    gt_masks = [m for _, m, _ in val_dataset if m is not None]\n    if len(gt_masks) == len(seg_mask_list):\n        total_jaccard = 0\n        for pred_m, gt_m in zip(seg_mask_list, gt_masks):\n            total_jaccard += calculate_jaccard(gt_m, pred_m)\n        avg_jaccard = total_jaccard / len(gt_masks) if len(gt_masks) > 0 else 0\n        print(f"Validation Metric (Average Jaccard Index): {avg_jaccard}")\n    else:\n        print(\n            "Could not compute validation metric: ground truth masks not available for all validation images."\n        )\n\n    return seg_mask_list\n\n```\n\n# Execution output:\n```\n✅ Added /work to sys.path\nWorking dir: /\n✅ Added /work to sys.path\nWorking dir: /\n  program_path: /work/program.py (exists: True)\n[INFO] Loading program from /work/program.py\nWARNING ⚠️ user config directory \'/root/.config/Ultralytics\' is not writable, using \'/tmp/Ultralytics\'. Set YOLO_CONFIG_DIR to override.\nCreating new Ultralytics Settings v0.0.6 file ✅ \nView Ultralytics Settings with \'yolo settings\' or at \'/tmp/Ultralytics/settings.json\'\nUpdate Settings with \'yolo settings key=value\', i.e. \'yolo settings runs_dir=path/to/dir\'. For help see https://docs.ultralytics.com/quickstart/#ultralytics-settings.\n[INFO] [SEQ 01] train_data=/work/data/train/01/img\n[INFO] [SEQ 01] train_ann =/work/data/train/01/seg\n[INFO] [SEQ 01] val_data  =/work/data/val/01/img\n[INFO] [SEQ 01] val_ann   =/work/data/val/01/GT/SEG\n[INFO] [SEQ 01] gt_root   =/work/data/val/01/GT\nUsing YOLO dataset directory: /cache/yolo_cellseg\nBuilding YOLO-seg dataset at /cache/yolo_cellseg (split=train)...\nDone. Wrote 343 samples to split=