'import numpy as np
import torch
from torch.utils.data import Dataset
from pathlib import Path
import cv2
import yaml
from typing import Dict, List, Optional, Tuple
from ultralytics import YOLO
import shutil
import os
import re

# --- Provided Dataset Class and Helpers ---
# These functions and the class are assumed to be defined in the execution environment
# based on the problem description. They are included here for completeness.


def _read_tif_any(p: Path):
    """Read a TIF file, handling various compressions and bit depths."""
    return cv2.imread(str(p), cv2.IMREAD_UNCHANGED)


def _as_rgb(img: np.ndarray) -> np.ndarray:
    """Ensure image is 3-channel RGB."""
    if img.ndim == 2:
        return cv2.cvtColor(img, cv2.COLOR_GRAY2RGB)
    if img.shape[2] == 4:
        return cv2.cvtColor(img, cv2.COLOR_BGRA2RGB)
    if img.shape[2] == 1:
        return cv2.cvtColor(img, cv2.COLOR_GRAY2RGB)
    return img


def _extract_index(stem: str) -> Optional[int]:
    """Extract trailing integer from a filename stem."""
    m = re.search(r"\d+$", stem)
    return int(m.group()) if m else None


def mask_to_yolo_and_iou(mask_path: Path, txt_path: Path, class_id: int = 0):
    """
    Convert a .tif instance mask to YOLO segmentation format.
    """
    instance_mask = _read_tif_any(mask_path)
    h, w = instance_mask.shape[:2]
    lines = []

    instance_ids = np.unique(instance_mask)
    instance_ids = instance_ids[instance_ids != 0]

    for instance_id in instance_ids:
        binary_mask = (instance_mask == instance_id).astype(np.uint8)
        contours, _ = cv2.findContours(
            binary_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE
        )

        if not contours:
            continue

        contour = max(contours, key=cv2.contourArea)

        if contour.shape[0] < 3:
            continue

        poly = contour.squeeze(axis=1)
        poly = poly / np.array([w, h])

        poly_str = " ".join([f"{p[0]:.6f} {p[1]:.6f}" for p in poly])
        lines.append(f"{class_id} {poly_str}")

    with open(txt_path, "w") as f:
        f.write("\n".join(lines))

    return 0, 0  # Dummy return values


class CellSegDataset(Dataset):
    """
    General-purpose segmentation dataset.
    """

    def __init__(
        self,
        data_dir,
        ann_dir,
        split: str = "train",
        require_masks: bool = True,
        image_glob: str = "*.tif",
        mask_glob: str = "*.tif",
    ):
        self.data_dir = Path(data_dir)
        self.ann_dir = Path(ann_dir)
        self.split = split
        self.require_masks = require_masks

        self.img_dir = self.data_dir
        self.mask_dir = self.ann_dir

        img_paths = sorted(self.img_dir.glob(image_glob))
        if not img_paths:
            raise RuntimeError(f"No images found in {self.img_dir} (glob={image_glob})")

        mask_paths = sorted(self.mask_dir.glob(mask_glob))
        if not mask_paths and require_masks:
            raise RuntimeError(f"No masks found in {self.mask_dir} (glob={mask_glob})")

        img_by_idx: Dict[int, Path] = {}
        for p in img_paths:
            idx = _extract_index(p.stem)
            if idx is None:
                continue
            img_by_idx[idx] = p

        mask_by_idx: Dict[int, Path] = {}
        for p in mask_paths:
            idx = _extract_index(p.stem)
            if idx is None:
                continue
            mask_by_idx[idx] = p

        if not img_by_idx:
            raise RuntimeError("No images with numeric indices found.")

        self.pairs: List[Tuple[int, Path, Optional[Path]]] = []
        for idx in sorted(img_by_idx.keys()):
            img_p = img_by_idx[idx]
            m_p = mask_by_idx.get(idx, None)
            if self.require_masks and m_p is None:
                raise RuntimeError(f"Missing mask for image idx={idx}")
            self.pairs.append((idx, img_p, m_p))

        if not self.pairs:
            raise RuntimeError("No (image, mask) pairs could be formed.")

    def __len__(self):
        return len(self.pairs)

    def __getitem__(self, i):
        idx, img_path, mask_path = self.pairs[i]
        img = _read_tif_any(img_path)
        img = _as_rgb(img)
        mask = None
        if mask_path is not None:
            m = _read_tif_any(mask_path)
            if m.ndim == 3:
                m = m[..., 0]
            mask = m.astype(np.uint16)
        meta = {"index": idx, "image_id": img_path.stem, "image_path": str(img_path)}
        return img, mask, meta

    def generate_yolo_dataset(
        self,
        yolo_dir: str | Path,
        *,
        class_id: int = 0,
        class_name: str = "cell",
        write_empty_labels: bool = True,
    ) -> str:
        yolo_dir = Path(yolo_dir)
        split = self.split
        print(f"Building YOLO-seg dataset at {yolo_dir} (split={split})...")
        yolo_image_dir = yolo_dir / "images" / split
        yolo_label_dir = yolo_dir / "labels" / split
        yolo_image_dir.mkdir(parents=True, exist_ok=True)
        yolo_label_dir.mkdir(parents=True, exist_ok=True)

        num_written = 0
        for idx, img_path, mask_path in self.pairs:
            img = _read_tif_any(img_path)
            img = _as_rgb(img)

            if img.dtype != np.uint8:
                if img.max() > 255:
                    img = (img / 257).astype(np.uint8)
                else:
                    img = img.astype(np.uint8)

            out_img_name = f"{img_path.stem}.png"
            out_img_path = yolo_image_dir / out_img_name
            if not out_img_path.exists():
                cv2.imwrite(str(out_img_path), cv2.cvtColor(img, cv2.COLOR_RGB2BGR))

            label_path = yolo_label_dir / f"{img_path.stem}.txt"
            if mask_path is not None and Path(mask_path).exists():
                mask_to_yolo_and_iou(
                    mask_path=mask_path, txt_path=label_path, class_id=class_id
                )
            elif write_empty_labels:
                label_path.touch()
            num_written += 1

        data_yaml_path = yolo_dir / "data.yaml"
        yaml_config = {
            "path": str(yolo_dir.resolve()),
            "train": "images/train",
            "val": "images/val",
            "names": {class_id: class_name},
        }

        if data_yaml_path.exists():
            try:
                with open(data_yaml_path, "r") as f:
                    existing = yaml.safe_load(f) or {}
            except Exception:
                existing = {}
            existing.update(yaml_config)
            yaml_config = existing

        with open(data_yaml_path, "w") as f:
            yaml.safe_dump(yaml_config, f, sort_keys=False)

        print(f"Done. Wrote {num_written} samples to split={split}.")
        return str(data_yaml_path)


# --- Main Segmentation Function ---


def cell_segmentation(
    train_dataset: CellSegDataset, val_dataset: CellSegDataset
) -> List[np.ndarray]:
    """
    Performs instance segmentation on a validation dataset of cell images.
    """

    # 1. Setup workspace
    WORK_DIR = Path("./work")
    YOLO_DATA_DIR = WORK_DIR / "yolo_dataset"
    MODEL_OUTPUT_DIR = WORK_DIR / "runs"

    if YOLO_DATA_DIR.exists():
        shutil.rmtree(YOLO_DATA_DIR)
    if MODEL_OUTPUT_DIR.exists():
        shutil.rmtree(MODEL_OUTPUT_DIR)
    YOLO_DATA_DIR.mkdir(parents=True, exist_ok=True)

    # 2. Generate YOLO-compatible datasets
    print("Generating YOLO dataset for training...")
    data_yaml_path = train_dataset.generate_yolo_dataset(YOLO_DATA_DIR)
    print("Generating YOLO dataset for validation...")
    val_dataset.generate_yolo_dataset(YOLO_DATA_DIR)

    # 3. Train the YOLOv8 model
    model = YOLO("yolov8m-seg.pt")

    IMG_SIZE = 704
    EPOCHS = 75
    BATCH_SIZE = 8

    print("Starting YOLOv8 segmentation model training...")
    model.train(
        data=data_yaml_path,
        epochs=EPOCHS,
        imgsz=IMG_SIZE,
        batch=BATCH_SIZE,
        project=str(MODEL_OUTPUT_DIR),
        name="cell_seg_exp",
        exist_ok=True,
        patience=20,
        val=True,
    )
    print("Training finished.")

    # 4. Load the best model and perform inference
    best_model_path = MODEL_OUTPUT_DIR / "cell_seg_exp/weights/best.pt"
    if not best_model_path.exists():
        raise FileNotFoundError(f"Best model weights not found at {best_model_path}")
    print(f"Loading best model from: {best_model_path}")
    model = YOLO(best_model_path)

    # 5. Predict on the validation dataset
    print("Performing inference on the validation set...")
    val_image_paths = [str(p[1]) for p in val_dataset.pairs]

    results_list = list(
        model.predict(
            source=val_image_paths,
            imgsz=IMG_SIZE,
            conf=0.25,
            iou=0.7,
            stream=True,
            verbose=False,
        )
    )
    print(f"Inference complete. Processing {len(results_list)} results.")

    # Reorder results to match val_dataset order
    result_map = {Path(r.path).stem: r for r in results_list}

    seg_mask_list = []
    for _, img_path, _ in val_dataset.pairs:
        img_stem = img_path.stem

        if img_stem not in result_map:
            print(
                f"Warning: No result found for image {img_stem}. Creating empty mask."
            )
            img, _, _ = val_dataset[val_image_paths.index(str(img_path))]
            h, w, _ = img.shape
            seg_mask_list.append(np.zeros((h, w), dtype=np.uint16))
            continue

        result = result_map[img_stem]
        orig_h, orig_w = result.orig_shape
        final_mask = np.zeros((orig_h, orig_w), dtype=np.uint16)

        if result.masks is None or result.boxes is None:
            seg_mask_list.append(final_mask)
            continue

        masks = result.masks.data.cpu().numpy()
        confs = result.boxes.conf.cpu().numpy()
        indices = np.argsort(confs)[::-1]

        instance_id = 1
        for i in indices:
            mask = masks[i]
            # Create a boolean mask for the current instance
            instance_bool_mask = mask > 0.5
            # Only assign instance ID to background pixels
            valid_pixels = instance_bool_mask & (final_mask == 0)
            final_mask[valid_pixels] = instance_id

            if np.any(valid_pixels):
                instance_id += 1

        seg_mask_list.append(final_mask)

    print("Post-processing complete.")
    return seg_mask_list
