'import numpy as np
import torch
import cv2
from ultralytics import YOLO
from pathlib import Path
import os
import shutil
from typing import List, Tuple, Optional, Dict

# The problem description implies that the following classes and helper functions
# are available in the execution environment. They are included here for completeness
# and to ensure the script is self-contained.


def _extract_index(fname: str) -> Optional[int]:
    """Tries to extract a trailing integer index from a filename."""
    import re

    m = re.search(r"(\d+)", fname)
    return int(m.group(1)) if m else None


def _read_tif_any(p: Path):
    """Read a TIF file, handling various bit depths and channel configurations."""
    if not p.exists():
        raise FileNotFoundError(f"TIF file not found: {p}")
    try:
        img = cv2.imread(str(p), cv2.IMREAD_UNCHANGED)
        if img is None:
            raise IOError(f"OpenCV could not read {p}")
        return img
    except Exception as e:
        raise IOError(f"Could not read file {p} with OpenCV") from e


def _as_rgb(img: np.ndarray) -> np.ndarray:
    """Converts a grayscale or other format image to 3-channel RGB uint8."""
    if img.ndim == 2:
        img = cv2.cvtColor(img, cv2.COLOR_GRAY2RGB)
    elif img.ndim == 3 and img.shape[2] == 1:
        img = cv2.cvtColor(img, cv2.COLOR_GRAY2RGB)
    elif img.ndim == 3 and img.shape[2] > 3:
        img = img[..., :3]

    if img.dtype != np.uint8:
        if img.dtype == np.uint16:
            img = (img / 256).astype(np.uint8)
        else:
            min_val, max_val = img.min(), img.max()
            if max_val > min_val:
                img = ((img - min_val) / (max_val - min_val) * 255.0).astype(np.uint8)
            else:
                img = np.zeros_like(img, dtype=np.uint8)

    if img.shape[2] != 3:
        # Fallback for unexpected channel counts
        img = cv2.cvtColor(img, cv2.COLOR_GRAY2RGB) if img.ndim == 2 else img[:, :, :3]

    return img


def mask_to_yolo_and_iou(mask_path, txt_path, class_id=0):
    """Converts instance mask to YOLO segmentation format and calculates IOU/Dice."""
    import yaml

    mask = _read_tif_any(Path(mask_path))
    if mask.ndim == 3:
        mask = mask[..., 0]

    H, W = mask.shape
    lines = []
    instance_ids = sorted(np.unique(mask))
    instance_ids = [i for i in instance_ids if i > 0]

    for inst_id in instance_ids:
        binary_mask = (mask == inst_id).astype(np.uint8)
        contours, _ = cv2.findContours(
            binary_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE
        )

        if not contours:
            continue

        contour = max(contours, key=cv2.contourArea)
        if cv2.contourArea(contour) < 3:  # Skip tiny instances
            continue

        poly = contour.squeeze()
        if len(poly) < 3:
            continue

        poly_normalized = poly / np.array([W, H])
        line = f"{class_id} " + " ".join(map(str, poly_normalized.flatten()))
        lines.append(line)

    with open(txt_path, "w") as f:
        f.write("\n".join(lines))

    return 0.0, 0.0  # Placeholder for IoU/Dice, not calculated here


class CellSegDataset:
    def __init__(
        self,
        data_dir,
        ann_dir,
        split: str = "train",
        require_masks: bool = True,
        image_glob: str = "*.tif",
        mask_glob: str = "*.tif",
    ):
        self.data_dir = Path(data_dir)
        self.ann_dir = Path(ann_dir)
        self.split = split
        self.require_masks = require_masks
        self.img_dir, self.mask_dir = self.data_dir, self.ann_dir
        img_paths = sorted(self.img_dir.glob(image_glob))
        mask_paths = (
            sorted(self.mask_dir.glob(mask_glob)) if self.ann_dir.exists() else []
        )

        img_by_idx: Dict[int, Path] = {
            idx: p for p in img_paths if (idx := _extract_index(p.stem)) is not None
        }
        mask_by_idx: Dict[int, Path] = {
            idx: p for p in mask_paths if (idx := _extract_index(p.stem)) is not None
        }

        if not img_by_idx:
            raise RuntimeError(f"No indexed images found in {self.img_dir}")
        self.pairs: List[Tuple[int, Path, Optional[Path]]] = []
        for idx in sorted(img_by_idx.keys()):
            img_p, m_p = img_by_idx[idx], mask_by_idx.get(idx)
            if self.require_masks and m_p is None:
                raise RuntimeError(f"Missing mask for image idx={idx}")
            self.pairs.append((idx, img_p, m_p))

    def __len__(self):
        return len(self.pairs)

    def __getitem__(self, i):
        idx, img_path, mask_path = self.pairs[i]
        img = _read_tif_any(img_path)
        img = _as_rgb(img)
        mask = None
        if mask_path is not None:
            m = _read_tif_any(mask_path)
            if m.ndim == 3:
                m = m[..., 0]
            mask = m.astype(np.uint16)
        meta = {
            "index": idx,
            "image_id": img_path.stem,
            "image_path": str(img_path),
            "mask_path": str(mask_path) if mask_path else None,
        }
        return img, mask, meta

    def generate_yolo_dataset(
        self, yolo_dir: str | Path, *, class_id: int = 0, class_name: str = "cell"
    ) -> str:
        import yaml

        yolo_dir = Path(yolo_dir)
        yolo_image_dir = yolo_dir / "images" / self.split
        yolo_label_dir = yolo_dir / "labels" / self.split
        yolo_image_dir.mkdir(parents=True, exist_ok=True)
        yolo_label_dir.mkdir(parents=True, exist_ok=True)

        for _, img_path, mask_path in self.pairs:
            img = _read_tif_any(img_path)
            img = _as_rgb(img)
            out_img_path = yolo_image_dir / f"{img_path.stem}.png"
            if not out_img_path.exists():
                cv2.imwrite(str(out_img_path), cv2.cvtColor(img, cv2.COLOR_RGB2BGR))

            label_path = yolo_label_dir / f"{img_path.stem}.txt"
            if mask_path and Path(mask_path).exists():
                mask_to_yolo_and_iou(
                    mask_path=mask_path, txt_path=label_path, class_id=class_id
                )
            else:
                label_path.touch()

        data_yaml_path = yolo_dir / "data.yaml"
        yaml_config = {
            "path": str(yolo_dir.resolve()),
            "train": "images/train",
            "val": "images/val",
            "names": {class_id: class_name},
        }
        if data_yaml_path.exists():
            try:
                with open(data_yaml_path, "r") as f:
                    existing = yaml.safe_load(f) or {}
                existing.update(yaml_config)
                yaml_config = existing
            except Exception:
                pass
        with open(data_yaml_path, "w") as f:
            yaml.safe_dump(yaml_config, f, sort_keys=False)
        return str(data_yaml_path)


def calculate_jaccard(gt_mask, pred_mask):
    """Calculates the Jaccard index for instance segmentation."""
    gt_ids = np.unique(gt_mask)[1:]
    pred_ids = np.unique(pred_mask)[1:]

    if len(gt_ids) == 0 and len(pred_ids) == 0:
        return 1.0
    if len(gt_ids) == 0 or len(pred_ids) == 0:
        return 0.0

    iou_matrix = np.zeros((len(gt_ids), len(pred_ids)), dtype=np.float32)
    for i, gt_id in enumerate(gt_ids):
        for j, pred_id in enumerate(pred_ids):
            gt_instance = gt_mask == gt_id
            pred_instance = pred_mask == pred_id
            intersection = np.logical_and(gt_instance, pred_instance).sum()
            union = np.logical_or(gt_instance, pred_instance).sum()
            iou_matrix[i, j] = intersection / union if union > 0 else 0

    # Greedy matching
    matches = []
    matched_pred_ids = set()
    for i in range(len(gt_ids)):
        best_iou_for_gt = -1.0
        best_pred_idx = -1
        for j in range(len(pred_ids)):
            if j not in matched_pred_ids:
                if iou_matrix[i, j] > best_iou_for_gt:
                    best_iou_for_gt = iou_matrix[i, j]
                    best_pred_idx = j

        if best_iou_for_gt > 0.5:  # IoU threshold for a match
            matches.append(best_iou_for_gt)
            if best_pred_idx != -1:
                matched_pred_ids.add(best_pred_idx)

    tp = len(matches)
    fp = len(pred_ids) - tp
    fn = len(gt_ids) - tp

    return tp / (tp + fp + fn) if (tp + fp + fn) > 0 else 0


def cell_segmentation(
    train_dataset: CellSegDataset, val_dataset: CellSegDataset
) -> List[np.ndarray]:
    """
    Performs instance segmentation on cell images using a YOLOv8 model.
    """
    # 1. Setup workspace
    WORK_DIR = Path("./yolo_cell_seg")
    if WORK_DIR.exists():
        shutil.rmtree(WORK_DIR)
    WORK_DIR.mkdir(parents=True, exist_ok=True)

    # 2. Generate YOLO datasets
    print("Generating YOLO format datasets...")
    data_yaml_path = train_dataset.generate_yolo_dataset(WORK_DIR)
    val_dataset.generate_yolo_dataset(WORK_DIR)
    print(f"YOLO dataset created. YAML at: {data_yaml_path}")

    # 3. Train the model
    model = YOLO("yolov8m-seg.pt")

    print("Starting YOLOv8 model training...")
    model.train(
        data=data_yaml_path,
        epochs=50,
        imgsz=1024,
        batch=4,  # Safe batch size for 11GB VRAM
        patience=15,
        project=str(WORK_DIR / "training_runs"),
        name="cell_seg_exp",
        device=0 if torch.cuda.is_available() else "cpu",
        exist_ok=True,
    )
    print("Model training finished.")

    # 4. Load the best model for inference
    best_model_path = WORK_DIR / "training_runs/cell_seg_exp/weights/best.pt"
    if not best_model_path.exists():
        raise FileNotFoundError(f"Best model not found at {best_model_path}")
    print(f"Loading best model from: {best_model_path}")
    best_model = YOLO(best_model_path)

    # 5. Perform inference and post-processing
    seg_mask_list = []
    print(f"Running inference on {len(val_dataset)} validation images...")
    for img, _, meta in val_dataset:
        H, W, _ = img.shape

        results = best_model.predict(
            source=img,
            imgsz=1024,
            conf=0.25,
            verbose=False,
        )

        result = results[0]
        final_mask = np.zeros((H, W), dtype=np.uint16)

        if result.masks is not None and result.boxes is not None:
            confs = result.boxes.conf
            sorted_indices = torch.argsort(confs, descending=True)
            masks_data = result.masks.data

            instance_id = 1
            for i in sorted_indices:
                mask_tensor = masks_data[i]
                mask_np = mask_tensor.cpu().numpy()
                resized_mask = cv2.resize(
                    mask_np, (W, H), interpolation=cv2.INTER_NEAREST
                )
                final_mask[resized_mask > 0.5] = instance_id
                instance_id += 1

        seg_mask_list.append(final_mask)
    print("Inference complete.")

    # 6. Evaluate and print metric
    print("Calculating validation metric...")
    gt_masks = [m for _, m, _ in val_dataset if m is not None]
    if len(gt_masks) == len(seg_mask_list):
        total_jaccard = 0
        for pred_m, gt_m in zip(seg_mask_list, gt_masks):
            total_jaccard += calculate_jaccard(gt_m, pred_m)
        avg_jaccard = total_jaccard / len(gt_masks) if len(gt_masks) > 0 else 0
        print(f"Validation Metric (Average Jaccard Index): {avg_jaccard}")
    else:
        print(
            "Could not compute validation metric: ground truth masks not available for all validation images."
        )

    return seg_mask_list
