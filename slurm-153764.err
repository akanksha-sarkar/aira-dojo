'import torch
import numpy as np
import cv2
from pathlib import Path
import yaml
from typing import Dict, List, Optional, Tuple
from torch.utils.data import Dataset
import shutil
from ultralytics import YOLO
import re
import os

# Set a specific cache directory for ultralytics to avoid potential permission issues
# in the environment.
os.environ["YOLO_CACHE"] = str(Path("./work/yolo_cache"))


def _extract_index(stem: str) -> Optional[int]:
    """Tries to extract a trailing integer index from a filename stem."""
    m = re.search(r"(\d+)$", stem)
    if m:
        return int(m.group(1))
    return None


def _read_tif_any(p: Path) -> np.ndarray:
    """Reads a TIF file, handling various bit depths and channel configurations."""
    img = cv2.imread(str(p), cv2.IMREAD_ANYDEPTH | cv2.IMREAD_ANYCOLOR)
    if img is None:
        raise IOError(f"Failed to read image: {p}")
    if img.ndim == 3 and img.shape[2] == 3:
        img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
    return img


def _as_rgb(img: np.ndarray) -> np.ndarray:
    """Converts a grayscale image to RGB, normalizing if necessary."""
    if img.ndim == 2:
        img = np.stack([img] * 3, axis=-1)
    if img.dtype == np.uint16:
        # Heuristic for 16-bit -> 8-bit conversion for display/compatibility
        p_low, p_high = np.percentile(img, (1, 99))
        if p_high > p_low:
            img = np.clip((img.astype(np.float32) - p_low) / (p_high - p_low), 0, 1)
            img = (img * 255).astype(np.uint8)
        else:  # Handle blank or flat images
            img = np.zeros_like(img, dtype=np.uint8)
    elif img.dtype != np.uint8:
        img = np.clip(img, 0, 255).astype(np.uint8)
    return img


def mask_to_yolo_polygons(mask_path: Path, txt_path: Path, class_id: int = 0):
    """Converts an instance mask to YOLO segmentation polygon format."""
    mask = _read_tif_any(mask_path)
    if mask.ndim == 3:
        mask = mask[..., 0]
    H, W = mask.shape
    instance_ids = sorted([i for i in np.unique(mask) if i != 0])

    lines = []
    for i in instance_ids:
        instance_mask = (mask == i).astype(np.uint8)
        contours, _ = cv2.findContours(
            instance_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE
        )
        if not contours:
            continue

        for contour in contours:
            if contour.shape[0] < 3:  # A polygon needs at least 3 points
                continue

            poly = contour.squeeze(1)

            # Normalize coordinates
            poly_normalized = poly.astype(np.float32)
            poly_normalized[:, 0] /= W
            poly_normalized[:, 1] /= H

            line = f"{class_id} " + " ".join(
                [f"{p[0]:.6f} {p[1]:.6f}" for p in poly_normalized]
            )
            lines.append(line)

    if lines:
        with open(txt_path, "w") as f:
            f.write("\n".join(lines))
    else:
        # Create an empty file if no instances are found
        txt_path.touch()


class CellSegDataset(Dataset):
    """
    General-purpose segmentation dataset that pairs images and masks by numeric index.
    This version is adapted to work within the main script.
    """

    def __init__(
        self,
        data_dir,
        ann_dir,
        split: str = "train",
        require_masks: bool = True,
        image_glob: str = "*.tif",
        mask_glob: str = "*.tif",
    ):
        self.data_dir = Path(data_dir)
        self.ann_dir = Path(ann_dir)
        self.split = split
        self.require_masks = require_masks

        self.img_dir = self.data_dir
        self.mask_dir = self.ann_dir

        img_paths = sorted(self.img_dir.glob(image_glob))
        if not img_paths:
            raise RuntimeError(f"No images found in {self.img_dir} (glob={image_glob})")

        mask_paths = sorted(self.mask_dir.glob(mask_glob))
        if not mask_paths and require_masks:
            raise RuntimeError(f"No masks found in {self.mask_dir} (glob={mask_glob})")

        img_by_idx: Dict[int, Path] = {}
        for p in img_paths:
            idx = _extract_index(p.stem)
            if idx is None:
                continue
            img_by_idx[idx] = p

        mask_by_idx: Dict[int, Path] = {}
        for p in mask_paths:
            idx = _extract_index(p.stem)
            if idx is None:
                continue
            mask_by_idx[idx] = p

        if not img_by_idx:
            raise RuntimeError(
                f"Found images in {self.img_dir} but none matched an index pattern (e.g., ...0000.tif)."
            )

        self.pairs: List[Tuple[int, Path, Optional[Path]]] = []
        for idx in sorted(img_by_idx.keys()):
            img_p = img_by_idx[idx]
            m_p = mask_by_idx.get(idx, None)
            if self.require_masks and m_p is None:
                raise RuntimeError(
                    f"Missing mask for image idx={idx}: image={img_p.name}."
                )
            self.pairs.append((idx, img_p, m_p))

        if not self.pairs:
            raise RuntimeError("No (image, mask) pairs could be formed.")

    def __len__(self):
        return len(self.pairs)

    def __getitem__(self, i):
        idx, img_path, mask_path = self.pairs[i]
        img = _read_tif_any(img_path)
        img = _as_rgb(img)
        mask = None
        if mask_path is not None:
            m = _read_tif_any(mask_path)
            if m.ndim == 3:
                m = m[..., 0]
            mask = m.astype(np.uint16)
        meta = {
            "index": idx,
            "image_id": img_path.stem,
            "image_path": str(img_path),
            "mask_path": str(mask_path) if mask_path else None,
        }
        return img, mask, meta

    def generate_yolo_dataset(
        self,
        yolo_dir: Path,
        *,
        class_id: int = 0,
        class_name: str = "cell",
        write_empty_labels: bool = True,
    ) -> str:
        split = self.split
        print(f"Building YOLO-seg dataset at {yolo_dir} (split={split})...")
        yolo_image_dir = yolo_dir / "images" / split
        yolo_label_dir = yolo_dir / "labels" / split
        yolo_image_dir.mkdir(parents=True, exist_ok=True)
        yolo_label_dir.mkdir(parents=True, exist_ok=True)
        num_written = 0
        for _, img_path, mask_path in self.pairs:
            img = _read_tif_any(img_path)
            img_rgb = _as_rgb(img)

            out_img_name = f"{img_path.stem}.png"
            out_img_path = yolo_image_dir / out_img_name
            if not out_img_path.exists():
                cv2.imwrite(str(out_img_path), cv2.cvtColor(img_rgb, cv2.COLOR_RGB2BGR))

            label_path = yolo_label_dir / f"{img_path.stem}.txt"
            if mask_path and mask_path.exists():
                mask_to_yolo_polygons(
                    mask_path=mask_path, txt_path=label_path, class_id=class_id
                )
            elif write_empty_labels:
                label_path.touch()
            else:
                continue
            num_written += 1

        data_yaml_path = yolo_dir / "data.yaml"
        yaml_config = {
            "path": str(yolo_dir.resolve()),
            "train": "images/train",
            "val": "images/val",
            "names": {class_id: class_name},
        }
        if data_yaml_path.exists():
            with open(data_yaml_path, "r") as f:
                existing = yaml.safe_load(f) or {}
            existing.update(yaml_config)
            yaml_config = existing
        with open(data_yaml_path, "w") as f:
            yaml.safe_dump(yaml_config, f, sort_keys=False)
        print(f"Done. Wrote {num_written} samples to split={split}.")
        return str(data_yaml_path)


def cell_segmentation(
    train_dataset: CellSegDataset, val_dataset: CellSegDataset
) -> List[np.ndarray]:
    """
    Performs instance segmentation on a validation dataset of cell images using YOLOv8.
    """
    # 1. Setup workspace
    WORK_DIR = Path("./work")
    YOLO_DATA_DIR = WORK_DIR / "yolo_cell_dataset"
    if YOLO_DATA_DIR.exists():
        shutil.rmtree(YOLO_DATA_DIR)
    YOLO_DATA_DIR.mkdir(parents=True)

    # 2. Prepare data for YOLO training
    train_dataset.split = "train"
    val_dataset.split = "val"
    data_yaml_path = train_dataset.generate_yolo_dataset(YOLO_DATA_DIR)
    val_dataset.generate_yolo_dataset(YOLO_DATA_DIR)

    # 3. Train the YOLOv8 model
    model = YOLO("yolov8m-seg.pt")

    # Training hyperparameters
    EPOCHS = 60
    PATIENCE = 15
    IMG_SIZE = 1024
    BATCH_SIZE = 8

    print("Starting YOLOv8 model training...")
    results = model.train(
        data=data_yaml_path,
        epochs=EPOCHS,
        patience=PATIENCE,
        imgsz=IMG_SIZE,
        batch=BATCH_SIZE,
        project=str(WORK_DIR / "yolo_training"),
        name="cell_seg_run",
        exist_ok=True,
        val=True,
        device=0,
    )
    print("YOLOv8 model training finished.")

    # 4. Load the best model and perform inference
    best_model_path = results.save_dir / "weights" / "best.pt"
    print(f"Loading best model from: {best_model_path}")
    best_model = YOLO(best_model_path)

    # 5. Predict on the validation set and create instance masks
    seg_mask_list = []

    val_images = []
    original_shapes = []
    for img, _, _ in val_dataset:
        val_images.append(img)
        original_shapes.append(img.shape[:2])  # (H, W)

    print("Starting prediction on validation set...")
    predictions = best_model.predict(
        source=val_images,
        imgsz=IMG_SIZE,
        conf=0.25,  # Confidence threshold
        iou=0.7,  # Non-maximum suppression IoU threshold
        verbose=False,
        device=0,
    )
    print("Prediction finished.")

    # 6. Post-process predictions into the required format
    print("Post-processing predictions...")
    for i, pred in enumerate(predictions):
        original_h, original_w = original_shapes[i]
        final_mask = np.zeros((original_h, original_w), dtype=np.uint16)

        if pred.masks is None:
            seg_mask_list.append(final_mask)
            continue

        masks = pred.masks.data.cpu().numpy()
        confs = pred.boxes.conf.cpu().numpy()

        # Sort instances by confidence score (descending) to handle overlaps
        sorted_indices = np.argsort(confs)[::-1]

        instance_id = 1
        for idx in sorted_indices:
            mask_pred = masks[idx]

            # Resize mask to original image size
            mask_resized = cv2.resize(
                mask_pred, (original_w, original_h), interpolation=cv2.INTER_NEAREST
            )

            # Add the instance to the final mask.
            # Where the resized mask is > 0.5, set the pixel value to the current instance_id.
            # This overwrites any lower-confidence predictions in the same area.
            final_mask[mask_resized > 0.5] = instance_id
            instance_id += 1

        seg_mask_list.append(final_mask)

    print("Post-processing complete. Returning final masks.")
    return seg_mask_list
