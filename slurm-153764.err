'import numpy as np
import torch
import cv2
import yaml
from pathlib import Path
from ultralytics import YOLO
from torch.utils.data import Dataset
import tifffile
import re
from typing import Dict, List, Optional, Tuple

# NOTE: The CellSegDataset class and its helpers are assumed to be provided by the
# execution environment, as per the problem description. They are included here
# for completeness and to make the script self-contained and runnable.


# Helper functions from the problem description
def _extract_index(filename_stem: str) -> Optional[int]:
    """Tries to extract a trailing integer index from a filename."""
    match = re.search(r"(\d+)$", filename_stem)
    if match:
        return int(match.group(1))
    return None


def _read_tif_any(path: Path | str) -> np.ndarray:
    """Read a TIF file, handling different channel configurations."""
    img = tifffile.imread(path)
    return img


def _as_rgb(img: np.ndarray) -> np.ndarray:
    """Ensure an image is in HWC RGB format."""
    if img.ndim == 2:
        return np.stack([img] * 3, axis=-1)
    if img.shape[-1] == 1:
        return np.concatenate([img] * 3, axis=-1)
    if img.shape[-1] > 3:
        return img[..., :3]
    return img


def mask_to_yolo_and_iou(mask_path, txt_path, class_id=0):
    mask = tifffile.imread(mask_path)
    instance_ids = np.unique(mask)
    instance_ids = instance_ids[instance_ids != 0]

    H, W = mask.shape
    lines = []
    total_iou = 0
    total_dice = 0
    count = 0

    for i in instance_ids:
        instance_mask = mask == i
        contours, _ = cv2.findContours(
            instance_mask.astype(np.uint8), cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE
        )

        if not contours:
            continue

        # Use the largest contour if multiple are found for one instance ID
        contour = max(contours, key=cv2.contourArea)

        if contour.size < 6:  # Need at least 3 points for a polygon
            continue

        poly = contour.squeeze()

        # Normalize coordinates
        poly_normalized = poly.astype(np.float32)
        poly_normalized[:, 0] /= W
        poly_normalized[:, 1] /= H

        line = f"{class_id} " + " ".join(
            [f"{p[0]:.6f} {p[1]:.6f}" for p in poly_normalized]
        )
        lines.append(line)
        count += 1

    with open(txt_path, "w") as f:
        f.write("\n".join(lines))

    return total_iou, total_dice


class CellSegDataset(Dataset):
    """
    General-purpose segmentation dataset that pairs images and masks by numeric index.

    Returns:
        image: H x W x 3 (RGB)
        mask:  H x W (uint16 instance IDs) OR None if require_masks=False and missing
        meta:  dict with filename info
    """

    def __init__(
        self,
        data_dir,
        ann_dir,
        split: str = "train",
        require_masks: bool = True,
        image_glob: str = "*.tif",
        mask_glob: str = "*.tif",
    ):
        self.data_dir = Path(data_dir)
        self.ann_dir = Path(ann_dir)
        self.split = split
        self.require_masks = require_masks

        self.img_dir = self.data_dir
        self.mask_dir = self.ann_dir

        img_paths = sorted(self.img_dir.glob(image_glob))
        if not img_paths:
            raise RuntimeError(f"No images found in {self.img_dir} (glob={image_glob})")

        mask_paths = sorted(self.mask_dir.glob(mask_glob))
        if not mask_paths and require_masks:
            raise RuntimeError(f"No masks found in {self.mask_dir} (glob={mask_glob})")

        img_by_idx: Dict[int, Path] = {}
        for p in img_paths:
            idx = _extract_index(p.stem)
            if idx is None:
                continue
            img_by_idx[idx] = p

        mask_by_idx: Dict[int, Path] = {}
        for p in mask_paths:
            idx = _extract_index(p.stem)
            if idx is None:
                continue
            mask_by_idx[idx] = p

        if not img_by_idx:
            raise RuntimeError(
                f"Found images in {self.img_dir} but none matched an index pattern (e.g., ...0000.tif)."
            )

        self.pairs: List[Tuple[int, Path, Optional[Path]]] = []
        for idx in sorted(img_by_idx.keys()):
            img_p = img_by_idx[idx]
            m_p = mask_by_idx.get(idx, None)

            if self.require_masks and m_p is None:
                raise RuntimeError(
                    f"Missing mask for image idx={idx}: image={img_p.name}. "
                    f"Expected a mask with the same trailing index in {self.mask_dir} "
                    f"(e.g., man_seg{idx:04d}.tif or mask{idx:04d}.tif)."
                )

            self.pairs.append((idx, img_p, m_p))

        if not self.pairs:
            raise RuntimeError("No (image, mask) pairs could be formed.")

    def __len__(self):
        return len(self.pairs)

    def __getitem__(self, i):
        idx, img_path, mask_path = self.pairs[i]
        img = _read_tif_any(img_path)
        img = _as_rgb(img)

        mask = None
        if mask_path is not None:
            m = _read_tif_any(mask_path)
            if m.ndim == 3:
                m = m[..., 0]
            mask = m.astype(np.uint16)

        meta = {
            "index": idx,
            "image_id": img_path.stem,
            "image_path": str(img_path),
            "mask_path": str(mask_path) if mask_path is not None else None,
        }
        return img, mask, meta

    def generate_yolo_dataset(
        self,
        yolo_dir: str | Path,
        *,
        class_id: int = 0,
        class_name: str = "cell",
        write_empty_labels: bool = True,
    ) -> str:
        yolo_dir = Path(yolo_dir)
        split = self.split
        print(f"Building YOLO-seg dataset at {yolo_dir} (split={split})...")

        yolo_image_dir = yolo_dir / "images" / split
        yolo_label_dir = yolo_dir / "labels" / split
        yolo_image_dir.mkdir(parents=True, exist_ok=True)
        yolo_label_dir.mkdir(parents=True, exist_ok=True)

        num_written = 0
        for idx, img_path, mask_path in self.pairs:
            assert img_path.exists(), f"Missing image: {img_path}"

            img = _read_tif_any(img_path)
            img = _as_rgb(img)
            if img.dtype != np.uint8:
                img = np.clip(img, 0, 255).astype(np.uint8)

            out_img_name = f"{img_path.stem}.png"
            out_img_path = yolo_image_dir / out_img_name
            if not out_img_path.exists():
                cv2.imwrite(str(out_img_path), cv2.cvtColor(img, cv2.COLOR_RGB2BGR))

            label_path = yolo_label_dir / f"{img_path.stem}.txt"
            if mask_path is not None and Path(mask_path).exists():
                mask_to_yolo_and_iou(
                    mask_path=mask_path, txt_path=label_path, class_id=class_id
                )
            elif write_empty_labels:
                label_path.touch()
            else:
                continue
            num_written += 1

        data_yaml_path = yolo_dir / "data.yaml"
        yaml_config = {
            "path": str(yolo_dir.resolve()),
            "train": f"images/{self.split if self.split == 'train' else '../train'}",
            "val": f"images/{self.split if self.split == 'val' else '../val'}",
            "names": {class_id: class_name},
        }

        existing = {}
        if data_yaml_path.exists():
            try:
                with open(data_yaml_path, "r") as f:
                    existing = yaml.safe_load(f) or {}
            except Exception:
                pass

        # This logic ensures both train and val paths are correctly set
        if "train" in existing and self.split == "val":
            yaml_config["train"] = existing["train"]
        if "val" in existing and self.split == "train":
            yaml_config["val"] = existing["val"]

        existing.update(yaml_config)

        with open(data_yaml_path, "w") as f:
            yaml.safe_dump(existing, f, sort_keys=False)

        print(f"Done. Wrote {num_written} samples to split={split}.")
        return str(data_yaml_path)


def cell_segmentation(
    train_dataset: CellSegDataset, val_dataset: CellSegDataset
) -> list[np.ndarray]:
    """
    Performs instance segmentation on a validation dataset of cell images.

    Args:
        train_dataset: A CellSegDataset containing training images and instance masks.
        val_dataset: A CellSegDataset containing validation images.

    Returns:
        A list of uint16 instance-id masks, one per image in val_dataset.
    """

    # 1. Setup paths for YOLO dataset and training outputs
    yolo_dir = Path("./yolo_cell_data")
    yolo_dir.mkdir(exist_ok=True)

    # 2. Generate YOLO-compatible datasets for training and validation
    data_yaml_path = train_dataset.generate_yolo_dataset(
        yolo_dir=yolo_dir, split="train"
    )
    val_dataset.generate_yolo_dataset(yolo_dir=yolo_dir, split="val")

    # 3. Initialize and train the YOLOv8 model
    # Using yolov8s-seg for a good balance of speed and accuracy
    model = YOLO("yolov8s-seg.pt")

    # Training parameters
    epochs = 50
    imgsz = 1024
    batch_size = 8

    print("--- Starting YOLOv8s-seg training ---")
    model.train(
        data=data_yaml_path,
        epochs=epochs,
        imgsz=imgsz,
        batch=batch_size,
        project="yolo_cell_training",
        name="cell_seg_exp_s50",
        exist_ok=True,  # Overwrite previous training runs
        device=0,
    )
    print("--- Training finished ---")

    # 4. Load the best performing model from training
    best_model_path = Path("yolo_cell_training/cell_seg_exp_s50/weights/best.pt")
    if not best_model_path.exists():
        raise FileNotFoundError(f"Could not find best model at {best_model_path}")

    print(f"Loading best model from: {best_model_path}")
    best_model = YOLO(best_model_path)

    # 5. Perform inference on the validation set
    seg_mask_list = []

    print(f"--- Starting inference on {len(val_dataset)} validation images ---")
    for i in range(len(val_dataset)):
        img, _, meta = val_dataset[i]
        H, W, _ = img.shape

        # Predict using the trained model
        results = best_model.predict(
            img,
            verbose=False,
            imgsz=imgsz,
            conf=0.25,  # Confidence threshold for detections
        )

        # Initialize an empty mask for the current image
        final_mask = np.zeros((H, W), dtype=np.uint16)

        # Check if any instances were detected
        if results[0].masks is not None and results[0].boxes is not None:
            # Sort detected instances by confidence score in descending order
            confidences = results[0].boxes.conf
            sorted_indices = torch.argsort(confidences, descending=True)

            masks = results[0].masks.data[sorted_indices]

            instance_id = 1
            for mask_tensor in masks:
                # Convert tensor to numpy array and resize to original image dimensions
                mask_np = mask_tensor.cpu().numpy()
                mask_resized = cv2.resize(
                    mask_np, (W, H), interpolation=cv2.INTER_NEAREST
                )

                # Create a binary mask from the resized mask
                binary_mask = mask_resized > 0.5

                # Assign the current instance ID to pixels in the final mask
                # that are part of the current binary mask AND have not been assigned an ID yet.
                # This ensures that in case of overlaps, the higher-confidence mask wins.
                final_mask[(binary_mask) & (final_mask == 0)] = instance_id

                # Only increment the instance ID if the current mask was not fully
                # occluded by higher-confidence masks.
                if np.any(final_mask == instance_id):
                    instance_id += 1

        seg_mask_list.append(final_mask)

        if (i + 1) % 10 == 0 or (i + 1) == len(val_dataset):
            print(f"Processed {i+1}/{len(val_dataset)} images.")

    print("--- Inference complete ---")
    return seg_mask_list
