n        return int(match.group(1))\n    return None\n\ndef _read_tif_any(p: Path) -> np.ndarray:\n    """Reads a TIF, making sure to handle different bit depths and channels."""\n    img = cv2.imread(str(p), -1)\n    if img is None:\n        raise IOError(f"Failed to read image: {p}")\n    return img\n\ndef _as_rgb(arr: np.ndarray) -> np.ndarray:\n    """Converts a grayscale or single-channel array to a 3-channel RGB array."""\n    if arr.ndim == 2:\n        return cv2.cvtColor(arr, cv2.COLOR_GRAY2RGB)\n    if arr.ndim == 3 and arr.shape[2] == 1:\n        return cv2.cvtColor(arr, cv2.COLOR_GRAY2RGB)\n    if arr.ndim == 3 and arr.shape[2] == 4:\n        return cv2.cvtColor(arr, cv2.COLOR_RGBA2RGB)\n    if arr.ndim == 3 and arr.shape[2] == 3:\n        return arr\n    raise ValueError(f"Unsupported array shape for RGB conversion: {arr.shape}")\n\ndef mask_to_yolo_and_iou(mask_path: Path, txt_path: Path, class_id: int = 0):\n    """Converts an instance mask to YOLOv8 segmentation format."""\n    mask = _read_tif_any(mask_path)\n    if mask.ndim == 3:\n        mask = mask[..., 0]\n    \n    h, w = mask.shape\n    lines = []\n    instance_ids = np.unique(mask)\n    instance_ids = instance_ids[instance_ids != 0]\n\n    for instance_id in instance_ids:\n        instance_mask = (mask == instance_id).astype(np.uint8)\n        contours, _ = cv2.findContours(instance_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n        \n        segment = []\n        for contour in contours:\n            if contour.shape[0] < 3: continue\n            contour = contour.squeeze(1)\n            normalized_contour = contour.astype(np.float32)\n            normalized_contour[:, 0] /= w\n            normalized_contour[:, 1] /= h\n            segment.extend(normalized_contour.flatten().tolist())\n\n        if segment:\n            line = f"{class_id} " + " ".join(f"{coord:.6f}" for coord in segment)\n            lines.append(line)\n\n    with open(txt_path, \'w\') as f:\n        f.write("\\n".join(lines))\n\n# Provided CellSegDataset class, modified slightly for robustness.\nclass CellSegDataset(Dataset):\n    def __init__(\n        self,\n        data_dir,\n        ann_dir,\n        split: str = "train",\n        require_masks: bool = True,\n        image_glob: str = "*.tif",\n        mask_glob: str = "*.tif",\n    ):\n        self.data_dir = Path(data_dir)\n        self.ann_dir = Path(ann_dir)\n        self.split = split\n        self.require_masks = require_masks\n        self.img_dir = self.data_dir\n        self.mask_dir = self.ann_dir\n\n        img_paths = sorted(self.img_dir.glob(image_glob))\n        if not img_paths: raise RuntimeError(f"No images found in {self.img_dir}")\n        mask_paths = sorted(self.mask_dir.glob(mask_glob))\n        if not mask_paths and require_masks: raise RuntimeError(f"No masks found in {self.mask_dir}")\n\n        img_by_idx: Dict[int, Path] = {idx: p for p in img_paths if (idx := _extract_index(p.stem)) is not None}\n        mask_by_idx: Dict[int, Path] = {idx: p for p in mask_paths if (idx := _extract_index(p.stem)) is not None}\n        if not img_by_idx: raise RuntimeError(f"No images with valid indices found in {self.img_dir}")\n\n        self.pairs: List[Tuple[int, Path, Optional[Path]]] = []\n        for idx in sorted(img_by_idx.keys()):\n            img_p = img_by_idx[idx]\n            m_p = mask_by_idx.get(idx)\n            if self.require_masks and m_p is None:\n                raise RuntimeError(f"Missing mask for image idx={idx}")\n            self.pairs.append((idx, img_p, m_p))\n\n        if not self.pairs: raise RuntimeError("No (image, mask) pairs could be formed.")\n\n    def __len__(self):\n        return len(self.pairs)\n\n    def __getitem__(self, i):\n        idx, img_path, mask_path = self.pairs[i]\n        img = _read_tif_any(img_path)\n\n        if img.dtype != np.uint8:\n            if img.max() > 255:\n                img = np.clip(img / 256, 0, 255).astype(np.uint8)\n            else:\n                img = img.astype(np.uint8)\n        img = _as_rgb(img)\n\n        mask = None\n        if mask_path is not None:\n            m = _read_tif_any(mask_path)\n            if m.ndim == 3: m = m[..., 0]\n            mask = m.astype(np.uint16)\n        \n        meta = {"index": idx, "image_id": img_path.stem, "image_path": str(img_path)}\n        return img, mask, meta\n\n    def generate_yolo_dataset(self, yolo_dir: str | Path, *, class_id: int = 0, class_name: str = "cell") -> str:\n        yolo_dir = Path(yolo_dir)\n        yolo_image_dir = yolo_dir / "images" / self.split\n        yolo_label_dir = yolo_dir / "labels" / self.split\n        yolo_image_dir.mkdir(parents=True, exist_ok=True)\n        yolo_label_dir.mkdir(parents=True, exist_ok=True)\n\n        for i in range(len(self)):\n            img, _, meta = self[i]\n            img_path = Path(meta[\'image_path\'])\n            mask_path = self.pairs[i][2]\n\n            out_img_path = yolo_image_dir / f"{img_path.stem}.png"\n            if not out_img_path.exists():\n                cv2.imwrite(str(out_img_path), cv2.cvtColor(img, cv2.COLOR_RGB2BGR))\n\n            label_path = yolo_label_dir / f"{img_path.stem}.txt"\n            if mask_path is not None and mask_path.exists():\n                mask_to_yolo_and_iou(mask_path, label_path, class_id)\n            else:\n                label_path.touch()\n\n        data_yaml_path = yolo_dir / "data.yaml"\n        current_data = {}\n        if data_yaml_path.exists():\n            with open(data_yaml_path, \'r\') as f:\n                current_data = yaml.safe_load(f) or {}\n\n        current_data[\'path\'] = str(yolo_dir.resolve())\n        current_data[\'names\'] = {class_id: class_name}\n        if self.split == \'train\':\n            current_data[\'train\'] = f"images/{self.split}"\n        elif self.split == \'val\':\n            current_data[\'val\'] = f"images/{self.split}"\n\n        with open(data_yaml_path, "w") as f:\n            yaml.safe_dump(current_data, f, sort_keys=False)\n        return str(data_yaml_path)\n\ndef cell_segmentation(train_dataset: CellSegDataset, val_dataset: CellSegDataset) -> List[np.ndarray]:\n    """Performs instance segmentation on a validation dataset of cell images."""\n    yolo_dir = Path("./yolo_cell_dataset")\n    if yolo_dir.exists():\n        shutil.rmtree(yolo_dir)\n    yolo_dir.mkdir(parents=True)\n    results_dir = Path("./runs")\n\n    print("Generating YOLO datasets...")\n    train_dataset.split = \'train\'\n    data_yaml_path = train_dataset.generate_yolo_dataset(yolo_dir)\n    val_dataset.split = \'val\'\n    val_dataset.generate_yolo_dataset(yolo_dir)\n\n    model = YOLO(\'yolov8x-seg.pt\')\n\n    print("Starting model training...")\n    run_name = "yolov8x_50e_1024px_aug"\n    model.train(\n        data=data_yaml_path,\n        epochs=50,\n        patience=10,\n        imgsz=1024,\n        batch=16,\n        project=str(results_dir),\n        name=run_name,\n        exist_ok=True,\n        degrees=90.0,\n        fliplr=0.5,\n        device=0,\n        val=True,\n        cache=True,\n    )\n    print("Training complete.")\n\n    best_model_path = results_dir / run_name / "weights/best.pt"\n    if not best_model_path.exists():\n        raise FileNotFoundError(f"Best model checkpoint not found at {best_model_path}")\n    best_model = YOLO(best_model_path)\n    print(f"Loaded best model from {best_model_path}")\n\n    seg_mask_list = []\n    print(f"Performing inference on {len(val_dataset)} validation images...")\n    for img, _, _ in val_dataset:\n        results = best_model(img, verbose=False, imgsz=1024, conf=0.25)\n        \n        res = results[0]\n        final_mask = np.zeros(res.orig_shape, dtype=np.uint16)\n\n        if res.masks is not None:\n            indices = torch.argsort(res.boxes.conf, descending=True)\n            \n            for i, idx in enumerate(indices):\n                mask_tensor = res.masks.data[idx]\n                mask = (mask_tensor > 0.5).cpu().numpy()\n                instance_id = i + 1\n                final_mask[(mask == 1) & (final_mask == 0)] = instance_id\n\n        seg_mask_list.append(final_mask)\n    \n    print("Inference complete. Returning segmentation masks.")\n    return seg_mask_list\n```'}[0m
[2026-01-12 05:51:41,549][root][INFO] - [31m[1m[MISC] - Draft Code: import numpy as np
import torch
from ultralytics import YOLO
from pathlib import Path
import shutil
import yaml
import cv2
import re
from typing import List, Optional, Tuple, Dict
from torch.utils.data import Dataset
import os

# Set a specific cache directory for ultralytics to avoid potential conflicts
os.environ["YOLO_CACHE"] = str(Path.cwd() / ".yolo_cache")
os.environ["ULTRALYTICS_HUB_CACHE"] = str(Path.cwd() / ".ultralytics_cache")


# Helper functions for CellSegDataset, implemented to make the script self-contained.
def _extract_index(stem: str) -> Optional[int]:
    """Tries to extract a trailing integer index from a filename stem."""
    match = re.search(r"(\d{4,})$", stem)
    if match:
        return int(match.group(1))
    return None


def _read_tif_any(p: Path) -> np.ndarray:
    """Reads a TIF, making sure to handle different bit depths and channels."""
    img = cv2.imread(str(p), -1)
    if img is None:
        raise IOError(f"Failed to read image: {p}")
    return img


def _as_rgb(arr: np.ndarray) -> np.ndarray:
    """Converts a grayscale or single-channel array to a 3-channel RGB array."""
    if arr.ndim == 2:
        return cv2.cvtColor(arr, cv2.COLOR_GRAY2RGB)
    if arr.ndim == 3 and arr.shape[2] == 1:
        return cv2.cvtColor(arr, cv2.COLOR_GRAY2RGB)
    if arr.ndim == 3 and arr.shape[2] == 4:
        return cv2.cvtColor(arr, cv2.COLOR_RGBA2RGB)
    if arr.ndim == 3 and arr.shape[2] == 3:
        return arr
    raise ValueError(f"Unsupported array shape for RGB conversion: {arr.shape}")


def mask_to_yolo_and_iou(mask_path: Path, txt_path: Path, class_id: int = 0):
    """Converts an instance mask to YOLOv8 segmentation format."""
    mask = _read_tif_any(mask_path)
    if mask.ndim == 3:
        mask = mask[..., 0]

    h, w = mask.shape
    lines = []
    instance_ids = np.unique(mask)
    instance_ids = instance_ids[instance_ids != 0]

    for instance_id in instance_ids:
        instance_mask = (mask == instance_id).astype(np.uint8)
        contours, _ = cv2.findContours(
            instance_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE
        )

        segment = []
        for contour in contours:
            if contour.shape[0] < 3:
                continue
            contour = contour.squeeze(1)
            normalized_contour = contour.astype(np.float32)
            normalized_contour[:, 0] /= w
            normalized_contour[:, 1] /= h
            segment.extend(normalized_contour.flatten().tolist())

        if segment:
            line = f"{class_id} " + " ".join(f"{coord:.6f}" for coord in segment)
            lines.append(line)

    with open(txt_path, "w") as f:
        f.write("\n".join(lines))


# Provided CellSegDataset class, modified slightly for robustness.
class CellSegDataset(Dataset):
    def __init__(
        self,
        data_dir,
        ann_dir,
        split: str = "train",
        require_masks: bool = True,
        image_glob: str = "*.tif",
        mask_glob: str = "*.tif",
    ):
        self.data_dir = Path(data_dir)
        self.ann_dir = Path(ann_dir)
        self.split = split
        self.require_masks = require_masks
        self.img_dir = self.data_dir
        self.mask_dir = self.ann_dir

        img_paths = sorted(self.img_dir.glob(image_glob))
        if not img_paths:
            raise RuntimeError(f"No images found in {self.img_dir}")
        mask_paths = sorted(self.mask_dir.glob(mask_glob))
        if not mask_paths and require_masks:
            raise RuntimeError(f"No masks found in {self.mask_dir}")

        img_by_idx: Dict[int, Path] = {
            idx: p for p in img_paths if (idx := _extract_index(p.stem)) is not None
        }
        mask_by_idx: Dict[int, Path] = {
            idx: p for p in mask_paths if (idx := _extract_index(p.stem)) is not None
        }
        if not img_by_idx:
            raise RuntimeError(f"No images with valid indices found in {self.img_dir}")

        self.pairs: List[Tuple[int, Path, Optional[Path]]] = []
        for idx in sorted(img_by_idx.keys()):
            img_p = img_by_idx[idx]
            m_p = mask_by_idx.get(idx)
            if self.require_masks and m_p is None:
                raise RuntimeError(f"Missing mask for image idx={idx}")
            self.pairs.append((idx, img_p, m_p))

        if not self.pairs:
            raise RuntimeError("No (image, mask) pairs could be formed.")

    def __len__(self):
        return len(self.pairs)

    def __getitem__(self, i):
        idx, img_path, mask_path = self.pairs[i]
        img = _read_tif_any(img_path)

        if img.dtype != np.uint8:
            if img.max() > 255:
                img = np.clip(img / 256, 0, 255).astype(np.uint8)
            else:
                img = img.astype(np.uint8)
        img = _as_rgb(img)

        mask = None
        if mask_path is not None:
            m = _read_tif_any(mask_path)
            if m.ndim == 3:
                m = m[..., 0]
            mask = m.astype(np.uint16)

        meta = {"index": idx, "image_id": img_path.stem, "image_path": str(img_path)}
        return img, mask, meta

    def generate_yolo_dataset(
        self, yolo_dir: str | Path, *, class_id: int = 0, class_name: str = "cell"
    ) -> str:
        yolo_dir = Path(yolo_dir)
        yolo_image_dir = yolo_dir / "images" / self.split
        yolo_label_dir = yolo_dir / "labels" / self.split
        yolo_image_dir.mkdir(parents=True, exist_ok=True)
        yolo_label_dir.mkdir(parents=True, exist_ok=True)

        for i in range(len(self)):
            img, _, meta = self[i]
            img_path = Path(meta["image_path"])
            mask_path = self.pairs[i][2]

            out_img_path = yolo_image_dir / f"{img_path.stem}.png"
            if not out_img_path.exists():
                cv2.imwrite(str(out_img_path), cv2.cvtColor(img, cv2.COLOR_RGB2BGR))

            label_path = yolo_label_dir / f"{img_path.stem}.txt"
            if mask_path is not None and mask_path.exists():
                mask_to_yolo_and_iou(mask_path, label_path, class_id)
            else:
                label_path.touch()

        data_yaml_path = yolo_dir / "data.yaml"
        current_data = {}
        if data_yaml_path.exists():
            with open(data_yaml_path, "r") as f:
                current_data = yaml.safe_load(f) or {}

        current_data["path"] = str(yolo_dir.resolve())
        current_data["names"] = {class_id: class_name}
        if self.split == "train":
            current_data["train"] = f"images/{self.split}"
        elif self.split == "val":
            current_data["val"] = f"images/{self.split}"

        with open(data_yaml_path, "w") as f:
            yaml.safe_dump(current_data, f, sort_keys=False)
        return str(data_yaml_path)


def cell_segmentation(
    train_dataset: CellSegDataset, val_dataset: CellSegDataset
) -> List[np.ndarray]:
    """Performs instance segmentation on a validation dataset of cell images."""
    yolo_dir = Path("./yolo_cell_dataset")
    if yolo_dir.exists():
        shutil.rmtree(yolo_dir)
    yolo_dir.mkdir(parents=True)
    results_dir = Path("./runs")

    print("Generating YOLO datasets...")
    train_dataset.split = "train"
    data_yaml_path = train_dataset.generate_yolo_dataset(yolo_dir)
    val_dataset.split = "val"
    val_dataset.generate_yolo_dataset(yolo_dir)

    model = YOLO("yolov8x-seg.pt")

    print("Starting model training...")
    run_name = "yolov8x_50e_1024px_aug"
    model.train(
        data=data_yaml_path,
        epochs=50,
        patience=10,
        imgsz=1024,
        batch=16,
        project=str(results_dir),
        name=run_name,
        exist_ok=True,
        degrees=90.0,
        fliplr=0.5,
        device=0,
        val=True,
        cache=True,
    )
    print("Training complete.")

    best_model_path = results_dir / run_name / "weights/best.pt"
    if not best_model_path.exists():
        raise FileNotFoundError(f"Best model checkpoint not found at {best_model_path}")
    best_model = YOLO(best_model_path)
    print(f"Loaded best model from {best_model_path}")

    seg_mask_list = []
    print(f"Performing inference on {len(val_dataset)} validation images...")
    for img, _, _ in val_dataset:
        results = best_model(img, verbose=False, imgsz=1024, conf=0.25)

        res = results[0]
        final_mask = np.zeros(res.orig_shape, dtype=np.uint16)

        if res.masks is not None:
            indices = torch.argsort(res.boxes.conf, descending=True)

            for i, idx in enumerate(indices):
                mask_tensor = res.masks.data[idx]
                mask = (mask_tensor > 0.5).cpu().numpy()
                instance_id = i + 1
                final_mask[(mask == 1) & (final_mask == 0)] = instance_id

        seg_mask_list.append(final_mask)

    print("Inference complete. Returning segmentation masks.")
    return seg_mask_list
