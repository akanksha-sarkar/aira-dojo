640: 93% ━━━━━━━━━━━─ 205/220 7.2it/s 30.8s<2.1s', '\r        2/2      1.49G      1.292      1.337      1.324      1.022         36        640: 94% ━━━━━━━━━━━─ 206/220 6.7it/s 31.0s<2.1s', '\r        2/2      1.49G      1.293      1.338      1.325      1.023         33        640: 94% ━━━━━━━━━━━─ 207/220 6.9it/s 31.1s<1.9s', '\r        2/2      1.49G      1.293      1.337      1.325      1.023         65        640: 95% ━━━━━━━━━━━─ 208/220 7.0it/s 31.3s<1.7s', '\r        2/2      1.49G      1.292      1.336      1.324      1.022         23        640: 95% ━━━━━━━━━━━─ 209/220 7.3it/s 31.4s<1.5s', '\r        2/2      1.49G      1.292      1.334      1.323      1.022         26        640: 95% ━━━━━━━━━━━─ 210/220 7.4it/s 31.5s<1.4s', '\r        2/2      1.49G      1.292      1.333      1.324      1.022         34        640: 96% ━━━━━━━━━━━╸ 211/220 7.5it/s 31.6s<1.2s', '\r        2/2      1.49G      1.292      1.333      1.324      1.022         45        640: 96% ━━━━━━━━━━━╸ 212/220 7.2it/s 31.8s<1.1s', '\r        2/2      1.49G      1.292      1.332      1.323      1.022         33        640: 97% ━━━━━━━━━━━╸ 213/220 7.1it/s 31.9s<1.0s', '\r        2/2      1.49G       1.29      1.331      1.323      1.022         28        640: 97% ━━━━━━━━━━━╸ 214/220 7.3it/s 32.1s<0.8s', '\r        2/2      1.49G      1.291      1.333      1.323      1.023         34        640: 98% ━━━━━━━━━━━╸ 215/220 7.6it/s 32.2s<0.7s', '\r        2/2      1.49G      1.291      1.333      1.321      1.023         50        640: 98% ━━━━━━━━━━━╸ 216/220 7.3it/s 32.3s<0.5s', '\r        2/2      1.49G       1.29      1.331      1.321      1.022         35        640: 99% ━━━━━━━━━━━╸ 217/220 7.2it/s 32.5s<0.4s', '\r        2/2      1.49G      1.289      1.331      1.319      1.022         31        640: 99% ━━━━━━━━━━━╸ 218/220 6.7it/s 32.7s<0.3s', '\r        2/2       1.5G       1.29      1.331       1.32      1.023         21        640: 100% ━━━━━━━━━━━╸ 219/220 7.1it/s 32.8s<0.1s', '\