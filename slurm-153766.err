'import numpy as np
import torch
import cv2
from pathlib import Path
import shutil
import re
from typing import Dict, List, Optional, Tuple
from torch.utils.data import Dataset
import yaml
from ultralytics import YOLO


# Helper functions for CellSegDataset (assumed to be provided)
def _extract_index(filename_stem: str) -> Optional[int]:
    """Tries to extract a trailing integer index from a filename stem."""
    match = re.search(r"(\d+)$", filename_stem)
    return int(match.group(1)) if match else None


def _read_tif_any(p: Path) -> np.ndarray:
    """Read a TIF file, handling different bit depths and channel configurations."""
    img = cv2.imread(str(p), cv2.IMREAD_UNCHANGED)
    if img is None:
        raise IOError(f"Failed to load image: {p}")
    return img


def _as_rgb(img: np.ndarray) -> np.ndarray:
    """Converts a grayscale or other format image to 3-channel RGB uint8."""
    if img.ndim == 2:
        img = cv2.cvtColor(img, cv2.COLOR_GRAY2RGB)
    elif img.ndim == 3 and img.shape[2] == 1:
        img = cv2.cvtColor(img, cv2.COLOR_GRAY2RGB)
    elif img.ndim == 3 and img.shape[2] > 3:
        img = img[..., :3]  # Drop alpha or other channels

    if img.dtype != np.uint8:
        # Scale to 0-255 if not already
        if img.dtype in [np.uint16, np.uint32, np.int16, np.int32]:
            img = cv2.normalize(img, None, 0, 255, cv2.NORM_MINMAX, dtype=cv2.CV_8U)
        else:
            img = np.clip(img, 0, 255).astype(np.uint8)

    return img


def mask_to_yolo_and_iou(mask_path, txt_path, class_id=0):
    mask = _read_tif_any(Path(mask_path))
    H, W = mask.shape
    instance_ids = np.unique(mask)
    instance_ids = instance_ids[instance_ids != 0]

    lines = []
    total_iou = 0
    total_dice = 0
    count = 0

    for inst_id in instance_ids:
        binary_mask = (mask == inst_id).astype(np.uint8)
        contours, _ = cv2.findContours(
            binary_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE
        )
        if not contours:
            continue

        # Combine all contours for a single instance into one
        all_points = np.concatenate(contours, axis=0)

        # Normalize and format for YOLO
        norm_points = all_points.squeeze().astype(np.float32)
        norm_points[:, 0] /= W
        norm_points[:, 1] /= H

        line = f"{class_id} " + " ".join(
            [f"{p[0]:.6f} {p[1]:.6f}" for p in norm_points]
        )
        lines.append(line)

    if txt_path:
        with open(txt_path, "w") as f:
            f.write("\n".join(lines))

    # Dummy return values as they are not used in this context
    return 0, 0


# Provided CellSegDataset class
class CellSegDataset(Dataset):
    def __init__(
        self,
        data_dir,
        ann_dir,
        split: str = "train",
        require_masks: bool = True,
        image_glob: str = "*.tif",
        mask_glob: str = "*.tif",
    ):
        self.data_dir = Path(data_dir)
        self.ann_dir = Path(ann_dir)
        self.split = split
        self.require_masks = require_masks

        self.img_dir = self.data_dir
        self.mask_dir = self.ann_dir

        img_paths = sorted(self.img_dir.glob(image_glob))
        if not img_paths:
            raise RuntimeError(f"No images found in {self.img_dir} (glob={image_glob})")

        mask_paths = sorted(self.mask_dir.glob(mask_glob))
        if not mask_paths and require_masks:
            raise RuntimeError(f"No masks found in {self.mask_dir} (glob={mask_glob})")

        img_by_idx: Dict[int, Path] = {}
        for p in img_paths:
            idx = _extract_index(p.stem)
            if idx is None:
                continue
            img_by_idx[idx] = p

        mask_by_idx: Dict[int, Path] = {}
        for p in mask_paths:
            idx = _extract_index(p.stem)
            if idx is None:
                continue
            mask_by_idx[idx] = p

        if not img_by_idx:
            raise RuntimeError(
                f"Found images in {self.img_dir} but none matched an index pattern (e.g., ...0000.tif)."
            )

        self.pairs: List[Tuple[int, Path, Optional[Path]]] = []
        for idx in sorted(img_by_idx.keys()):
            img_p = img_by_idx[idx]
            m_p = mask_by_idx.get(idx, None)

            if self.require_masks and m_p is None:
                raise RuntimeError(
                    f"Missing mask for image idx={idx}: image={img_p.name}. "
                    f"Expected a mask with the same trailing index in {self.mask_dir} "
                    f"(e.g., man_seg{idx:04d}.tif or mask{idx:04d}.tif)."
                )

            self.pairs.append((idx, img_p, m_p))

        if not self.pairs:
            raise RuntimeError("No (image, mask) pairs could be formed.")

    def __len__(self):
        return len(self.pairs)

    def __getitem__(self, i):
        idx, img_path, mask_path = self.pairs[i]

        img = _read_tif_any(img_path)
        img = _as_rgb(img)

        mask = None
        if mask_path is not None:
            m = _read_tif_any(mask_path)
            if m.ndim == 3:
                m = m[..., 0]
            mask = m.astype(np.uint16)

        meta = {
            "index": idx,
            "image_id": img_path.stem,
            "image_path": str(img_path),
            "mask_path": str(mask_path) if mask_path is not None else None,
        }

        return img, mask, meta

    def generate_yolo_dataset(
        self,
        yolo_dir: str | Path,
        *,
        class_id: int = 0,
        class_name: str = "cell",
        write_empty_labels: bool = True,
    ) -> str:
        yolo_dir = Path(yolo_dir)
        split = self.split

        yolo_image_dir = yolo_dir / "images" / split
        yolo_label_dir = yolo_dir / "labels" / split
        yolo_image_dir.mkdir(parents=True, exist_ok=True)
        yolo_label_dir.mkdir(parents=True, exist_ok=True)

        for idx, img_path, mask_path in self.pairs:
            img = _read_tif_any(img_path)
            img = _as_rgb(img)

            out_img_name = f"{img_path.stem}.png"
            out_img_path = yolo_image_dir / out_img_name
            cv2.imwrite(str(out_img_path), cv2.cvtColor(img, cv2.COLOR_RGB2BGR))

            label_path = yolo_label_dir / f"{img_path.stem}.txt"
            if mask_path is not None and Path(mask_path).exists():
                mask_to_yolo_and_iou(
                    mask_path=mask_path,
                    txt_path=label_path,
                    class_id=class_id,
                )
            elif write_empty_labels:
                label_path.touch()

        data_yaml_path = yolo_dir / "data.yaml"
        yaml_config = {
            "path": str(yolo_dir.resolve()),
            "train": f"images/{self.split if self.split == 'train' else '../train'}",
            "val": f"images/{self.split if self.split == 'val' else '../val'}",
            "names": {class_id: class_name},
        }

        if data_yaml_path.exists():
            try:
                with open(data_yaml_path, "r") as f:
                    existing = yaml.safe_load(f) or {}
                if "train" in existing and self.split == "val":
                    yaml_config["train"] = existing["train"]
                if "val" in existing and self.split == "train":
                    yaml_config["val"] = existing["val"]
            except Exception:
                pass

        with open(data_yaml_path, "w") as f:
            yaml.safe_dump(yaml_config, f, sort_keys=False)

        self.yolo_yaml_path = str(data_yaml_path)
        return str(data_yaml_path)

    def get_yolo_dataset(self) -> str:
        if not hasattr(self, "yolo_yaml_path"):
            raise RuntimeError(
                "YOLO dataset has not been generated yet. Call generate_yolo_dataset(...) first."
            )
        return self.yolo_yaml_path


def cell_segmentation(
    train_dataset: CellSegDataset, val_dataset: CellSegDataset
) -> list[np.ndarray]:
    """
    Performs instance segmentation on a validation dataset of cell images.

    Input
    •	train_dataset: a CellSegDataset containing training images and instance masks.
    •	val_dataset: a CellSegDataset containing validation images (and possibly masks).

    Returns:
        seg_mask_list: list[np.ndarray] of uint16 instance-id masks, one per image in val_dataset
    """

    # 1. Prepare YOLO dataset
    yolo_dir = Path("./yolo_dataset")
    if yolo_dir.exists():
        shutil.rmtree(yolo_dir)
    yolo_dir.mkdir(parents=True)

    # Generate train and val splits
    print("Generating YOLO dataset for training...")
    train_dataset.generate_yolo_dataset(yolo_dir)
    print("Generating YOLO dataset for validation...")
    val_dataset.generate_yolo_dataset(yolo_dir)
    data_yaml_path = val_dataset.get_yolo_dataset()

    # 2. Train the model
    # Clean up previous training runs
    project_dir = Path("./cell_seg_project")
    if project_dir.exists():
        shutil.rmtree(project_dir)

    model = YOLO("yolov8l-seg.pt")

    # Training parameters
    imgsz = 1024
    epochs = 50
    patience = 10
    batch = 8  # Safe batch size for RTX 6000 Ada with this model and image size

    print("Starting model training...")
    model.train(
        data=data_yaml_path,
        epochs=epochs,
        patience=patience,
        imgsz=imgsz,
        batch=batch,
        project="cell_seg_project",
        name="yolov8l_run",
        exist_ok=True,
        verbose=True,
    )
    print("Training finished.")

    # 3. Load the best model and perform inference
    best_model_path = "./cell_seg_project/yolov8l_run/weights/best.pt"
    print(f"Loading best model from: {best_model_path}")
    best_model = YOLO(best_model_path)

    seg_mask_list = []

    print(f"Starting inference on {len(val_dataset)} validation images...")
    for i in range(len(val_dataset)):
        img, _, meta = val_dataset[i]
        original_h, original_w, _ = img.shape

        results = best_model.predict(img, imgsz=imgsz, verbose=False, conf=0.25)
        result = results[0]

        final_mask = np.zeros((original_h, original_w), dtype=np.uint16)

        if result.masks is None or len(result.masks) == 0:
            seg_mask_list.append(final_mask)
            continue

        masks = result.masks.data
        boxes = result.boxes.data

        # Sort by confidence score (descending)
        confidences = boxes[:, 4]
        sorted_indices = torch.argsort(confidences, descending=True)

        instance_id = 1
        for idx in sorted_indices:
            mask_tensor = masks[idx]

            mask_np = mask_tensor.cpu().numpy().astype(np.uint8)
            # Resize mask to original image dimensions
            resized_mask = cv2.resize(
                mask_np, (original_w, original_h), interpolation=cv2.INTER_NEAREST
            )

            # Add mask to the final instance mask, preventing overlaps with higher-confidence masks
            final_mask[(resized_mask == 1) & (final_mask == 0)] = instance_id
            instance_id += 1
            if instance_id > np.iinfo(np.uint16).max:
                print(
                    f"Warning: Exceeded max number of instances for uint16 in image {meta['image_id']}. Some instances may be merged."
                )
                break

        seg_mask_list.append(final_mask)

    print("Inference complete.")
    return seg_mask_list
