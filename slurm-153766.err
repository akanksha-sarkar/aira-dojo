'import numpy as np
import torch
from ultralytics import YOLO
from pathlib import Path
import cv2
from typing import List
import yaml

# The CellSegDataset class and its helpers are provided in the environment.
# We include them here for completeness in a self-contained script.
from torch.utils.data import Dataset
from typing import Dict, List, Optional, Tuple
import re


def _extract_index(filename_stem: str) -> Optional[int]:
    """Tries to extract a trailing integer index from a filename stem."""
    # Matches integers at the end of the string.
    match = re.search(r"(\d+)$", filename_stem)
    if match:
        return int(match.group(1))
    return None


def _read_tif_any(path: Path) -> np.ndarray:
    """Reads a TIF, trying grayscale first, then color."""
    img = cv2.imread(str(path), cv2.IMREAD_UNCHANGED)
    if img is None:
        raise IOError(f"Could not read image: {path}")
    return img


def _as_rgb(img: np.ndarray) -> np.ndarray:
    """Converts a grayscale or single-channel image to 3-channel RGB."""
    if img.ndim == 2:
        return cv2.cvtColor(img, cv2.COLOR_GRAY2RGB)
    if img.ndim == 3 and img.shape[2] == 1:
        return cv2.cvtColor(img, cv2.COLOR_GRAY2RGB)
    if img.ndim == 3 and img.shape[2] == 4:
        return cv2.cvtColor(img, cv2.COLOR_BGRA2RGB)
    return img


def mask_to_yolo_and_iou(
    mask_path: Path | str,
    txt_path: Path | str,
    class_id: int = 0,
) -> Tuple[List[float], List[float]]:
    mask = _read_tif_any(Path(mask_path))
    if mask.ndim == 3:
        mask = mask[..., 0]

    h, w = mask.shape
    instance_ids = sorted(np.unique(mask))
    instance_ids = [i for i in instance_ids if i != 0]

    lines = []
    for inst_id in instance_ids:
        binary_mask = (mask == inst_id).astype(np.uint8)
        contours, _ = cv2.findContours(
            binary_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE
        )

        if not contours:
            continue

        all_points = np.concatenate(contours, axis=0)
        if len(all_points) < 3:  # Need at least 3 points for a polygon
            continue

        points_normalized = all_points.squeeze(axis=1).astype(np.float32)
        points_normalized[:, 0] /= w
        points_normalized[:, 1] /= h

        line = f"{class_id} " + " ".join(
            [f"{p[0]:.6f} {p[1]:.6f}" for p in points_normalized.tolist()]
        )
        lines.append(line)

    with open(txt_path, "w") as f:
        f.write("\n".join(lines))

    return [], []


class CellSegDataset(Dataset):
    def __init__(
        self,
        data_dir,
        ann_dir,
        split: str = "train",
        require_masks: bool = True,
        image_glob: str = "*.tif",
        mask_glob: str = "*.tif",
    ):
        self.data_dir = Path(data_dir)
        self.ann_dir = Path(ann_dir)
        self.split = split
        self.require_masks = require_masks

        self.img_dir = self.data_dir
        self.mask_dir = self.ann_dir

        img_paths = sorted(self.img_dir.glob(image_glob))
        if not img_paths:
            raise RuntimeError(f"No images found in {self.img_dir} (glob={image_glob})")

        mask_paths = sorted(self.mask_dir.glob(mask_glob))
        if not mask_paths and require_masks:
            raise RuntimeError(f"No masks found in {self.mask_dir} (glob={mask_glob})")

        img_by_idx: Dict[int, Path] = {}
        for p in img_paths:
            idx = _extract_index(p.stem)
            if idx is None:
                continue
            img_by_idx[idx] = p

        mask_by_idx: Dict[int, Path] = {}
        for p in mask_paths:
            idx = _extract_index(p.stem)
            if idx is None:
                continue
            mask_by_idx[idx] = p

        if not img_by_idx:
            raise RuntimeError(
                f"Found images in {self.img_dir} but none matched an index pattern (e.g., ...0000.tif)."
            )

        self.pairs: List[Tuple[int, Path, Optional[Path]]] = []
        for idx in sorted(img_by_idx.keys()):
            img_p = img_by_idx[idx]
            m_p = mask_by_idx.get(idx, None)
            if self.require_masks and m_p is None:
                raise RuntimeError(
                    f"Missing mask for image idx={idx}: image={img_p.name}."
                )
            self.pairs.append((idx, img_p, m_p))

        if not self.pairs:
            raise RuntimeError("No (image, mask) pairs could be formed.")

    def __len__(self):
        return len(self.pairs)

    def __getitem__(self, i):
        idx, img_path, mask_path = self.pairs[i]
        img = _read_tif_any(img_path)
        img = _as_rgb(img)
        mask = None
        if mask_path is not None:
            m = _read_tif_any(mask_path)
            if m.ndim == 3:
                m = m[..., 0]
            mask = m.astype(np.uint16)
        meta = {
            "index": idx,
            "image_id": img_path.stem,
            "image_path": str(img_path),
            "mask_path": str(mask_path) if mask_path is not None else None,
        }
        return img, mask, meta

    def generate_yolo_dataset(
        self,
        yolo_dir: str | Path,
        *,
        class_id: int = 0,
        class_name: str = "cell",
        write_empty_labels: bool = True,
    ) -> str:
        yolo_dir = Path(yolo_dir)
        split = self.split
        print(f"Building YOLO-seg dataset at {yolo_dir} (split={split})...")
        yolo_image_dir = yolo_dir / "images" / split
        yolo_label_dir = yolo_dir / "labels" / split
        yolo_image_dir.mkdir(parents=True, exist_ok=True)
        yolo_label_dir.mkdir(parents=True, exist_ok=True)
        num_written = 0
        for idx, img_path, mask_path in self.pairs:
            assert img_path.exists(), f"Missing image: {img_path}"
            img = _read_tif_any(img_path)
            img = _as_rgb(img)
            if img.dtype != np.uint8:
                img = np.clip(img, 0, 255).astype(np.uint8)
            out_img_name = f"{img_path.stem}.png"
            out_img_path = yolo_image_dir / out_img_name
            if not out_img_path.exists():
                cv2.imwrite(str(out_img_path), cv2.cvtColor(img, cv2.COLOR_RGB2BGR))
            label_path = yolo_label_dir / f"{img_path.stem}.txt"
            if mask_path is not None and Path(mask_path).exists():
                mask_to_yolo_and_iou(
                    mask_path=mask_path, txt_path=label_path, class_id=class_id
                )
            else:
                if write_empty_labels:
                    label_path.touch()
                else:
                    continue
            num_written += 1
        data_yaml_path = yolo_dir / "data.yaml"
        yaml_config = {
            "path": str(yolo_dir.resolve()),
            "train": "images/train",
            "val": "images/val",
            "names": {class_id: class_name},
        }
        if data_yaml_path.exists():
            try:
                with open(data_yaml_path, "r") as f:
                    existing = yaml.safe_load(f) or {}
            except Exception:
                existing = {}
            existing.update(yaml_config)
            yaml_config = existing
        with open(data_yaml_path, "w") as f:
            yaml.safe_dump(yaml_config, f, sort_keys=False)
        self.yolo_dir = yolo_dir
        self.yolo_yaml_path = str(data_yaml_path)
        print(f"Done. Wrote {num_written} samples to split={split}.")
        return str(data_yaml_path)

    def get_yolo_dataset(self) -> str:
        if not hasattr(self, "yolo_yaml_path"):
            raise RuntimeError(
                "YOLO dataset has not been generated yet. Call generate_yolo_dataset(...) first."
            )
        return self.yolo_yaml_path


def cell_segmentation(train_dataset, val_dataset) -> List[np.ndarray]:
    """
    Performs instance segmentation on a validation dataset of cell images.

    This function trains a YOLOv8-seg model on the training data and then uses
    the trained model to predict instance masks on the validation data.

    Input:
    - train_dataset: A CellSegDataset containing training images and instance masks.
    - val_dataset: A CellSegDataset containing validation images.

    Returns:
    - seg_mask_list: A list of uint16 instance-id masks (np.ndarray), one for each
      image in the validation dataset.
    """
    # 1. Data Preparation
    # Use a directory in /tmp for wider compatibility.
    yolo_data_dir = Path("/tmp/yolo_cell_dataset")
    yolo_data_dir.mkdir(exist_ok=True, parents=True)

    print("Generating YOLO dataset for training...")
    data_yaml_path = train_dataset.generate_yolo_dataset(yolo_data_dir)

    print("Generating YOLO dataset for validation...")
    val_dataset.generate_yolo_dataset(yolo_data_dir, split="val")

    # 2. Model Selection and Training
    # Use a medium-sized model for a good balance of accuracy and speed.
    model_name = "yolov8m-seg.pt"
    model = YOLO(model_name)

    # Training Hyperparameters
    epochs = 100
    imgsz = 1024
    patience = 25  # Increased patience
    batch_size = 8

    device = "0" if torch.cuda.is_available() else "cpu"

    print(
        f"Starting training with model: {model_name} for {epochs} epochs on device: {device}..."
    )
    # Train the model with a comprehensive set of parameters to ensure they are applied.
    model.train(
        data=data_yaml_path,
        epochs=epochs,
        imgsz=imgsz,
        patience=patience,
        batch=batch_size,
        device=device,
        project="yolo_training_cells_fixed",
        name="cell_seg_exp",
        exist_ok=True,
        degrees=90,
        flipud=0.5,
        fliplr=0.5,
        mosaic=1.0,
        cos_lr=True,  # Use cosine learning rate scheduler
        val=True,  # Explicitly enable validation during training
    )
    print("Training finished.")

    # 3. Inference
    # Load the best model checkpoint saved during training.
    best_model_path = Path("yolo_training_cells_fixed/cell_seg_exp/weights/best.pt")
    if not best_model_path.exists():
        print(f"Warning: {best_model_path} not found. Falling back to last.pt")
        best_model_path = Path("yolo_training_cells_fixed/cell_seg_exp/weights/last.pt")
        if not best_model_path.exists():
            raise FileNotFoundError("Could not find any trained model weights.")

    inference_model = YOLO(best_model_path)

    # Prepare images for batched inference
    val_images = []
    original_shapes = []
    for i in range(len(val_dataset)):
        img, _, _ = val_dataset[i]
        val_images.append(img)
        original_shapes.append(img.shape[:2])  # (h, w)

    print(f"Starting batched inference on {len(val_images)} validation images...")
    all_results = inference_model.predict(
        source=val_images,
        imgsz=imgsz,
        conf=0.20,  # Lower confidence threshold slightly to detect fainter cells
        iou=0.7,
        stream=False,
        verbose=False,
        device=device,
    )
    print("Inference finished.")

    # 4. Post-processing
    seg_mask_list = []
    for i, result in enumerate(all_results):
        original_h, original_w = original_shapes[i]
        final_mask = np.zeros((original_h, original_w), dtype=np.uint16)

        if (
            result.masks is not None
            and result.boxes is not None
            and result.boxes.conf is not None
        ):
            # Sort detected instances by confidence score in descending order.
            sorted_indices = torch.argsort(result.boxes.conf, descending=True)

            instance_id = 1
            for idx in sorted_indices:
                mask_tensor = result.masks.data[idx]
                mask_np = mask_tensor.cpu().numpy()
                mask_resized = cv2.resize(
                    mask_np, (original_w, original_h), interpolation=cv2.INTER_NEAREST
                )
                binary_mask = mask_resized > 0.5

                # Assign instance ID only to pixels not yet assigned.
                final_mask[(binary_mask) & (final_mask == 0)] = instance_id

                if np.any(final_mask == instance_id):
                    instance_id += 1

        seg_mask_list.append(final_mask)

    print(f"Generated {len(seg_mask_list)} segmentation masks.")
    return seg_mask_list
