━─────── 10/22 6.8it/s 1.5s<1.8s', '\r        2/2      1.47G      1.657      2.039      2.331      1.122         30        640: 50% ━━━━━━────── 11/22 6.6it/s 1.7s<1.7s', '\r        2/2      1.47G      1.672      2.032      2.337      1.131         42        640: 55% ━━━━━━╸───── 12/22 7.2it/s 1.8s<1.4s', '\r        2/2      1.47G      1.674      2.024      2.332      1.131         43        640: 59% ━━━━━━━───── 13/22 7.2it/s 2.0s<1.3s', '\r        2/2      1.47G      1.668      2.031      2.326      1.132         44        640: 64% ━━━━━━━╸──── 14/22 7.1it/s 2.1s<1.1s', '\r        2/2      1.47G      1.675      2.065      2.334      1.137         40        640: 68% ━━━━━━━━──── 15/22 6.8it/s 2.3s<1.0s', '\r        2/2      1.47G      1.653      2.048      2.315      1.127         32        640: 73% ━━━━━━━━╸─── 16/22 6.8it/s 2.4s<0.9s', '\r        2/2      1.47G      1.653      2.037      2.303      1.126         48        640: 77% ━━━━━━━━━─── 17/22 7.0it/s 2.5s<0.7s', '\r        2/2      1.47G      1.652      2.031      2.295      1.129         43        640: 82% ━━━━━━━━━╸── 18/22 7.3it/s 2.7s<0.5s', '\r        2/2      1.47G      1.633      2.003      2.286      1.124         34        640: 86% ━━━━━━━━━━── 19/22 6.7it/s 2.9s<0.4s', '\r        2/2      1.47G      1.637      2.003      2.273      1.131         45        640: 91% ━━━━━━━━━━╸─ 20/22 6.9it/s 3.0s<0.3s', '\r        2/2      1.47G      1.627      2.002      2.267      1.127         38        640: 95% ━━━━━━━━━━━─ 21/22 7.1it/s 3.1s<0.1s', '\r        2/2      1.47G      1.627      2.002      2.267      1.127         38        640: 100% ━━━━━━━━━━━━ 22/22 7.0it/s 3.1s', '\r        2/2      1.47G      1.627      2.002      2.267      1.127         38        640: 100% ━━━━━━━━━━━━ 22/22 7.0it/s 3.1s', '\n', '\r                 Class     Images  Instances      Box(P          R      mAP50  mAP50-95)     Mask(P          R      mAP50  mAP50-95): 100% ━━━━━━━━━━━━ 1/1 15.3it/s 0.1s', '\r                 Clas