ataset for training. This creates images/train, labels/train, and data.yaml\n    print("Generating YOLO dataset for training...")\n    data_yaml_path = train_dataset.generate_yolo_dataset(yolo_data_dir)\n\n    # Generate YOLO dataset for validation. This creates images/val, labels/val, and updates data.yaml\n    print("Generating YOLO dataset for validation...")\n    val_dataset.generate_yolo_dataset(yolo_data_dir)\n\n    # 2. Model Selection and Training\n    # We choose yolov8s-seg as a balance between performance and training speed.\n    model_name = "yolov8s-seg.pt"\n    model = YOLO(model_name)\n\n    # Training Hyperparameters\n    epochs = 40\n    imgsz = 1024\n    patience = 15\n    batch_size = 8  # Chosen as a safe value for a 48GB GPU with 1024px images.\n\n    device = "0" if torch.cuda.is_available() else "cpu"\n\n    print(\n        f"Starting training with model: {model_name} for {epochs} epochs on device: {device}..."\n    )\n    model.train(\n        data=data_yaml_path,\n        epochs=epochs,\n        imgsz=imgsz,\n        patience=patience,\n        batch=batch_size,\n        device=device,\n        project="yolo_training_cells",\n        name="cell_seg_exp",\n        exist_ok=True,  # Overwrite previous training runs\n        degrees=90,  # random rotation (-90, +90)\n        flipud=0.5,  # random vertical flip\n        fliplr=0.5,  # random horizontal flip\n        mosaic=0.5,  # use mosaic augmentation\n    )\n    print("Training finished.")\n\n    # 3. Inference\n    # Load the best model checkpoint saved during training.\n    best_model_path = Path("yolo_training_cells/cell_seg_exp/weights/best.pt")\n    if not best_model_path.exists():\n        print(f"Warning: {best_model_path} not found. Falling back to last.pt")\n        best_model_path = Path("yolo_training_cells/cell_seg_exp/weights/last.pt")\n        if not best_model_path.exists():\n            raise FileNotFoundError("Could not find any trained model weights.")\n\n    inference_model = YOLO(best_model_path)\n\n    # Prepare images for batched inference\n    val_images = []\n    original_shapes = []\n    for i in range(len(val_dataset)):\n        img, _, _ = val_dataset[i]\n        val_images.append(img)\n        original_shapes.append(img.shape[:2])  # (h, w)\n\n    print(f"Starting batched inference on {len(val_images)} validation images...")\n    all_results = inference_model.predict(\n        source=val_images,\n        imgsz=imgsz,\n        conf=0.25,  # Confidence threshold\n        iou=0.7,  # NMS IoU threshold\n        stream=False,  # Return all results in a list\n        verbose=False,\n        device=device,\n    )\n    print("Inference finished.")\n\n    # 4. Post-processing\n    # Convert prediction results into the required instance mask format.\n    seg_mask_list = []\n    for i, result in enumerate(all_results):\n        original_h, original_w = original_shapes[i]\n        final_mask = np.zeros((original_h, original_w), dtype=np.uint16)\n\n        if result.masks is not None and result.boxes.conf is not None:\n            # Sort detected instances by confidence score in descending order.\n            # This ensures that higher-confidence masks get priority in case of overlaps.\n            sorted_indices = torch.argsort(result.boxes.conf, descending=True)\n\n            instance_id = 1\n            for idx in sorted_indices:\n                # Get the binary mask for the current instance.\n                mask_tensor = result.masks.data[idx]\n\n                # Resize the mask from the model\'s output size to the original image size.\n                # INTER_NEAREST is used to prevent introducing new values in the mask.\n                mask_np = mask_tensor.cpu().numpy()\n                mask_resized = cv2.resize(\n                    mask_np, (original_w, original_h), interpolation=cv2.INTER_NEAREST\n                )\n\n                # Binarize the resized mask.\n                binary_mask = mask_resized > 0.5\n\n                # Assign the unique instance ID to the pixels of the current mask,\n                # but only where the final mask is still background (value 0).\n                final_mask[(binary_mask) & (final_mask == 0)] = instance_id\n\n                # Only increment the instance ID if the mask was actually added\n                # (i.e., it wasn\'t completely occluded by higher-confidence masks).\n                if np.any(final_mask == instance_id):\n                    instance_id += 1\n\n        seg_mask_list.append(final_mask)\n\n    print(f"Generated {len(seg_mask_list)} segmentation masks.")\n    return seg_mask_list\n\n```\n\n# Execution output:\n```\n✅ Added /work to sys.path\nWorking dir: /\n✅ Added /work to sys.path\nWorking dir: /\n  program_path: /work/program.py (exists: True)\n[INFO] Loading program from /work/program.py\nWARNING ⚠️ user config directory \'/root/.config/Ultralytics\' is not writable, using \'/tmp/Ultralytics\'. Set YOLO_CONFIG_DIR to override.\nCreating new Ultralytics Settings v0.0.6 file ✅ \nView Ultralytics Settings with \'yolo settings\' or at \'/tmp/Ultralytics/settings.json\'\nUpdate Settings with \'yolo settings key=value\', i.e. \'yolo settings runs_dir=path/to/dir\'. For help see https://docs.ultralytics.com/quickstart/#ultralytics-settings.\n[INFO] [SEQ 01] train_data=/work/data/train/01/img\n[INFO] [SEQ 01] train_ann =/work/data/train/01/seg\n[INFO] [SEQ 01] val_data  =/work/data/val/01/img\n[INFO] [SEQ 01] val_ann   =/work/data/val/01/GT/SEG\n[INFO] [SEQ 01] gt_root   =/work/data/val/01/GT\nUsing YOLO dataset directory: /cache/yolo_cellseg\nBuilding YOLO-seg dataset at /cache/yolo_cellseg (split=train)...\nDone. Wrote 172 samples to split=train.\nBuilding YOLO-seg dataset at /cache/yolo_cellseg (split=val)...\nDone. Wrote 49 samples to split=val.\nTraining YOLO model...\n\rDownloading https://github.com/ultralytics/assets/releases/download/v8.3.0/yolov8n-seg.pt to \'yolov8n-seg.pt\': 100% ━━━━━━━━━━━━ 6.7MB 107.6MB/s 0.1s\