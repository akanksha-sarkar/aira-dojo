n early stopping mechanism with a patience of 10 epochs on the validation mask mAP50 to prevent overfitting and optimize training time. To enhance robustness to variations in cell orientation, I will enable data augmentations including 90-degree rotations and horizontal flips, which are suitable for microscopy data. For the final output, I will implement a careful post-processing step that sorts predicted instance masks by their confidence scores before merging them into a single `uint16` mask, ensuring that overlaps are resolved in favor of the most confident detections. The primary evaluation metric guiding this process will be the mean Average Precision for segmentation masks at an IoU threshold of 0.5 (mAP50), as reported on the validation set during training.\n\n```python\nimport torch\nimport cv2\nimport numpy as np\nimport yaml\nfrom pathlib import Path\nfrom typing import Dict, List, Optional, Tuple\nfrom torch.utils.data import Dataset\nfrom ultralytics import YOLO\nimport shutil\nimport re\nimport tifffile\nimport warnings\nimport os\n\n# --- Helper Functions and Classes from Problem Description ---\n\ndef _extract_index(fname: str) -> Optional[int]:\n    """Tries to extract a numeric index from a filename stem."""\n    # First, try to match a pattern of 4 or more digits at the end of the string\n    match = re.search(r"(\\d{4,})$", fname)\n    if match:\n        return int(match.group(1))\n\n    # If that fails, try to find any sequence of digits\n    match = re.search(r"\\d+", fname)\n    if match:\n        return int(match.group(0))\n\n    return None\n\ndef _read_tif_any(p: Path) -> np.ndarray:\n    """Read a TIF file, handling various possible dimensionalities."""\n    try:\n        img = tifffile.imread(p)\n        return img\n    except Exception as e:\n        warnings.warn(f"tifffile failed to read {p}: {e}. Trying cv2.")\n        img = cv2.imread(str(p), cv2.IMREAD_UNCHANGED)\n        if img is None:\n            raise IOError(f"Failed to read image {p} with both tifffile and cv2.")\n        return img\n\ndef _as_rgb(img: np.ndarray) -> np.ndarray:\n    """Converts a grayscale or single-channel image to 3-channel RGB."""\n    if img.ndim == 2:\n        return np.stack([img] * 3, axis=-1)\n    if img.shape[-1] == 1:\n        return np.concatenate([img] * 3, axis=-1)\n    if img.shape[-1] > 3:\n        return img[..., :3]  # Take the first 3 channels\n    return img\n\ndef mask_to_yolo_and_iou(\n    mask_path: Path, txt_path: Path, class_id: int = 0\n) -> Tuple[float, float]:\n    """\n    Converts a single instance mask to YOLO segmentation format and saves to a .txt file.\n    Also calculates IoU and Dice score for the conversion.\n    """\n    mask = _read_tif_any(mask_path)\n    if mask.ndim == 3:\n        mask = mask[..., 0]\n\n    h, w = mask.shape\n    instance_ids = np.unique(mask)\n    instance_ids = instance_ids[instance_ids != 0]\n\n    yolo_lines = []\n    reconstructed_mask = np.zeros_like(mask)\n\n    for i, instance_id in enumerate(instance_ids):\n        instance_mask = mask == instance_id\n        contours, _ = cv2.findContours(\n            instance_mask.astype(np.uint8), cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE\n        )\n\n        for contour in contours:\n            if contour.size < 6:\n                continue\n\n            segment = contour.flatten().tolist()\n            normalized_segment = [\n                val / w if i % 2 == 0 else val / h for i, val in enumerate(segment)\n            ]\n            yolo_lines.append(f"{class_id} " + " ".join(map(str, normalized_segment)))\n\n            # For validation\n            cv2.drawContours(\n                reconstructed_mask, [contour], -1, color=instance_id, thickness=cv2.FILLED\n            )\n\n    if yolo_lines:\n        with open(txt_path, "w") as f:\n            f.write("\\n".join(yolo_lines))\n\n    # Validation metrics\n    original_binary = mask > 0\n    reconstructed_binary = reconstructed_mask > 0\n    intersection = np.logical_and(original_binary, reconstructed_binary).sum()\n    union = np.logical_or(original_binary, reconstructed_binary).sum()\n\n    iou = intersection / union if union > 0 else 0\n    dice = 2 * intersection / (original_binary.sum() + reconstructed_binary.sum()) if (original_binary.sum() + reconstructed_binary.sum()) > 0 else 0\n\n    return iou, dice\n\nclass CellSegDataset(Dataset):\n    def __init__(\n        self,\n        data_dir,\n        ann_dir,\n        split: str = "train",\n        require_masks: bool = True,\n        image_glob: str = "*.tif",\n        mask_glob: str = "*.tif",\n    ):\n        self.data_dir = Path(data_dir)\n        self.ann_dir = Path(ann_dir)\n        self.split = split\n        self.require_masks = require_masks\n\n        self.img_dir = self.data_dir\n        self.mask_dir = self.ann_dir\n\n        img_paths = sorted(self.img_dir.glob(image_glob))\n        if not img_paths:\n            raise RuntimeError(f"No images found in {self.img_dir} (glob={image_glob})")\n\n        mask_paths = sorted(self.mask_dir.glob(mask_glob))\n        if not mask_paths and require_masks:\n            raise RuntimeError(f"No masks found in {self.mask_dir} (glob={mask_glob})")\n\n        img_by_idx: Dict[int, Path] = {}\n        for p in img_paths:\n            idx = _extract_index(p.stem)\n            if idx is None:\n                continue\n            img_by_idx[idx] = p\n\n        mask_by_idx: Dict[int, Path] = {}\n        for p in mask_paths:\n            idx = _extract_index(p.stem)\n            if idx is None:\n                continue\n            mask_by_idx[idx] = p\n\n        if not img_by_idx:\n            raise RuntimeError(\n                f"Found images in {self.img_dir} but none matched an index pattern (e.g., ...0000.tif)."\n            )\n\n        self.pairs: List[Tuple[int, Path, Optional[Path]]] = []\n        for idx in sorted(img_by_idx.keys()):\n            img_p = img_by_idx[idx]\n            m_p = mask_by_idx.get(idx, None)\n\n            if self.require_masks and m_p is None:\n                raise RuntimeError(\n                    f"Missing mask for image idx={idx}: image={img_p.name}. "\n                    f"Expected a mask with the same trailing index in {self.mask_dir} "\n                    f"(e.g., man_seg{idx:04d}.tif or mask{idx:04d}.tif)."\n                )\n\n            self.pairs.append((idx, img_p, m_p))\n\n        if not self.pairs:\n            raise RuntimeError("No (image, mask) pairs could be formed.")\n\n    def __len__(self):\n        return len(self.pairs)\n\n    def __getitem__(self, i):\n        idx, img_path, mask_path = self.pairs[i]\n        img = _read_tif_any(img_path)\n        img = _as_rgb(img)\n\n        mask = None\n        if mask_path is not None:\n            m = _read_tif_any(mask_path)\n            if m.ndim == 3:\n                m = m[..., 0]\n            mask = m.astype(np.uint16)\n\n        meta = {\n            "index": idx,\n            "image_id": img_path.stem,\n            "image_path": str(img_path),\n            "mask_path": str(mask_path) if mask_path is not None else None,\n        }\n        return img, mask, meta\n\n    def generate_yolo_dataset(self, yolo_dir: str | Path, *, class_id: int = 0, class_name: str = "cell", write_empty_labels: bool = True) -> str:\n        yolo_dir = Path(yolo_dir)\n        split = self.split\n        yolo_image_dir = yolo_dir / "images" / split\n        yolo_label_dir = yolo_dir / "labels" / split\n        yolo_image_dir.mkdir(parents=True, exist_ok=True)\n        yolo_label_dir.mkdir(parents=True, exist_ok=True)\n        num_written = 0\n        for idx, img_path, mask_path in self.pairs:\n            assert img_path.exists(), f"Missing image: {img_path}"\n            img = _read_tif_any(img_path)\n            img = _as_rgb(img)\n            if img.dtype != np.uint8:\n                img_min, img_max = img.min(), img.max()\n                if img_max > img_min:\n                    img = (255.0 * (img - img_min) / (img_max - img_min)).astype(np.uint8)\n                else:\n                    img = np.zeros_like(img, dtype=np.uint8)\n            out_img_name = f"{img_path.stem}.png"\n            out_img_path = yolo_image_dir / out_img_name\n            if not out_img_path.exists():\n                cv2.imwrite(str(out_img_path), cv2.cvtColor(img, cv2.COLOR_RGB2BGR))\n            label_path = yolo_label_dir / f"{img_path.stem}.txt"\n            if mask_path is not None and Path(mask_path).exists():\n                mask_to_yolo_and_iou(\n                    mask_path=mask_path,\n                    txt_path=label_path,\n                    class_id=class_id,\n                )\n            else:\n                if write_empty_labels:\n                    label_path.touch()\n            num_written += 1\n        data_yaml_path = yolo_dir / "data.yaml"\n        yaml_config = {\n            "path": str(yolo_dir.resolve()),\n            "train": f"images/{self.split}" if self.split == \'train\' else None,\n            "val": f"images/{self.split}" if self.split == \'val\' else None,\n            "names": {class_id: class_name},\n        }\n        if data_yaml_path.exists():\n            try:\n                with open(data_yaml_path, "r") as f:\n                    existing = yaml.safe_load(f) or {}\n            except Exception:\n                existing = {}\n            if existing.get(\'train\') is None and yaml_config.get(\'train\') is not None:\n                existing[\'train\'] = yaml_config[\'train\']\n            if existing.get(\'val\') is None and yaml_config.get(\'val\') is not None:\n                existing[\'val\'] = yaml_config[\'val\']\n            existing.setdefault(\'names\', {}).update(yaml_config[\'names\'])\n            existing[\'path\'] = yaml_config[\'path\']\n            yaml_config = existing\n        with open(data_yaml_path, "w") as f:\n            yaml.safe_dump(yaml_config, f, sort_keys=False)\n        self.yolo_dir = yolo_dir\n        self.yolo_yaml_path = str(data_yaml_path)\n        return str(data_yaml_path)\n\n# --- Main Segmentation Function ---\n\ndef cell_segmentation(train_dataset: CellSegDataset, val_dataset: CellSegDataset) -> List[np.ndarray]:\n    """\n    Performs instance segmentation on a validation dataset of cell images.\n    """\n    # Create a temporary directory for the YOLO dataset\n    yolo_dir = Path("./yolo_dataset")\n    if yolo_dir.exists():\n        shutil.rmtree(yolo_dir)\n    yolo_dir.mkdir(parents=True)\n\n    # Generate YOLO-formatted datasets\n    print("Generating YOLO dataset for training...")\n    train_dataset.generate_yolo_dataset(yolo_dir, class_name="cell")\n    \n    print("Generating YOLO dataset for validation...")\n    data_yaml_path = val_dataset.generate_yolo_dataset(yolo_dir, class_name="cell")\n\n    # --- Model Training ---\n    print("Starting YOLOv8x-seg model training...")\n    model = YOLO(\'yolov8x-seg.pt\')\n\n    # Train the model with specified augmentations and early stopping\n    results = model.train(\n        data=data_yaml_path,\n        epochs=50,\n        imgsz=1024,\n        patience=10,  # Early stopping patience\n        batch=4,      # Adjusted batch size for H100 memory\n        project=\'cell_segmentation_runs\',\n        name=\'yolov8x_seg_50_epochs\',\n        degrees=90.0, # Rotation augmentation\n        fliplr=0.5,   # Horizontal flip augmentation\n        device=0,\n        exist_ok=True,\n        val=True,\n        save_conf=True,\n    )\n    \n    # --- Inference ---\n    print("Training finished. Running inference on the validation set...")\n    best_model_path = results.save_dir / \'weights\' / \'best.pt\'\n    best_model = YOLO(best_model_path)\n\n    # Get paths to validation images\n    val_image_paths = [str(p[1]) for p in val_dataset.pairs]\n\n    # Predict on the validation images\n    predictions = best_model.predict(\n        source=val_image_paths,\n        imgsz=1024,\n        conf=0.25, # Confidence threshold\n        iou=0.7,   # NMS IoU threshold\n        stream=True # Process images one by one to save memory\n    )\n\n    # --- Post-processing ---\n    print("Post-processing predictions to create instance masks...")\n    seg_mask_list = []\n    \n    # Ensure predictions are sorted in the same order as val_dataset\n    pred_map = {Path(p.path).stem: p for p in predictions}\n    \n    for _, img_path, _ in val_dataset.pairs:\n        stem = img_path.stem\n        \n        if stem not in pred_map:\n            warnings.warn(f"Prediction not found for image {stem}. Appending an empty mask.")\n            # We need original image shape to create an empty mask\n            img, _, _ = val_dataset.__getitem__(val_dataset.pairs.index((_, img_path, _)))\n            h, w, _ = img.shape\n            seg_mask_list.append(np.zeros((h, w), dtype=np.uint16))\n            continue\n\n        prediction = pred_map[stem]\n        h, w = prediction.orig_shape\n        final_mask = np.zeros((h, w), dtype=np.uint16)\n\n        if prediction.masks is not None and len(prediction.masks) > 0:\n            masks = prediction.masks.data.cpu().numpy()\n            confs = prediction.boxes.conf.cpu().numpy()\n\n            # Sort by confidence score in descending order\n            sorted_indices = np.argsort(confs)[::-1]\n            \n            instance_id = 1\n            for idx in sorted_indices:\n                mask = masks[idx, :, :]\n                # Resize mask to original image size\n                # The prediction object already returns masks at original image size\n                mask_resized = cv2.resize(mask, (w, h), interpolation=cv2.INTER_NEAREST)\n                \n                # Binarize and paint onto the final mask\n                instance_mask_bool = mask_resized > 0.5\n                final_mask[instance_mask_bool] = instance_id\n                instance_id += 1\n        \n        seg_mask_list.append(final_mask)\n\n    print("Processing complete.")\n    return seg_mask_list\n\nif __name__ == \'__main__\':\n    # This block is for standalone execution and debugging.\n    # The benchmark will import and call cell_segmentation directly.\n    \n    # --- Setup Datasets ---\n    # NOTE: The paths are placeholders. In the benchmark environment,\n    # the datasets are loaded and passed to the function directly.\n    try:\n        train_data_dir = \'./work/train/images\'\n        train_ann_dir = \'./work/train/masks\'\n        val_data_dir = \'./work/val/images\'\n        val_ann_dir = \'./work/val/masks\' # In a real scenario, val masks might not be available\n\n        if not Path(train_data_dir).exists():\n            print(f"Directory not found: {train_data_dir}. This script expects the data in the \'./work\' directory.")\n        \n        # Create val_ann_dir if it does not exist to avoid error\n        Path(val_ann_dir).mkdir(parents=True, exist_ok=True)\n            \n        train_dataset = CellSegDataset(\n            data_dir=train_data_dir,\n            ann_dir=train_ann_dir,\n            split="train"\n        )\n\n        val_dataset = CellSegDataset(\n            data_dir=val_data_dir,\n            ann_dir=val_ann_dir, # This might be empty, require_masks=False handles it\n            split="val",\n            require_masks=False # Set to False as val masks are for eval, not input\n        )\n\n        # Execute the main function\n        final_masks = cell_segmentation(train_dataset, val_dataset)\n\n        # For evaluation, the benchmark runner will take `final_masks` and compare them\n        # to ground truth. Here, we can just print some stats.\n        print(f"Generated {len(final_masks)} masks.")\n        for i, mask in enumerate(final_masks):\n            print(f"Mask {i}: shape={mask.shape}, instances={len(np.unique(mask)) - 1}")\n        \n        # Save a sample output mask for inspection\n        if len(final_masks) > 0:\n            output_dir = Path(\'./output_masks\')\n            output_dir.mkdir(exist_ok=True)\n            sample_mask_path = output_dir / \'sample_prediction_0.tif\'\n            tifffile.imwrite(sample_mask_path, final_masks[0])\n            print(f"Saved sample mask to {sample_mask_path}")\n\n    except Exception as e:\n        print(f"An error occurred during execution: {e}")\n        import traceback\n        traceback.print_exc()\n\n```'}, {'usage': {'prompt_tokens': 9832, 'completion_tokens': 156, 'total_tokens': 11611, 'latency': 15.709029770019697, 'cumulative_num_llm_calls': 3}, 'prompt_messages': [{'role': 'system', 'content': '# Introduction:\n You are a Computer Vision Expert writing programs for high-stakes scientific research. \nYou have written code to solve this task and now need to evaluate the output of the code execution.\nYou should determine if there were any bugs as well as report the empirical findings.\n\n# Task Description:\nYou are an experienced machine learning engineer who is helping scientists from different domains of science. Your task is to help\nscientists in domains that typically require many manual annotations. Specifically, you will be implementing programs that use \nmachine learning methods to train models on a set of data for a specific task.\n\nBENCHMARK INSTRUCTIONS\n------\nFirst, please read the instructions below which are specific to our benchmark setup. Note, these instructions can be found again in `/home/instructions.txt`.\n\n- **Task-specific instructions**: The instructions for the task are available in `./work/description.md`. Read this file to understand the problem setup for the task you are currently solving.\n\nTASK\n-----\nFor a given task, you will be provided with an initial program that you must optimize to maximize performance on the task.\n**Data setup and loading will be handled for you as input to the program, the task will describe the necessary output of your program.**\nThe focus of optimizations should be on machine learning engineering (i.e testing different models, hyperparameters, etc). Consider exploring a variety of model architectures and frameworks -- the data format or domain conventions should not constrain your choice of approach.\n\nADDITIONAL NOTES\n------\n\n- **Compute**: You have access to NVIDIA H100 NVL with the appropriate drivers installed.\n- **Total Runtime**: You have a maximum of 4hrs 0mins 0secs to attempt this task. You may iteratively develop your solution within this time frame, but bear in mind that program runtime also counts towards this limit.\n- **Total Steps**: You have a maximum of 500 steps to submit your solution.\n- You will be informed of the remaining time and steps at each step.\n- **Use as much of the available time as possible to refine and optimize your submission**: Your goal is to achieve the best possible score, not just to submit your first working solution. Consider strategies like manually spot-checking predictions, building custom validation sets and grading functions, and comparing different algorithms. You may keep working until the time limit expires -- as long as your best submission is stored at the designated location at the end of your run, it will be picked up for grading.\n\nUNDERSTANDING BIOLOGY-SPECIFIC IMAGE DATA\n------\nBiology images often have different characteristics than standard computer vision datasets:\n\n**Image Resolution and Object Scales:**\n- Biology images are frequently high-resolution/bigger in pixel size, with image sizes up to 8K (7680 x 4320) being common.\n- Objects of interest (animals, cells) may occupy only a small number of pixels within these large images.\n- **Important:** Aggressive downsampling can destroy critical information when objects are small. Carefully consider whether resizing is necessary and what resolution preserves the details needed for detection.\n- If resizing, consider whether the chosen resolution maintains sufficient detail for small objects.\n\nTASK INSTRUCTIONS\n------\n\n# Cell Segmentation\n\n## Dataset Description\n\nThe study of how cells grow, divide, and interact over time is a core problem in biology. A fundamental prerequisite for many downstream analyses—such as tracking, lineage inference, and morphology measurement—is cell segmentation: identifying which pixels belong to which individual cells in an image. The dataset consists of microscopy images of cells along with corresponding instance-level annotations. Each image may contain multiple cells, and each cell should be assigned a unique instance ID. Background pixels are labeled as 0. The data is exposed through a CellSegDataset abstraction, which provides access to images and instance masks and supports exporting the data into YOLO-compatible segmentation format.\n\n## Task Description\n\nYour goal is to implement a function called cell_segmentation that performs instance segmentation on a validation dataset of cell images.\n\nYou must implement the following function:\n\n```python\ndef cell_segmentation(train_dataset: CellSegDataset, val_dataset: CellSegDataset):\n    """\n\tInput\n\t•\ttrain_dataset: a CellSegDataset containing training images and instance masks.\n\t•\tval_dataset: a CellSegDataset containing validation images (and possibly masks).\n\n    Returns:\n        seg_mask_list: list[np.ndarray] of uint16 instance-id masks, one per image in val_dataset\n    """\n```\n\nYou have access to a CellSegDataset for training with corresponding annotations. You must produce predictions on a validation CellSegDataset which you will be evaluated on.\n\nThe CellSegDataset class is provided below: \n\n```python\nclass CellSegDataset(Dataset):\n    """\n    General-purpose segmentation dataset that pairs images and masks by numeric index.\n\n    Returns:\n        image: H x W x 3 (RGB)\n        mask:  H x W (uint16 instance IDs) OR None if require_masks=False and missing\n        meta:  dict with filename info\n    """\n\n    def __init__(\n        self,\n        data_dir,\n        ann_dir,\n        split: str = "train",\n        require_masks: bool = True,\n        image_glob: str = "*.tif",\n        mask_glob: str = "*.tif",\n    ):\n        self.data_dir = Path(data_dir)\n        self.ann_dir = Path(ann_dir)\n        self.split = split\n        self.require_masks = require_masks\n\n        self.img_dir = self.data_dir\n        self.mask_dir = self.ann_dir\n\n        img_paths = sorted(self.img_dir.glob(image_glob))\n        if not img_paths:\n            raise RuntimeError(f"No images found in {self.img_dir} (glob={image_glob})")\n\n        mask_paths = sorted(self.mask_dir.glob(mask_glob))\n        if not mask_paths and require_masks:\n            raise RuntimeError(f"No masks found in {self.mask_dir} (glob={mask_glob})")\n\n        # Build index->path maps\n        img_by_idx: Dict[int, Path] = {}\n        for p in img_paths:\n            idx = _extract_index(p.stem)\n            if idx is None:\n                continue\n            img_by_idx[idx] = p\n\n        mask_by_idx: Dict[int, Path] = {}\n        for p in mask_paths:\n            idx = _extract_index(p.stem)\n            if idx is None:\n                continue\n            mask_by_idx[idx] = p\n\n        if not img_by_idx:\n            raise RuntimeError(\n                f"Found images in {self.img_dir} but none matched an index pattern (e.g., ...0000.tif)."\n            )\n\n        self.pairs: List[Tuple[int, Path, Optional[Path]]] = []\n        for idx in sorted(img_by_idx.keys()):\n            img_p = img_by_idx[idx]\n            m_p = mask_by_idx.get(idx, None)\n\n            if self.require_masks and m_p is None:\n                # Hard fail early so you don\'t discover this deep in training.\n                raise RuntimeError(\n                    f"Missing mask for image idx={idx}: image={img_p.name}. "\n                    f"Expected a mask with the same trailing index in {self.mask_dir} "\n                    f"(e.g., man_seg{idx:04d}.tif or mask{idx:04d}.tif)."\n                )\n\n            self.pairs.append((idx, img_p, m_p))\n\n        if not self.pairs:\n            raise RuntimeError("No (image, mask) pairs could be formed.")\n\n    def __len__(self):\n        return len(self.pairs)\n\n    def __getitem__(self, i):\n        idx, img_path, mask_path = self.pairs[i]\n\n        # --- Load image ---\n        img = _read_tif_any(img_path)\n        img = _as_rgb(img)\n\n        # --- Load mask ---\n        mask = None\n        if mask_path is not None:\n            m = _read_tif_any(mask_path)\n            if m.ndim == 3: # Some GT masks can be saved as HxWx1\n                m = m[..., 0]\n            mask = m.astype(np.uint16)\n\n        meta = {\n            "index": idx,\n            "image_id": img_path.stem,\n            "image_path": str(img_path),\n            "mask_path": str(mask_path) if mask_path is not None else None,\n        }\n\n        return img, mask, meta\n\n    def generate_yolo_dataset(self, yolo_dir: str | Path, *, class_id: int = 0, class_name: str = "cell", write_empty_labels: bool = True) -> str:\n        """\n        Generate Ultralytics YOLOv8-seg dataset for this dataset\'s split.\n\n        Writes:\n            yolo_dir/\n            images/<split>/*.png\n            labels/<split>/*.txt\n            data.yaml\n\n        Returns:\n            str path to yolo_dir/data.yaml\n        """\n        yolo_dir = Path(yolo_dir)\n        split = self.split\n\n        print(f"Building YOLO-seg dataset at {yolo_dir} (split={split})...")\n\n        yolo_image_dir = yolo_dir / "images" / split\n        yolo_label_dir = yolo_dir / "labels" / split\n        yolo_image_dir.mkdir(parents=True, exist_ok=True)\n        yolo_label_dir.mkdir(parents=True, exist_ok=True)\n\n        num_written = 0\n\n        for idx, img_path, mask_path in self.pairs:\n            assert img_path.exists(), f"Missing image: {img_path}"\n\n            # ---------- IMAGE EXPORT (force 3-channel PNG) ----------\n            img = _read_tif_any(img_path)\n            img = _as_rgb(img)\n\n            if img.dtype != np.uint8:\n                img = np.clip(img, 0, 255).astype(np.uint8)\n\n            out_img_name = f"{img_path.stem}.png"\n            out_img_path = yolo_image_dir / out_img_name\n\n            if not out_img_path.exists():\n                cv2.imwrite(str(out_img_path), cv2.cvtColor(img, cv2.COLOR_RGB2BGR))\n\n            # ---------- LABEL GENERATION ----------\n            label_path = yolo_label_dir / f"{img_path.stem}.txt"\n\n            if mask_path is not None and Path(mask_path).exists():\n                iou, dice = mask_to_yolo_and_iou(\n                    mask_path=mask_path,\n                    txt_path=label_path,\n                    class_id=class_id,\n                )\n            else:\n                if write_empty_labels:\n                    label_path.touch()\n                else:\n                    continue\n\n            num_written += 1\n\n        # ---------- WRITE data.yaml ----------\n        data_yaml_path = yolo_dir / "data.yaml"\n        yaml_config = {\n            "path": str(yolo_dir.resolve()),\n            "train": "images/train",\n            "val": "images/val",\n            "names": {class_id: class_name},\n        }\n\n        if data_yaml_path.exists():\n            try:\n                with open(data_yaml_path, "r") as f:\n                    existing = yaml.safe_load(f) or {}\n            except Exception:\n                existing = {}\n            existing.update(yaml_config)\n            yaml_config = existing\n\n        with open(data_yaml_path, "w") as f:\n            yaml.safe_dump(yaml_config, f, sort_keys=False)\n\n        self.yolo_dir = yolo_dir\n        self.yolo_yaml_path = str(data_yaml_path)\n\n        print(f"Done. Wrote {num_written} samples to split={split}.")\n        return str(data_yaml_path)\n\n\n    def get_yolo_dataset(self) -> str:\n        if not hasattr(self, "yolo_yaml_path"):\n            raise RuntimeError("YOLO dataset has not been generated yet. Call generate_yolo_dataset(...) first.")\n        return self.yolo_yaml_path\n\ndef collate_fn(batch):\n    imgs, masks, metas = zip(*batch)\n    return list(imgs), list(masks), list(metas)\n```\n\n# Implementation:\n```python\nimport torch\nimport cv2\nimport numpy as np\nimport yaml\nfrom pathlib import Path\nfrom typing import Dict, List, Optional, Tuple\nfrom torch.utils.data import Dataset\nfrom ultralytics import YOLO\nimport shutil\nimport re\nimport tifffile\nimport warnings\nimport os\n\n# --- Helper Functions and Classes from Problem Description ---\n\n\ndef _extract_index(fname: str) -> Optional[int]:\n    """Tries to extract a numeric index from a filename stem."""\n    # First, try to match a pattern of 4 or more digits at the end of the string\n    match = re.search(r"(\\d{4,})$", fname)\n    if match:\n        return int(match.group(1))\n\n    # If that fails, try to find any sequence of digits\n    match = re.search(r"\\d+", fname)\n    if match:\n        return int(match.group(0))\n\n    return None\n\n\ndef _read_tif_any(p: Path) -> np.ndarray:\n    """Read a TIF file, handling various possible dimensionalities."""\n    try:\n        img = tifffile.imread(p)\n        return img\n    except Exception as e:\n        warnings.warn(f"tifffile failed to read {p}: {e}. Trying cv2.")\n        img = cv2.imread(str(p), cv2.IMREAD_UNCHANGED)\n        if img is None:\n            raise IOError(f"Failed to read image {p} with both tifffile and cv2.")\n        return img\n\n\ndef _as_rgb(img: np.ndarray) -> np.ndarray:\n    """Converts a grayscale or single-channel image to 3-channel RGB."""\n    if img.ndim == 2:\n        return np.stack([img] * 3, axis=-1)\n    if img.shape[-1] == 1:\n        return np.concatenate([img] * 3, axis=-1)\n    if img.shape[-1] > 3:\n        return img[..., :3]  # Take the first 3 channels\n    return img\n\n\ndef mask_to_yolo_and_iou(\n    mask_path: Path, txt_path: Path, class_id: int = 0\n) -> Tuple[float, float]:\n    """\n    Converts a single instance mask to YOLO segmentation format and saves to a .txt file.\n    Also calculates IoU and Dice score for the conversion.\n    """\n    mask = _read_tif_any(mask_path)\n    if mask.ndim == 3:\n        mask = mask[..., 0]\n\n    h, w = mask.shape\n    instance_ids = np.unique(mask)\n    instance_ids = instance_ids[instance_ids != 0]\n\n    yolo_lines = []\n    reconstructed_mask = np.zeros_like(mask)\n\n    for i, instance_id in enumerate(instance_ids):\n        instance_mask = mask == instance_id\n        contours, _ = cv2.findContours(\n            instance_mask.astype(np.uint8), cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE\n        )\n\n        for contour in contours:\n            if contour.size < 6:\n                continue\n\n            segment = contour.flatten().tolist()\n            normalized_segment = [\n                val / w if i % 2 == 0 else val / h for i, val in enumerate(segment)\n            ]\n            yolo_lines.append(f"{class_id} " + " ".join(map(str, normalized_segment)))\n\n            # For validation\n            cv2.drawContours(\n                reconstructed_mask,\n                [contour],\n                -1,\n                color=instance_id,\n                thickness=cv2.FILLED,\n            )\n\n    if yolo_lines:\n        with open(txt_path, "w") as f:\n            f.write("\\n".join(yolo_lines))\n\n    # Validation metrics\n    original_binary = mask > 0\n    reconstructed_binary = reconstructed_mask > 0\n    intersection = np.logical_and(original_binary, reconstructed_binary).sum()\n    union = np.logical_or(original_binary, reconstructed_binary).sum()\n\n    iou = intersection / union if union > 0 else 0\n    dice = (\n        2 * intersection / (original_binary.sum() + reconstructed_binary.sum())\n        if (original_binary.sum() + reconstructed_binary.sum()) > 0\n        else 0\n    )\n\n    return iou, dice\n\n\nclass CellSegDataset(Dataset):\n    def __init__(\n        self,\n        data_dir,\n        ann_dir,\n        split: str = "train",\n        require_masks: bool = True,\n        image_glob: str = "*.tif",\n        mask_glob: str = "*.tif",\n    ):\n        self.data_dir = Path(data_dir)\n        self.ann_dir = Path(ann_dir)\n        self.split = split\n        self.require_masks = require_masks\n\n        self.img_dir = self.data_dir\n        self.mask_dir = self.ann_dir\n\n        img_paths = sorted(self.img_dir.glob(image_glob))\n        if not img_paths:\n            raise RuntimeError(f"No images found in {self.img_dir} (glob={image_glob})")\n\n        mask_paths = sorted(self.mask_dir.glob(mask_glob))\n        if not mask_paths and require_masks:\n            raise RuntimeError(f"No masks found in {self.mask_dir} (glob={mask_glob})")\n\n        img_by_idx: Dict[int, Path] = {}\n        for p in img_paths:\n            idx = _extract_index(p.stem)\n            if idx is None:\n                continue\n            img_by_idx[idx] = p\n\n        mask_by_idx: Dict[int, Path] = {}\n        for p in mask_paths:\n            idx = _extract_index(p.stem)\n            if idx is None:\n                continue\n            mask_by_idx[idx] = p\n\n        if not img_by_idx:\n            raise RuntimeError(\n                f"Found images in {self.img_dir} but none matched an index pattern (e.g., ...0000.tif)."\n            )\n\n        self.pairs: List[Tuple[int, Path, Optional[Path]]] = []\n        for idx in sorted(img_by_idx.keys()):\n            img_p = img_by_idx[idx]\n            m_p = mask_by_idx.get(idx, None)\n\n            if self.require_masks and m_p is None:\n                raise RuntimeError(\n                    f"Missing mask for image idx={idx}: image={img_p.name}. "\n                    f"Expected a mask with the same trailing index in {self.mask_dir} "\n                    f"(e.g., man_seg{idx:04d}.tif or mask{idx:04d}.tif)."\n                )\n\n            self.pairs.append((idx, img_p, m_p))\n\n        if not self.pairs:\n            raise RuntimeError("No (image, mask) pairs could be formed.")\n\n    def __len__(self):\n        return len(self.pairs)\n\n    def __getitem__(self, i):\n        idx, img_path, mask_path = self.pairs[i]\n        img = _read_tif_any(img_path)\n        img = _as_rgb(img)\n\n        mask = None\n        if mask_path is not None:\n            m = _read_tif_any(mask_path)\n            if m.ndim == 3:\n                m = m[..., 0]\n            mask = m.astype(np.uint16)\n\n        meta = {\n            "index": idx,\n            "image_id": img_path.stem,\n            "image_path": str(img_path),\n            "mask_path": str(mask_path) if mask_path is not None else None,\n        }\n        return img, mask, meta\n\n    def generate_yolo_dataset(\n        self,\n        yolo_dir: str | Path,\n        *,\n        class_id: int = 0,\n        class_name: str = "cell",\n        write_empty_labels: bool = True,\n    ) -> str:\n        yolo_dir = Path(yolo_dir)\n        split = self.split\n        yolo_image_dir = yolo_dir / "images" / split\n        yolo_label_dir = yolo_dir / "labels" / split\n        yolo_image_dir.mkdir(parents=True, exist_ok=True)\n        yolo_label_dir.mkdir(parents=True, exist_ok=True)\n        num_written = 0\n        for idx, img_path, mask_path in self.pairs:\n            assert img_path.exists(), f"Missing image: {img_path}"\n            img = _read_tif_any(img_path)\n            img = _as_rgb(img)\n            if img.dtype != np.uint8:\n                img_min, img_max = img.min(), img.max()\n                if img_max > img_min:\n                    img = (255.0 * (img - img_min) / (img_max - img_min)).astype(\n                        np.uint8\n                    )\n                else:\n                    img = np.zeros_like(img, dtype=np.uint8)\n            out_img_name = f"{img_path.stem}.png"\n            out_img_path = yolo_image_dir / out_img_name\n            if not out_img_path.exists():\n                cv2.imwrite(str(out_img_path), cv2.cvtColor(img, cv2.COLOR_RGB2BGR))\n            label_path = yolo_label_dir / f"{img_path.stem}.txt"\n            if mask_path is not None and Path(mask_path).exists():\n                mask_to_yolo_and_iou(\n                    mask_path=mask_path,\n                    txt_path=label_path,\n                    class_id=class_id,\n                )\n            else:\n                if write_empty_labels:\n                    label_path.touch()\n            num_written += 1\n        data_yaml_path = yolo_dir / "data.yaml"\n        yaml_config = {\n            "path": str(yolo_dir.resolve()),\n            "train": f"images/{self.split}" if self.split == "train" else None,\n            "val": f"images/{self.split}" if self.split == "val" else None,\n            "names": {class_id: class_name},\n        }\n        if data_yaml_path.exists():\n            try:\n                with open(data_yaml_path, "r") as f:\n                    existing = yaml.safe_load(f) or {}\n            except Exception:\n                existing = {}\n            if existing.get("train") is None and yaml_config.get("train") is not None:\n                existing["train"] = yaml_config["train"]\n            if existing.get("val") is None and yaml_config.get("val") is not None:\n                existing["val"] = yaml_config["val"]\n            existing.setdefault("names", {}).update(yaml_config["names"])\n            existing["path"] = yaml_config["path"]\n            yaml_config = existing\n        with open(data_yaml_path, "w") as f:\n            yaml.safe_dump(yaml_config, f, sort_keys=False)\n        self.yolo_dir = yolo_dir\n        self.yolo_yaml_path = str(data_yaml_path)\n        return str(data_yaml_path)\n\n\n# --- Main Segmentation Function ---\n\n\ndef cell_segmentation(\n    train_dataset: CellSegDataset, val_dataset: CellSegDataset\n) -> List[np.ndarray]:\n    """\n    Performs instance segmentation on a validation dataset of cell images.\n    """\n    # Create a temporary directory for the YOLO dataset\n    yolo_dir = Path("./yolo_dataset")\n    if yolo_dir.exists():\n        shutil.rmtree(yolo_dir)\n    yolo_dir.mkdir(parents=True)\n\n    # Generate YOLO-formatted datasets\n    print("Generating YOLO dataset for training...")\n    train_dataset.generate_yolo_dataset(yolo_dir, class_name="cell")\n\n    print("Generating YOLO dataset for validation...")\n    data_yaml_path = val_dataset.generate_yolo_dataset(yolo_dir, class_name="cell")\n\n    # --- Model Training ---\n    print("Starting YOLOv8x-seg model training...")\n    model = YOLO("yolov8x-seg.pt")\n\n    # Train the model with specified augmentations and early stopping\n    results = model.train(\n        data=data_yaml_path,\n        epochs=50,\n        imgsz=1024,\n        patience=10,  # Early stopping patience\n        batch=4,  # Adjusted batch size for H100 memory\n        project="cell_segmentation_runs",\n        name="yolov8x_seg_50_epochs",\n        degrees=90.0,  # Rotation augmentation\n        fliplr=0.5,  # Horizontal flip augmentation\n        device=0,\n        exist_ok=True,\n        val=True,\n        save_conf=True,\n    )\n\n    # --- Inference ---\n    print("Training finished. Running inference on the validation set...")\n    best_model_path = results.save_dir / "weights" / "best.pt"\n    best_model = YOLO(best_model_path)\n\n    # Get paths to validation images\n    val_image_paths = [str(p[1]) for p in val_dataset.pairs]\n\n    # Predict on the validation images\n    predictions = best_model.predict(\n        source=val_image_paths,\n        imgsz=1024,\n        conf=0.25,  # Confidence threshold\n        iou=0.7,  # NMS IoU threshold\n        stream=True,  # Process images one by one to save memory\n    )\n\n    # --- Post-processing ---\n    print("Post-processing predictions to create instance masks...")\n    seg_mask_list = []\n\n    # Ensure predictions are sorted in the same order as val_dataset\n    pred_map = {Path(p.path).stem: p for p in predictions}\n\n    for _, img_path, _ in val_dataset.pairs:\n        stem = img_path.stem\n\n        if stem not in pred_map:\n            warnings.warn(\n                f"Prediction not found for image {stem}. Appending an empty mask."\n            )\n            # We need original image shape to create an empty mask\n            img, _, _ = val_dataset.__getitem__(\n                val_dataset.pairs.index((_, img_path, _))\n            )\n            h, w, _ = img.shape\n            seg_mask_list.append(np.zeros((h, w), dtype=np.uint16))\n            continue\n\n        prediction = pred_map[stem]\n        h, w = prediction.orig_shape\n        final_mask = np.zeros((h, w), dtype=np.uint16)\n\n        if prediction.masks is not None and len(prediction.masks) > 0:\n            masks = prediction.masks.data.cpu().numpy()\n            confs = prediction.boxes.conf.cpu().numpy()\n\n            # Sort by confidence score in descending order\n            sorted_indices = np.argsort(confs)[::-1]\n\n            instance_id = 1\n            for idx in sorted_indices:\n                mask = masks[idx, :, :]\n                # Resize mask to original image size\n                # The prediction object already returns masks at original image size\n                mask_resized = cv2.resize(mask, (w, h), interpolation=cv2.INTER_NEAREST)\n\n                # Binarize and paint onto the final mask\n                instance_mask_bool = mask_resized > 0.5\n                final_mask[instance_mask_bool] = instance_id\n                instance_id += 1\n\n        seg_mask_list.append(final_mask)\n\n    print("Processing complete.")\n    return seg_mask_list\n\n\nif __name__ == "__main__":\n    # This block is for standalone execution and debugging.\n    # The benchmark will import and call cell_segmentation directly.\n\n    # --- Setup Datasets ---\n    # NOTE: The paths are placeholders. In the benchmark environment,\n    # the datasets are loaded and passed to the function directly.\n    try:\n        train_data_dir = "./work/train/images"\n        train_ann_dir = "./work/train/masks"\n        val_data_dir = "./work/val/images"\n        val_ann_dir = (\n            "./work/val/masks"  # In a real scenario, val masks might not be available\n        )\n\n        if not Path(train_data_dir).exists():\n            print(\n                f"Directory not found: {train_data_dir}. This script expects the data in the \'./work\' directory."\n            )\n\n        # Create val_ann_dir if it does not exist to avoid error\n        Path(val_ann_dir).mkdir(parents=True, exist_ok=True)\n\n        train_dataset = CellSegDataset(\n            data_dir=train_data_dir, ann_dir=train_ann_dir, split="train"\n        )\n\n        val_dataset = CellSegDataset(\n            data_dir=val_data_dir,\n            ann_dir=val_ann_dir,  # This might be empty, require_masks=False handles it\n            split="val",\n            require_masks=False,  # Set to False as val masks are for eval, not input\n        )\n\n        # Execute the main function\n        final_masks = cell_segmentation(train_dataset, val_dataset)\n\n        # For evaluation, the benchmark runner will take `final_masks` and compare them\n        # to ground truth. Here, we can just print some stats.\n        print(f"Generated {len(final_masks)} masks.")\n        for i, mask in enumerate(final_masks):\n            print(f"Mask {i}: shape={mask.shape}, instances={len(np.unique(mask)) - 1}")\n\n        # Save a sample output mask for inspection\n        if len(final_masks) > 0:\n            output_dir = Path("./output_masks")\n            output_dir.mkdir(exist_ok=True)\n            sample_mask_path = output_dir / "sample_prediction_0.tif"\n            tifffile.imwrite(sample_mask_path, final_masks[0])\n            print(f"Saved sample mask to {sample_mask_path}")\n\n    except Exception as e:\n        print(f"An error occurred during execution: {e}")\n        import traceback\n\n     