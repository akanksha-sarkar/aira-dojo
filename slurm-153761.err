'import numpy as np
import torch
from pathlib import Path
from ultralytics import YOLO
import cv2
import yaml
from typing import List, Dict, Tuple, Optional
from torch.utils.data import Dataset
import shutil
import re

# --- Provided Helper Code (from description and adapted for robustness) ---


def _extract_index(fname: str) -> Optional[int]:
    """Tries to extract a trailing integer index from a filename."""
    match = re.search(r"(\d+)$", fname)
    if match:
        return int(match.group(1))
    return None


def _read_tif_any(p: Path) -> np.ndarray:
    """Read a TIF file, handling various bit depths and channel configurations."""
    img = cv2.imread(str(p), cv2.IMREAD_UNCHANGED)
    if img is None:
        raise IOError(f"Failed to load TIFF image: {p}")
    return img


def _as_rgb(img: np.ndarray) -> np.ndarray:
    """Convert a grayscale or multi-channel image to 3-channel RGB."""
    if img.ndim == 2:
        return cv2.cvtColor(img, cv2.COLOR_GRAY2RGB)
    if img.ndim == 3:
        if img.shape[2] == 1:
            return cv2.cvtColor(img, cv2.COLOR_GRAY2RGB)
        if img.shape[2] > 3:
            return img[..., :3]
    return img


def instance_mask_to_yolo(mask: np.ndarray, class_id: int):
    """
    Converts an instance mask to YOLO segmentation format.
    An instance mask has shape (H, W) and contains a unique ID for each instance.
    """
    yolo_strings = []
    instance_ids = np.unique(mask)
    instance_ids = instance_ids[instance_ids != 0]

    if len(instance_ids) == 0:
        return yolo_strings

    H, W = mask.shape
    for inst_id in instance_ids:
        binary_mask = (mask == inst_id).astype(np.uint8)
        contours, _ = cv2.findContours(
            binary_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE
        )

        for contour in contours:
            if contour.size < 6:
                continue

            contour = contour.squeeze(1).astype(np.float32)
            if len(contour) < 3:
                continue

            contour[:, 0] /= W
            contour[:, 1] /= H

            contour_str = " ".join(map(lambda x: f"{x:.6f}", contour.flatten()))
            yolo_strings.append(f"{class_id} {contour_str}")

    return yolo_strings


def mask_to_yolo_and_iou(mask_path, txt_path, class_id=0):
    mask = _read_tif_any(mask_path)
    if mask.ndim == 3:
        mask = mask[..., 0]

    yolo_lines = instance_mask_to_yolo(mask, class_id)

    if yolo_lines:
        with open(txt_path, "w") as f:
            f.write("\n".join(yolo_lines))
    else:
        # Create an empty file if no instances are found
        txt_path.touch()

    return 0, 0


class CellSegDataset(Dataset):
    """
    General-purpose segmentation dataset that pairs images and masks by numeric index.
    """

    def __init__(
        self,
        data_dir,
        ann_dir,
        split: str = "train",
        require_masks: bool = True,
        image_glob: str = "*.tif",
        mask_glob: str = "*.tif",
    ):
        self.data_dir = Path(data_dir)
        self.ann_dir = Path(ann_dir)
        self.split = split
        self.require_masks = require_masks

        self.img_dir = self.data_dir
        self.mask_dir = self.ann_dir

        img_paths = sorted(self.img_dir.glob(image_glob))
        if not img_paths:
            raise RuntimeError(f"No images found in {self.img_dir} (glob={image_glob})")

        mask_paths = sorted(self.mask_dir.glob(mask_glob))
        if not mask_paths and require_masks:
            raise RuntimeError(f"No masks found in {self.mask_dir} (glob={mask_glob})")

        img_by_idx: Dict[str, Path] = {p.stem: p for p in img_paths}
        mask_by_idx: Dict[str, Path] = {p.stem: p for p in mask_paths}

        if not img_by_idx:
            raise RuntimeError(f"Could not index any images in {self.img_dir}")

        self.pairs: List[Tuple[str, Path, Optional[Path]]] = []
        for stem, img_p in img_by_idx.items():
            m_p = mask_by_idx.get(stem, None)

            if self.require_masks and m_p is None:
                # Try finding a mask with a prefix, e.g., man_seg for t
                # This is common in cell tracking challenges
                prefixed_stem = "man_seg" + stem[1:]
                m_p = mask_by_idx.get(prefixed_stem, None)

            if self.require_masks and m_p is None:
                print(f"Warning: Missing mask for image: {img_p.name}. Skipping.")
                continue

            self.pairs.append((stem, img_p, m_p))

        if not self.pairs:
            raise RuntimeError("No (image, mask) pairs could be formed.")

    def __len__(self):
        return len(self.pairs)

    def __getitem__(self, i):
        stem, img_path, mask_path = self.pairs[i]

        img = _read_tif_any(img_path)
        img = _as_rgb(img)

        mask = None
        if mask_path is not None:
            m = _read_tif_any(mask_path)
            if m.ndim == 3:
                m = m[..., 0]
            mask = m.astype(np.uint16)

        meta = {
            "image_id": stem,
            "image_path": str(img_path),
            "mask_path": str(mask_path) if mask_path is not None else None,
        }

        return img, mask, meta

    def generate_yolo_dataset(
        self,
        yolo_dir: str | Path,
        *,
        class_id: int = 0,
        class_name: str = "cell",
        write_empty_labels: bool = True,
    ) -> str:
        yolo_dir = Path(yolo_dir)
        split = self.split

        print(f"Building YOLO-seg dataset at {yolo_dir} (split={split})...")

        yolo_image_dir = yolo_dir / "images" / split
        yolo_label_dir = yolo_dir / "labels" / split
        yolo_image_dir.mkdir(parents=True, exist_ok=True)
        yolo_label_dir.mkdir(parents=True, exist_ok=True)

        for i, (stem, img_path, mask_path) in enumerate(self.pairs):
            out_stem = f"{self.split}_{i:04d}"

            img = _read_tif_any(img_path)

            if img.dtype != np.uint8:
                if img.dtype == np.uint16:
                    img = (img / 256).astype(np.uint8)
                else:
                    min_val, max_val = np.min(img), np.max(img)
                    if max_val > min_val:
                        img = ((img - min_val) / (max_val - min_val) * 255).astype(
                            np.uint8
                        )
                    else:
                        img = np.zeros_like(img, dtype=np.uint8)

            img = _as_rgb(img)

            out_img_path = yolo_image_dir / f"{out_stem}.png"
            cv2.imwrite(str(out_img_path), cv2.cvtColor(img, cv2.COLOR_RGB2BGR))

            label_path = yolo_label_dir / f"{out_stem}.txt"
            if mask_path and mask_path.exists():
                mask_to_yolo_and_iou(
                    mask_path=mask_path, txt_path=label_path, class_id=class_id
                )
            elif write_empty_labels:
                label_path.touch()

        data_yaml_path = yolo_dir / "data.yaml"
        yaml_config = {
            "path": str(yolo_dir.resolve()),
            "train": "images/train",
            "val": "images/val",
            "names": {class_id: class_name},
        }

        if data_yaml_path.exists():
            try:
                with open(data_yaml_path, "r") as f:
                    existing = yaml.safe_load(f) or {}
                existing.update(yaml_config)
                yaml_config = existing
            except Exception:
                pass

        with open(data_yaml_path, "w") as f:
            yaml.safe_dump(yaml_config, f, sort_keys=False)

        self.yolo_yaml_path = str(data_yaml_path)
        print(f"Done. Wrote {len(self.pairs)} samples to split={split}.")
        return str(data_yaml_path)


def cell_segmentation(
    train_dataset: CellSegDataset, val_dataset: CellSegDataset
) -> List[np.ndarray]:
    """
    Performs instance segmentation on a validation dataset of cell images.
    """

    yolo_data_dir = Path("./yolo_dataset")
    if yolo_data_dir.exists():
        shutil.rmtree(yolo_data_dir)
    yolo_data_dir.mkdir(parents=True)

    print("Generating YOLO dataset for training...")
    train_dataset.split = "train"
    data_yaml_path = train_dataset.generate_yolo_dataset(yolo_data_dir)

    print("Generating YOLO dataset for validation...")
    val_dataset.split = "val"
    val_dataset.generate_yolo_dataset(yolo_data_dir)

    model = YOLO("yolov8l-seg.pt")

    IMG_SZ = 1024
    BATCH_SIZE = 16
    EPOCHS = 75

    print(
        f"Starting YOLOv8 training for {EPOCHS} epochs with image size {IMG_SZ} and batch size {BATCH_SIZE}..."
    )

    model.train(
        data=data_yaml_path,
        epochs=EPOCHS,
        imgsz=IMG_SZ,
        batch=BATCH_SIZE,
        project="yolov8_training",
        name="cell_seg_run",
        exist_ok=True,
        device=0,
        patience=20,
        val=True,
        cache=True,  # Cache images for faster training
    )

    print("Training complete.")
    best_model_path = "yolov8_training/cell_seg_run/weights/best.pt"

    print(f"Loading best model from: {best_model_path}")
    inference_model = YOLO(best_model_path)

    seg_mask_list = []

    print("Running inference on the validation dataset...")
    for i in range(len(val_dataset)):
        val_img, _, meta = val_dataset[i]

        results = inference_model.predict(
            source=val_img, imgsz=IMG_SZ, conf=0.25, iou=0.7, verbose=False, device=0
        )

        result = results[0]
        orig_H, orig_W = result.orig_shape
        final_mask = np.zeros((orig_H, orig_W), dtype=np.uint16)

        if result.masks is not None:
            masks = result.masks.data.cpu().numpy()

            # Sort masks by confidence
            if result.boxes is not None:
                sorted_indices = np.argsort(result.boxes.conf.cpu().numpy())[::-1]
                masks = masks[sorted_indices]

            for j, mask in enumerate(masks):
                # Resize mask to original image size
                if mask.shape != (orig_H, orig_W):
                    mask = cv2.resize(
                        mask, (orig_W, orig_H), interpolation=cv2.INTER_LINEAR
                    )

                instance_id = j + 1
                final_mask[mask > 0.5] = instance_id

        seg_mask_list.append(final_mask)

    print("Inference complete.")

    results_path = Path("yolov8_training/cell_seg_run/results.csv")
    if results_path.exists():
        import pandas as pd

        results_df = pd.read_csv(results_path)
        results_df.columns = results_df.columns.str.strip()
        best_map50 = results_df["metrics/mAP50(M)"].max()
        print(f"\n--- Evaluation Metric (from training logs) ---")
        print(f"Best validation segmentation mAP@50: {best_map50:.4f}")
        print(f"--------------------------------------------\n")

    return seg_mask_list
